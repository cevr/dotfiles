[alias]
	cleanup = "!git fetch -p && git branch -vv | grep ': gone]' | awk '{print $1}' | xargs -r git branch -d"
	fomo = "!default_branch=$(git symbolic-ref refs/remotes/origin/HEAD | sed 's@^refs/remotes/origin/@@') && git fetch origin $default_branch && git merge origin/$default_branch"
[branch]
	sort = -committerdate
[commit]
	gpgSign = true
[fetch]
	prune = true
	writeCommitGraph = true
[gpg]
	format = ssh
[init]
	defaultBranch = main
[push]
	autoSetupRemote = true
[tag]
	gpgSign = true
[user]
	name = cevr
	email = seeve.c@gmail.com
	signingkey = /Users/cvr/.ssh/id_ed25519.pub
[rerere]
	enabled = true
[core]
	excludesfile = /Users/cvr/.gitignore_global
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	light = false
	line-numbers = true
	side-by-side = false
[merge]
	conflictStyle = zdiff3
