{
  "name": "dotfiles-opencode",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "workspaces": [
    "mods/*",
    "cmd/*",
    "decider"
  ],
  "scripts": {
    "link-fork": "bun scripts/link-fork.ts",
    "agents": "bun scripts/agents.ts",
    "typecheck": "bun scripts/typecheck.ts",
    "test": "bun test --timeout 300000",
    "gate": "bun scripts/gate.ts",
    "accept": "bun scripts/accept.ts",
    "accept:affected": "bun scripts/accept.ts --affected",
    "gamut": "bun testbeds/gamut/gamut.ts",
    "daily": "bun scripts/daily.ts",
    "fleet-install": "bun scripts/fleet-install.ts",
    "lint": "oxlint"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@xterm/headless": "6.0.0",
    "effect": "4.0.1",
    "opencode-drive": "2.4.0",
    "oxlint": "1.89.0",
    "zigpty": "0.2.1"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@streamparser/json": "0.0.26",
    "oxc-parser": "0.157.0"
  }
}
