{
  "name": "dotfiles-opencode",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "workspaces": [
    "mods/*",
    "cmd/*",
    "decider",
    "formal",
    "lint",
    "sim",
    "sim-tui"
  ],
  "scripts": {
    "link-fork": "bun scripts/link-fork.ts",
    "agents": "bun scripts/agents.ts",
    "typecheck": "bun scripts/typecheck.ts",
    "test": "bun test --timeout 300000",
    "gate": "bun scripts/gate.ts",
    "accept": "bun scripts/accept.ts",
    "accept:affected": "bun scripts/accept.ts --land",
    "accept:land": "bun scripts/accept.ts --land",
    "accept:owed": "bun scripts/accept.ts --owed",
    "gamut": "bun testbeds/gamut/gamut.ts",
    "daily": "bun scripts/daily.ts",
    "lint": "oxlint && bun scripts/effect-debt.ts --check",
    "debt": "bun scripts/effect-debt.ts",
    "verify:seed": "bun scripts/verify.ts seed",
    "verify:launch": "bun scripts/verify.ts launch",
    "verify:tui": "bun scripts/verify.ts tui",
    "verify:doctor": "bun scripts/verify.ts doctor",
    "verify:drive": "bun scripts/verify.ts drive",
    "verify:stop": "bun scripts/verify.ts stop"
  },
  "devDependencies": {
    "@effect/platform-bun": "4.0.1",
    "@types/bun": "latest",
    "@xterm/headless": "6.0.0",
    "effect": "4.0.1",
    "effect-bun-test": "0.5.0",
    "opencode-drive": "2.4.0",
    "oxlint": "1.89.0",
    "zigpty": "0.2.1"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@streamparser/json": "0.0.26",
    "oxc-parser": "0.157.0"
  }
}
