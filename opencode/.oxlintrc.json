{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["**/node_modules/**", "testbeds/gamut/fixture/**", "out/**", "media/**"],
  "overrides": [
    {
      "files": ["decider/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["*", "!effect", "!effect/*", "!bun:test", "!./*.ts"],
                "message": "The decider kit imports effect and its own files only."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["mods/kernel/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["*", "!effect", "!effect/*", "!@dotfiles/decider/*", "!./*.ts", "!bun:test"],
                "message": "The kernel domain fence: the kernel's domain files import effect, @dotfiles/decider/*, the kernel's own root files and bun:test only; never @opencode/*, node:*, bun, a vendor package or one of the kernel's folders."
              }
            ]
          }
        ]
      }
    }
  ]
}
