{
  // The formal checks replay their traces through the mods' own modules (mods/orchestrate/machine.ts), so they
  // compile and run on the same `effect` the mods link from OpenCode's checkout (scripts/link-fork.ts).
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "types": ["bun"],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true
  },
  "include": ["."],
  "exclude": ["node_modules", ".mutants", "_apalache-out"]
}
