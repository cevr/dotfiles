Wants=network-online.target
After=network-online.target

[Service]
EnvironmentFile=/etc/hetzner-workbox/host-identity.env
Type=oneshot
Nice=10
IOSchedulingClass=idle
ExecStart=/home/exedev/Developer/personal/dotfiles/linux/hetzner-workbox/backup.sh run
