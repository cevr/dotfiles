{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalDependencies": ["tsconfig.json"],
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": [
        "**/*.ts",
        "**/*.tsx",
        "tsconfig.json",
        "$TURBO_ROOT$/tsconfig.json",
        "package.json"
      ],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "**/*.ts",
        "**/*.tsx",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "tsconfig.json",
        "$TURBO_ROOT$/tsconfig.json",
        "package.json"
      ],
      "outputs": ["dist/**"]
    },
    "test": {
      "inputs": ["**/*.ts", "**/*.tsx", "package.json"],
      "outputs": [],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
