{
  "alwaysThinkingEnabled": false,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "bashOutputMaxChars": 8000,
  "cleanupPeriodDays": 365,
  "effortLevel": "high",
  "enabledPlugins": {
    "sideshow@sideshow": true
  },
  "env": {
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-haiku-5-5",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-5-5",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "200000",
    "CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING": "1",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "CLAUDE_CODE_PLUGIN_DIRS": "~/Developer/personal/dotfiles/claude/mods/fx-ui:~/Developer/personal/dotfiles/claude/mods/status",
    "CLAUDE_CODE_SUBAGENT_MODEL": "opus"
  },
  "extraKnownMarketplaces": {
    "claude-code-warp": {
      "source": {
        "repo": "warpdotdev/claude-code-warp",
        "source": "github"
      }
    },
    "cloudflare": {
      "source": {
        "repo": "cloudflare/skills",
        "source": "github"
      }
    },
    "sideshow": {
      "source": {
        "repo": "modem-dev/sideshow",
        "source": "github"
      }
    }
  },
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "async": false,
            "command": "if command -v moshi-hook >/dev/null 2>&1; then moshi-hook claude-hook; fi",
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "async": true,
            "command": "if command -v moshi-hook >/dev/null 2>&1; then moshi-hook claude-hook; fi",
            "type": "command"
          }
        ],
        "matcher": "AskUserQuestion"
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "if command -v moshi-hook >/dev/null 2>&1; then moshi-hook claude-hook; fi",
            "type": "command"
          }
        ],
        "matcher": "ExitPlanMode"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "async": true,
            "command": "if command -v moshi-hook >/dev/null 2>&1; then moshi-hook claude-hook; fi",
            "type": "command"
          }
        ],
        "matcher": "AskUserQuestion"
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "if command -v moshi-hook >/dev/null 2>&1; then moshi-hook claude-hook; fi",
            "type": "command"
          }
        ],
        "matcher": "ExitPlanMode"
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$HOME/Developer/personal/dotfiles/claude/hooks/guard-destructive.ts\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "ORCHESTRATE_CAP=4 bun \"$HOME/Developer/personal/dotfiles/claude/hooks/guard-agent.ts\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "mcp__cua__.*",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$HOME/Developer/personal/dotfiles/claude/hooks/accept-cua.ts\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "async": true,
            "command": "if command -v moshi-hook >/dev/null 2>&1; then moshi-hook claude-hook; fi",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "async": true,
            "command": "if command -v moshi-hook >/dev/null 2>&1; then moshi-hook claude-hook; fi",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "^(startup|resume|clear|compact|fork)$"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "async": true,
            "command": "if command -v moshi-hook >/dev/null 2>&1; then moshi-hook claude-hook; fi",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "async": true,
            "command": "if command -v moshi-hook >/dev/null 2>&1; then moshi-hook claude-hook; fi",
            "type": "command"
          }
        ]
      }
    ],
    "Elicitation": [
      {
        "matcher": "cua",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$HOME/Developer/personal/dotfiles/claude/hooks/accept-cua.ts\""
          }
        ]
      }
    ]
  },
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "medium"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "permissions": {
    "allow": [
      "Read(~/Developer/personal/.better-coding-agents/resources/effect/**)",
      "WebFetch(domain:conform.guide)",
      "WebFetch(domain:effect.website)",
      "WebFetch(domain:base-ui.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:trpc.io)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:zod.dev)",
      "Skill(effect)",
      "Skill(repo-explorer)",
      "WebFetch(domain:anthropic.com)",
      "Skill(react)",
      "Skill(cleanup)",
      "mcp__cua"
    ],
    "ask": [],
    "defaultMode": "auto",
    "deny": []
  },
  "pluginConfigs": {
    "sideshow@sideshow": {
      "options": {
        "sideshowUrl": "http://localhost:8228"
      }
    }
  },
  "showThinkingSummaries": true,
  "skipAutoPermissionPrompt": true,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "auto"
}
