#!/bin/sh

set -eu
umask 077

settings_source="$HOME/.config/bite-workbox/settings-source"
claude_source="$settings_source/claude"
codex_source="$settings_source/codex"

mkdir -p "$HOME/.claude" "$HOME/.claude2" "$HOME/.codex"

codex_config_file=$(mktemp)
trap 'rm -f "$codex_config_file"' EXIT HUP INT TERM

# Both accounts share settings.json from dotfiles (synced by the bite-dotfiles
# folder); machine-local secrets live in ~/.config/secrets.env.
dotfiles_dir="$HOME/Developer/personal/dotfiles"
ln -sfn "$dotfiles_dir/claude/settings.json" "$HOME/.claude/settings.json"
ln -sfn "$dotfiles_dir/claude/settings.json" "$HOME/.claude2/settings.json"
install -m 600 "$claude_source/settings.local.json" "$HOME/.claude/settings.local.json"
install -m 755 "$claude_source/statusline-git.sh" "$HOME/.claude/statusline-git.sh"

# Reapply the composer migration after importing the legacy Mac settings.
if [ -x "$HOME/.claude/skills/fx-ui/install.sh" ]; then
  "$HOME/.claude/skills/fx-ui/install.sh"
fi

awk '
  BEGIN {
    table_started = 0
    keep_table = 1
  }
  /^\[/ {
    table_started = 1
    keep_table = $0 ~ /^\[features\]$/ || $0 ~ /^\[tui\]$/ || $0 ~ /^\[tui\.model_availability_nux\]$/ || $0 ~ /^\[notice\]$/ || $0 ~ /^\[plugins\./
  }
  !table_started || keep_table {
    print
  }
' "$codex_source/config.toml" > "$codex_config_file"

cat >> "$codex_config_file" <<'EOF'

[mcp_servers.sideshow]
url = "http://localhost:8228/mcp"
required = true

[projects."/home/exedev/Developer/work/bite"]
trust_level = "trusted"

[projects."/workspaces/bite"]
trust_level = "trusted"

[projects."/workspaces/.rifts"]
trust_level = "trusted"
EOF

install -m 600 "$codex_config_file" "$HOME/.codex/config.toml"

"$dotfiles_dir/claude/install-herdr-hook.sh"
"$HOME/.local/bin/herdr" integration install codex
