#!/bin/sh

set -eu
umask 077

settings_source="$HOME/.config/bite-workbox/settings-source"
claude_source="$settings_source/claude"

mkdir -p "$HOME/.claude" "$HOME/.codex"

# Claude shares settings.json from dotfiles (synced by the bite-dotfiles folder);
# machine-local secrets live in ~/.config/secrets.env.
dotfiles_dir="$HOME/Developer/personal/dotfiles"
ln -sfn "$dotfiles_dir/claude/settings.json" "$HOME/.claude/settings.json"
install -m 600 "$claude_source/settings.local.json" "$HOME/.claude/settings.local.json"
install -m 755 "$claude_source/statusline-git.sh" "$HOME/.claude/statusline-git.sh"

# Reapply the composer migration after importing the legacy Mac settings.
"$dotfiles_dir/claude/mods/fx-ui/install.sh"

# Codex shares config.toml from dotfiles too, and writes through the link. The
# workbox-only part is the system layer: Sideshow, and the Mac app's node_repl
# server switched off (its command exists only on the Mac). Layers merge key by key.
ln -sfn "$dotfiles_dir/codex/config.toml" "$HOME/.codex/config.toml"
ln -sfn "$dotfiles_dir/codex/agents" "$HOME/.codex/agents"
codex_system_config=$(mktemp)
trap 'rm -f "$codex_system_config"' EXIT HUP INT TERM
cat > "$codex_system_config" <<'EOF'
# Written by apply-agent-settings; the shared config is ~/.codex/config.toml.
[mcp_servers.sideshow]
url = "http://localhost:8228/mcp"
required = true

[mcp_servers.node_repl]
enabled = false
EOF
sudo -n install -D -m 644 "$codex_system_config" /etc/codex/config.toml

"$dotfiles_dir/claude/install-herdr-hook.sh"
"$HOME/.local/bin/herdr" integration install codex
