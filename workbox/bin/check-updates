#!/bin/sh

set -eu

workbox_config_dir=${WORKBOX_CONFIG_DIR:-"$HOME/.config/bite-workbox"}
updates_found=0

printf 'Ubuntu updates:\n'
apt list --upgradable 2>/dev/null | sed '1d' || true

printf '\nBun tool updates:\n'
while IFS= read -r package; do
  [ -n "$package" ] || continue

  package_name=${package%@*}
  case "$package" in
    @*)
      package_name=$(printf '%s' "$package" | sed 's/@[^@]*$//')
      ;;
  esac
  installed_version=${package##*@}
  latest_version=$(npm view "$package_name" version)

  if [ "$installed_version" != "$latest_version" ]; then
    printf '%s %s -> %s\n' "$package_name" "$installed_version" "$latest_version"
    updates_found=1
  fi
done < "$workbox_config_dir/bun-tools.txt"

printf '\n'
skills_status=0
"$(dirname "$0")/check-skills" || skills_status=$?
case "$skills_status" in
  0) ;;
  1) updates_found=1 ;;
  *) exit "$skills_status" ;;
esac

exit "$updates_found"
