#!/bin/sh

set -eu

signaled=0
skipped=0

for pid in $(pgrep -x mosh-server || true); do
  if tr '\0' '\n' < "/proc/$pid/environ" 2>/dev/null |
    grep -Eq '^MOSH_SERVER_SIGNAL_TMOUT=[1-9][0-9]*$'; then
    if kill -USR1 "$pid" 2>/dev/null; then
      signaled=$((signaled + 1))
    fi
  else
    skipped=$((skipped + 1))
  fi
done

printf 'signaled=%d skipped_legacy=%d\n' "$signaled" "$skipped"
