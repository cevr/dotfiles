#!/bin/sh

set -u

export PATH="$HOME/.local/bin:$HOME/.bun/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

failures=0

check() {
  label=$1
  shift

  if "$@" >/dev/null 2>&1; then
    printf 'PASS  %s\n' "$label"
  else
    printf 'FAIL  %s\n' "$label"
    failures=$((failures + 1))
  fi
}

check_system_service() {
  service_name=$1

  check "$service_name enabled" systemctl is-enabled --quiet "$service_name"
  check "$service_name active" systemctl is-active --quiet "$service_name"
}

check_user_service() {
  service_name=$1

  check "$service_name enabled" systemctl --user is-enabled --quiet "$service_name"
  check "$service_name active" systemctl --user is-active --quiet "$service_name"
}

check_memory_protection() {
  protection_label=$1
  protected_service=$2
  protected_memory_min=$3
  protected_memory_low=$4
  protected_oom_score_adjust=$5

  check "$protection_label protected slice" test \
    "$(systemctl show "$protected_service" -p Slice --value)" = bite.slice
  check "$protection_label hard memory floor" test \
    "$(systemctl show "$protected_service" -p MemoryMin --value)" -eq "$protected_memory_min"
  check "$protection_label soft memory floor" test \
    "$(systemctl show "$protected_service" -p MemoryLow --value)" -eq "$protected_memory_low"
  check "$protection_label kept out of swap" test \
    "$(systemctl show "$protected_service" -p MemorySwapMax --value)" -eq 0
  check "$protection_label OOM protection" test \
    "$(systemctl show "$protected_service" -p OOMScoreAdjust --value)" -eq "$protected_oom_score_adjust"
}

check_system_service tailscaled.service
check_system_service systemd-resolved.service
check_system_service bite-workbox-sshd.service
check_system_service bite-agent-settings.path
check_system_service syncthing@exedev.service
check_system_service mongod.service
check_system_service redis-server.service
check "bite.slice enabled" systemctl is-enabled --quiet bite.slice
check "bite.slice active" systemctl is-active --quiet bite.slice
check "Access hard memory floor" test \
  "$(systemctl show bite.slice -p MemoryMin --value)" -eq 268435456
check "Access soft memory floor" test \
  "$(systemctl show bite.slice -p MemoryLow --value)" -eq 536870912
check "Access slice kept out of swap" test \
  "$(systemctl show bite.slice -p MemorySwapMax --value)" -eq 0
check_memory_protection Tailscale tailscaled.service 134217728 268435456 -900
check_memory_protection Resolver systemd-resolved.service 33554432 67108864 -800
check_memory_protection "Tailscale SSH" bite-workbox-sshd.service 33554432 67108864 -900
# herdr-core (hc) holds the terminals. Its checks read hc alone, so they hold
# while herdr still runs beside it and after herdr stops; herdr's files stay
# for rollback until herdr-retire, unchecked. `hc server status` starts the
# core when none runs, in its own transient unit.
hc_status=$(hc server status --json 2>/dev/null) || hc_status=

hc_status_is() {
  printf '%s' "$hc_status" | jq -e "$1"
}

hc_core_unit_is() {
  hc_pid=$(printf '%s' "$hc_status" | jq -er '.pid') || return 1
  hc_unit=$(ps -o uunit= -p "$hc_pid" | tr -d '[:space:]')
  case "$hc_unit" in
    hc-serve-*.service) ;;
    *) return 1 ;;
  esac
  test "$(systemctl --user show "$hc_unit" -p "$1" --value)" = "$2"
}

check "hc command" command -v hc
check "hc core answers" hc_status_is '.pid | type == "number"'
check "hc core 0.1.21 or newer" hc_status_is \
  '(.version // "" | split("-")[0] | split(".") | map(tonumber? // 0)) >= [0, 1, 21]'
check "hc core keeps running after logout" hc_status_is '.keeps_running_after_logout == true'
check "hc-core.service enabled" systemctl --user is-enabled --quiet hc-core.service
check "hc core keeps running after a terminal's OOM" hc_core_unit_is OOMPolicy continue
check_user_service sideshow.service
check_user_service cleanup-mosh-servers.timer
check_user_service workbox-backup.timer
check_user_service workbox-health.timer
check_user_service workbox-update-report.timer

# shellcheck disable=SC2016
check "Resolver stub link" sh -c '
  test "$(readlink /etc/resolv.conf)" = ../run/systemd/resolve/stub-resolv.conf
'
check "Resolver primary DNS" grep -qx 'DNS=1.1.1.1' /etc/systemd/resolved.conf.d/workbox.conf
check "Resolver fallback DNS" grep -qx 'FallbackDNS=1.0.0.1' /etc/systemd/resolved.conf.d/workbox.conf
check "Public DNS" getent ahostsv4 github.com
check "Public HTTPS" curl --fail --silent --max-time 5 https://github.com/
# shellcheck disable=SC2016
check "Tailscale running" sh -c '
  tailscale status --json | jq -e ".BackendState == \"Running\"" >/dev/null
'
# shellcheck disable=SC2016
check "Tailscale automatic restarts" sh -c '
  test "$(systemctl show tailscaled.service -p NRestarts --value)" -eq 0
'
# shellcheck disable=SC2016
check "Tailscale MagicDNS" sh -c '
  tailscale_dns_name=$(tailscale status --json | jq -er .Self.DNSName) &&
    getent ahostsv4 "$tailscale_dns_name" | grep -q .
'
# shellcheck disable=SC2016
check "Tailscale address" sh -c 'test -n "$(tailscale ip -4 | head -1)"'
# shellcheck disable=SC2016
check "Tailscale SSH port" sh -c 'tailscale_ipv4=$(tailscale ip -4 | head -1); ss -ltn "sport = :2222" | grep -q "$tailscale_ipv4:2222"'
check "Sideshow HTTP" curl --fail --silent --max-time 3 http://127.0.0.1:8228/
# shellcheck disable=SC2016
check "Syncthing folders" sh -c '
  syncthing_gui_json=$(syncthing cli config gui dump-json)
  syncthing_api_key=$(printf "%s" "$syncthing_gui_json" | jq -r .apiKey)
  syncthing_gui_address=$(printf "%s" "$syncthing_gui_json" | jq -r .address)
  for folder_id in bite-dotfiles bite-env bite-aws bite-claude-settings bite-codex-settings; do
    curl -fsS -H "X-API-Key: $syncthing_api_key" \
      "http://$syncthing_gui_address/rest/db/status?folder=$folder_id" |
      jq -e ".state == \"idle\" and .needFiles == 0 and .errors == 0" >/dev/null ||
      exit 1
  done
'

check "MongoDB replica set" sh -c 'mongosh --quiet --eval "db.hello().isWritablePrimary" | grep -qx true'
check "Redis" sh -c 'redis-cli ping | grep -qx PONG'
check "GitHub CLI login" gh auth status --hostname github.com
check "AWS read-only login" aws sts get-caller-identity --profile bite-readonly
check "Grafana login" env GRAFANA_CLI_DISABLE_KEYRING=1 mati-grafana auth status --agent

check "Bite repository" test -d "$HOME/Developer/work/bite/.git"
check "Bite environment link" test -L "$HOME/Developer/work/bite/.env"
check "Rift workspace storage" workbox-rift-storage --check
check "Bite warm source" env WORKRIFT_SOURCE=/workspaces/bite workrift check
check "Rift workspace command" rift --help
check "Shared Turbo cache" test -w /workspaces/.cache/turbo
check "Workbox zshenv" test -L "$HOME/.zshenv"
check "Workbox zshrc" test -L "$HOME/.zshrc"
check "Claude settings" test -r "$HOME/.claude/settings.json"
check "Codex settings" test -L "$HOME/.codex/config.toml"
check "Sideshow MCP" grep -q '^\[mcp_servers\.sideshow\]$' /etc/codex/config.toml
check "Shared Claude skills" test -L "$HOME/.claude/skills"
check "Shared agent instructions" test -L "$HOME/.agents/AGENTS.md"
check "Shared agent skills" test -L "$HOME/.agents/skills"

check "Bun" bun --version
check "Pinned Node" install-node --check
check "Linear CLI" linear --version
check "Sentry CLI" sentry --version
check "Okra CLI" okra --version
check "Codex CLI" codex --version
check "Claude CLI" claude --version
check "Hunk CLI" hunk --version
check "Sideshow CLI" sideshow --version
check "S3 backup login" aws sts get-caller-identity --profile bite-dev
check "S3 backup bucket" aws s3api head-bucket --bucket bite-workbox-backups-251766048541 --profile bite-dev
check "Swap" sh -c 'swapon --show --noheadings | grep -q .'
# shellcheck disable=SC2016
check "Disk space" sh -c '[ "$(df --output=pcent / | tail -1 | tr -dc 0-9)" -lt 85 ]'

if [ -f /var/run/reboot-required ]; then
  printf 'WARN  Reboot required'
  if [ -r /var/run/reboot-required.pkgs ]; then
    printf ': %s' "$(tr '\n' ' ' < /var/run/reboot-required.pkgs | sed 's/[[:space:]]*$//')"
  fi
  printf '\n'
fi

if [ "$failures" -ne 0 ]; then
  printf '\n%d health checks failed.\n' "$failures"
  exit 1
fi

printf '\nAll workbox health checks passed.\n'
