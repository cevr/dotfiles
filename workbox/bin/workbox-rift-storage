#!/bin/sh

set -eu

image_path=${WORKBOX_RIFT_IMAGE:-/var/lib/bite-workspaces.btrfs}
mount_path=${WORKBOX_RIFT_MOUNT:-/workspaces}
image_size=${WORKBOX_RIFT_IMAGE_SIZE:-60G}
# user_subvol_rm_allowed: Ergo's work deletes a workspace's subvolume as the
# user (set by hand on the workbox 2026-11-15, now written here).
fstab_options=loop,noatime,compress=zstd:3,space_cache=v2,discard=async,user_subvol_rm_allowed
fstab=${WORKBOX_RIFT_FSTAB:-/etc/fstab}

# Whether the comma list $1 holds each option of the comma list $2, in any
# order, among any others (such as subvol=@workspaces).
has_options() {
  has_list=",$1,"
  has_old_ifs=$IFS
  IFS=,
  for has_option in $2; do
    case "$has_list" in
      *",$has_option,"*) ;;
      *)
        IFS=$has_old_ifs
        return 1
        ;;
    esac
  done
  IFS=$has_old_ifs
}

# The one fstab line that mounts the image here carries every option.
image_line() {
  image_options=$(awk -v img="$image_path" -v mp="$mount_path" \
    '$1 == img && $2 == mp && $3 == "btrfs" && $5 == 0 && $6 == 0 { print $4 }' "$fstab")
  test -n "$image_options" &&
    test "$(printf '%s\n' "$image_options" | wc -l)" -eq 1 &&
    has_options "$image_options" "$fstab_options"
}

usage() {
  printf 'usage: %s [--apply | --check | --fstab]\n' "$0"
  printf '\n'
  printf 'Create or check the dedicated Btrfs Rift workspace file system.\n'
  printf -- '--fstab only mounts the image'"'"'s other subvolumes from the image file (see below).\n'
}

# The image's other subvolumes (@home at /home/exedev, @tmp at /tmp, made by the
# 2026-11-13 migration) were mounted by `UUID=<the image's file system>`. A
# UUID= source makes systemd wait for /dev/disk/by-uuid/<uuid>, a link udev
# makes; the exe.dev VM masks systemd-udevd, so the link never comes, the wait
# times out after 90 s, and the boot stops in maintenance with "Dependency
# failed for home-exedev.mount" (2026-11-19 22:33Z, the first boot with those
# lines). The image line itself mounts at boot: its source is a file, so
# systemd waits for no device. So each such line names the image file with
# `loop`, as the image line does: mount(8) (util-linux 2.29 and later) reuses
# the loop device /workspaces holds for the same file, and
# x-systemd.requires-mounts-for orders the line after /workspaces, so the
# reuse always finds it attached.
sysfs_btrfs=${WORKBOX_SYSFS_BTRFS:-/sys/fs/btrfs}

# The UUID of the file system mounted at the mount path from the image: the
# /sys/fs/btrfs/<uuid> whose devices hold its loop device. Empty when none.
image_uuid() {
  image_source=$(findmnt -n -o SOURCE --mountpoint "$mount_path" 2>/dev/null | sed 's/\[.*//' | head -n 1)
  case "$image_source" in
    /dev/loop*) ;;
    *) return 0 ;;
  esac
  for image_device in "$sysfs_btrfs"/*/devices/"${image_source#/dev/}"; do
    if [ -e "$image_device" ]; then
      image_device=${image_device%/devices/*}
      printf '%s\n' "${image_device##*/}"
      return 0
    fi
  done
}

# The fstab lines that mount the image's file system by its UUID.
uuid_lines() {
  [ -n "$1" ] || return 0
  awk -v src="UUID=$1" '$1 == src && $3 == "btrfs"' "$fstab"
}

# fstab with each UUID= line of $1 naming the image file with loop (and an
# order after the mount path); every other line as it is.
fstab_by_file() {
  awk -v src="UUID=$1" -v img="$image_path" -v mp="$mount_path" '
    $1 == src && $3 == "btrfs" {
      n = split($4, opts, ",")
      has_loop = 0; has_order = 0
      for (i = 1; i <= n; i++) {
        if (opts[i] == "loop") has_loop = 1
        if (opts[i] == "x-systemd.requires-mounts-for=" mp) has_order = 1
      }
      options = $4
      if (!has_loop) options = "loop," options
      if (!has_order) options = options ",x-systemd.requires-mounts-for=" mp
      $1 = img
      $4 = options
      print
      next
    }
    { print }' "$fstab"
}

# Rewrites the image's UUID= lines (a backup first, the new file moved into
# place in one rename) and reloads systemd's units. It mounts and unmounts
# nothing: the running mounts stay as they are, and the next boot reads the
# new lines. A second run finds no UUID= line and changes nothing.
fix_fstab() {
  if native_line; then
    printf 'workbox-rift-storage: %s is a subvolume of the root file system here; nothing to change\n' "$mount_path"
    return 0
  fi
  fix_uuid=$(image_uuid)
  if [ -z "$(uuid_lines "$fix_uuid")" ]; then
    printf 'workbox-rift-storage: no fstab line mounts the image by UUID\n'
    return 0
  fi
  fix_new=$(mktemp)
  fstab_by_file "$fix_uuid" >"$fix_new"
  sudo cp -p "$fstab" "$fstab.workbox-rift-storage.$(date -u +%Y%m%dT%H%M%SZ)"
  sudo install -m 0644 "$fix_new" "$fstab.workbox-rift-storage.new"
  rm -f "$fix_new"
  sudo mv "$fstab.workbox-rift-storage.new" "$fstab"
  sudo systemctl daemon-reload
  printf 'workbox-rift-storage: the image'"'"'s subvolumes now mount from %s:\n' "$image_path"
  awk -v img="$image_path" '$1 == img' "$fstab"
}

# A box whose disks are btrfs (the Hetzner workbox, linux/hetzner-workbox)
# mounts the subvolume @workspaces of its own file system here, by UUID, with
# no image.
native_line() {
  grep -Eq "^UUID=[^ ]+ $mount_path btrfs ([^ ]*,)?subvol=@workspaces(,[^ ]*)? " "$fstab"
}

check_state() {
  test "$(findmnt -n -o FSTYPE --target "$mount_path")" = btrfs
  has_options "$(findmnt -n -o OPTIONS --target "$mount_path")" compress=zstd:3,user_subvol_rm_allowed
  test -d "$mount_path/bite"
  test -d "$mount_path/.rifts"
  test -d "$mount_path/.cache/turbo"
  test -w "$mount_path"
  if native_line; then
    return 0
  fi
  test -f "$image_path"
  image_line
  # No line waits for a by-uuid link udev never makes here (fix_fstab).
  test -z "$(uuid_lines "$(image_uuid)")"
}

case "${1:---check}" in
  --check)
    check_state
    printf 'Rift workspace storage checks passed.\n'
    exit 0
    ;;
  --fstab)
    fix_fstab
    exit 0
    ;;
  --apply) ;;
  --help|-h)
    usage
    exit 0
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac

if [ "$(uname -s)" != Linux ]; then
  printf 'workbox-rift-storage: this command requires Linux\n' >&2
  exit 1
fi

for command_name in btrfs findmnt mkfs.btrfs; do
  command -v "$command_name" >/dev/null 2>&1 || {
    printf 'workbox-rift-storage: required command is missing: %s\n' "$command_name" >&2
    exit 1
  }
done

if findmnt --mountpoint "$mount_path" >/dev/null 2>&1; then
  current_type=$(findmnt -n -o FSTYPE --mountpoint "$mount_path")
  if [ "$current_type" != btrfs ]; then
    printf 'workbox-rift-storage: %s is mounted as %s\n' "$mount_path" "$current_type" >&2
    exit 1
  fi
else
  if [ -e "$mount_path" ] && [ -n "$(find "$mount_path" -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null)" ]; then
    printf 'workbox-rift-storage: mount path is not empty: %s\n' "$mount_path" >&2
    exit 1
  fi

  if [ ! -e "$image_path" ]; then
    sudo install -d -m 0755 "$(dirname "$image_path")"
    sudo fallocate -l "$image_size" "$image_path"
    sudo chmod 0600 "$image_path"
    sudo mkfs.btrfs -f -K -L bite-workspaces "$image_path" >/dev/null
  elif ! sudo blkid -p -s TYPE -o value "$image_path" | grep -qx btrfs; then
    printf 'workbox-rift-storage: image is not a Btrfs file system: %s\n' "$image_path" >&2
    exit 1
  fi

  sudo install -d -m 0755 "$mount_path"
  fstab_line="$image_path $mount_path btrfs $fstab_options 0 0"
  # Any line for the image here counts: a second one would mount over it.
  if ! grep -Fq "$image_path $mount_path btrfs " "$fstab"; then
    printf '%s\n' "$fstab_line" | sudo tee -a "$fstab" >/dev/null
  fi
  sudo mount "$mount_path"
fi
fix_fstab

sudo chown "$USER:$(id -gn)" "$mount_path"
mkdir -p "$mount_path/.rifts" "$mount_path/.cache/turbo"
chmod 0700 "$mount_path/.rifts" "$mount_path/.cache" "$mount_path/.cache/turbo"

# The Bite base starts as a btrfs subvolume, so each workspace of it is one
# snapshot (`workrift subvolume` converts one made as a folder before).
if [ ! -d "$mount_path/bite" ]; then
  btrfs subvolume create "$mount_path/bite" >/dev/null
fi

check_state
printf 'Rift workspace storage is ready at %s.\n' "$mount_path"
