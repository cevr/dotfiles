#!/bin/sh
# shellcheck disable=SC3043 # local: dash, bash and busybox sh all have it
# Branch workspaces on top of Rift.
# (Line 3 stays as every workrift's has been: process_runs_old_holder knows a
# workrift by it. The workspaces are work's now, as below.)
#
# Each repository has one clean warm source: a work base that holds installed
# dependencies and compiled output and never carries feature work. `create`
# copies that base (`work new`) and checks out a branch inside the copy, so
# every workspace starts warm. work owns the copies, the registry and the
# trash; this script adds the Git branch workflow around them.
#
# A branch change inside a workspace can change the lock file without going
# through workrift. For repositories that use lefthook, the source gets an
# untracked lefthook-local.yml that runs `workrift deps` after checkout, merge
# and rewrite, and the copy carries it into every workspace. The same moves
# make the build output stale, so `deps` also runs the warm step when HEAD's
# tree differs from the one the last warm step built.
#
# Per-repository settings live in the source's Git config:
#   workrift.main     default branch (default: origin HEAD)
#   workrift.install  dependency install (default: from the lock file)
#   workrift.warm     build step after the install, run by refresh and create
#                     (default: none; init and `settings` set it from the
#                     table in base_settings)
#
# Workspaces are Ergo's work (the binary $WORK, else `work` on PATH): a warm
# source is a base `work init` made, and a workspace is its `work new` clone
# under <base's folder>/.work/<base>/. The Rift backend is gone: a backend file
# (below) that names anything but `work` fails every command, naming the fix.

set -eu

workrift_root="${WORKRIFT_ROOT:-/workspaces}"
config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/workrift"
keep_file="${WORKRIFT_KEEP_FILE:-$config_dir/keep}"
prune_idle_minutes=2880
# How old a Creating record must be before remove takes its folder as half-made.
half_made_min_age=3600
backend_file="${WORKRIFT_BACKEND_FILE:-$config_dir/backend}"
work_bin="${WORK:-work}"
# Where each process's working folder is read (a test points it at a folder of
# its own: macOS has no /proc).
proc_root="${WORKRIFT_PROC:-/proc}"
# Whether remove deletes a workspace for good (the workbox, Linux) or leaves
# it in work's trash (the Mac). WORKRIFT_PURGE=1 or 0 overrides.
case "${WORKRIFT_PURGE:-}" in
  1) purge_trash=true ;;
  0) purge_trash=false ;;
  *) [ "$(uname -s)" = Linux ] && purge_trash=true || purge_trash=false ;;
esac
# Under `work`: idle is two days, as above. The workbox keeps no trash (owner,
# 2026-11-19): remove deletes a workspace for good, and prune empties all of it.
work_idle=48h
# Held: work's own verify found `work gc -idle -archive` can lose data (an
# adopted copy with fresh edits, other branches, stashes). Until work's owner
# clears it, prune calls no work gc. Flip to true then.
work_gc_safe=false

usage() {
  cat <<'EOF'
usage: workrift <command>

  init <repository> [path]    clone a repository as a warm source (a work base)
  create <branch>             create a workspace for a branch from the warm source
  deps [rebase|amend]         install dependencies if the lock file changed since the last install,
                              and run the warm step if HEAD's tree changed since the last warm
                              (post-rewrite passes its argument: rebase means a rebase has ended)
  refresh                     update the warm source from its default branch
  advance                     bring the warm source to its default branch (when its window is due):
                              fetch, fast-forward, install, hooks; create starts it in the background
  hold [--shared] -- <command...>
                              run a command in the warm source with its lock held (exclusive
                              unless --shared), in line with creates and advances
  list                        list the warm source's workspaces
  remove [--dry-run] [--with-children] [path | branch]
                              delete a workspace for good; --dry-run prints the
                              folders it would delete and deletes nothing
  prune [--dry-run]           archive and remove workspaces idle for two days
  sources                     list warm sources
  check                       check the warm source, and warn when its build output is old
  settings                    give the warm source its host settings from workrift's
                              table (warm step, .env link); init does it too
  subvolume [--back | --drop-old] [--check] [--apply] [--beside-other-removals]
            [--beside-unreadable]
                              make the warm source a btrfs subvolume (each workspace a
                              snapshot); --back makes it the plain folder it was;
                              --drop-old deletes the tree kept from the last switch;
                              a dry run (preflight and exact steps) unless --apply;
                              a removal of another base refuses it unless
                              --beside-other-removals (one of this base always does);
                              a process it cannot look into (another user's) is read
                              with sudo -n, else refuses it unless --beside-unreadable

The warm source is WORKRIFT_SOURCE, else the work base whose workspace (or
itself) the current directory is, else the base with the same origin as the
current checkout. The backend file (WORKRIFT_BACKEND_FILE, else
~/.config/workrift/backend) is optional; when present it must say work.
EOF
}

fail() {
  fail_said=1
  printf 'workrift: %s\n' "$*" >&2
  # workrift subvolume: every refusal and every stop also says the state both
  # trees are in and the command that goes on from there (sv_facts).
  if [ -n "${sv_at:-}" ]; then sv_facts >&2 || true; fi
  exit 1
}

# sv_read VAR CMD [ARG...]: the output of CMD into the variable VAR, and CMD's
# status as its own: 0 only when CMD ran and succeeded. Every read workrift
# subvolume decides on goes through it, so a command that failed is never an
# empty answer: set -e stops no read in `$(…)` inside another command, in a
# pipe but its last command, or left of `||`, `&&` and in a condition, and a
# pipe answers its last command's status alone (no pipefail in sh).
# shellcheck disable=SC2034 # sv_read_out is read by the eval
sv_read() {
  sv_read_to=$1
  shift
  if sv_read_out=$("$@"); then
    eval "$sv_read_to=\$sv_read_out"
    return 0
  else
    sv_read_rc=$?
    eval "$sv_read_to=\$sv_read_out"
    return "$sv_read_rc"
  fi
}

# Compare remotes by host and path, so SSH and HTTPS URLs of one repository match.
normalized_origin() {
  git -C "$1" remote get-url origin 2>/dev/null |
    sed -E 's#^[a-z+]+://##; s#^[^@/]+@##; s#:#/#; s#\.git$##; s#/+$##'
}

resolve_source() {
  if [ -n "${WORKRIFT_SOURCE:-}" ]; then
    printf '%s\n' "$WORKRIFT_SOURCE"
    return
  fi

  top=$(git rev-parse --show-toplevel 2>/dev/null) || fail 'run inside a Git checkout or set WORKRIFT_SOURCE'
  work_resolve_source "$top"
}

require_source() {
  test -d "$1/.git" || fail "not a Git repository: $1"
  test -f "$1/work.toml" || fail "not a work base (run work init there): $1"
}

main_branch() {
  configured=$(git -C "$1" config --get workrift.main || true)
  if [ -n "$configured" ]; then
    printf '%s\n' "$configured"
    return
  fi
  head=$(git -C "$1" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)
  if [ -z "$head" ]; then
    git -C "$1" remote set-head origin --auto >/dev/null
    head=$(git -C "$1" symbolic-ref --short refs/remotes/origin/HEAD)
  fi
  printf '%s\n' "${head#origin/}"
}

lock_files='bun.lock bun.lockb pnpm-lock.yaml yarn.lock package-lock.json'

# A dependency patch (bun and pnpm keep them in patches/) can change while the
# lock file stays the same, and the install applies it, so it counts too.
#
# Fails when a hash fails (never an empty hash that two failed reads make
# equal); what it printed before is the caller's to drop.
lock_fingerprint() {
  for lock_file in $lock_files; do
    if [ -f "$1/$lock_file" ]; then
      lock_hash=$(git -C "$1" hash-object "$lock_file") || return 1
      printf '%s %s\n' "$lock_file" "$lock_hash"
    fi
  done
  for patch_file in "$1"/patches/*.patch; do
    [ -f "$patch_file" ] || continue
    lock_hash=$(git -C "$1" hash-object "$patch_file") || return 1
    printf '%s %s\n' "patches/${patch_file##*/}" "$lock_hash"
  done
}

install_dependencies() {
  command=$(git -C "$1" config --get workrift.install || true)
  if [ -z "$command" ]; then
    if [ -f "$1/bun.lock" ] || [ -f "$1/bun.lockb" ]; then
      command='bun install --frozen-lockfile'
    elif [ -f "$1/pnpm-lock.yaml" ]; then
      command='pnpm install --frozen-lockfile'
    elif [ -f "$1/yarn.lock" ]; then
      command='yarn install --immutable'
    elif [ -f "$1/package-lock.json" ]; then
      command='npm ci'
    else
      return 0
    fi
  fi
  # Close the source lock so a daemon the install starts cannot hold it.
  (cd "$1" && sh -c "$command") 3>&- 6>&- 7>&- 8>&- 9>&-
  # A fingerprint that does not read is no record: the next sync installs again.
  i_locks=$(installed_locks_file "$1")
  lock_fingerprint "$1" >"$i_locks" || rm -f "$i_locks"
}

# The fingerprint of the last install lives in the Git directory, so --copy-all
# carries it into each workspace together with the installed dependencies.
installed_locks_file() {
  git -C "$1" rev-parse --path-format=absolute --git-path workrift-installed-locks
}

sync_dependencies() {
  locks_file=$(installed_locks_file "$1")
  if [ -f "$locks_file" ] && [ "$(lock_fingerprint "$1")" = "$(cat "$locks_file")" ]; then
    return 0
  fi
  install_dependencies "$1"
}

warm_command() {
  git -C "$1" config --get workrift.warm || true
}

run_warm() {
  # A build can leave a daemon running (turbo); it must not inherit the source lock.
  (cd "$1" && sh -c "$2") 3>&- 6>&- 7>&- 8>&- 9>&-
}

# The tree the last successful warm step built, kept in the Git directory beside
# the install fingerprint, so a copy carries it together with the build output.
warmed_tree_file() {
  git -C "$1" rev-parse --path-format=absolute --git-path workrift-warmed-tree
}

# Whether $1 is in the middle of a rebase, merge, cherry-pick, revert or bisect,
# or holds unmerged paths: its files may carry conflict markers, and the
# operation's last step (post-rewrite at a rebase's end) moves HEAD again.
# Git runs that post-rewrite before it removes the rebase state, so $2 =
# rebase (post-rewrite's argument) leaves the rebase state out. A rebase whose
# todo list is empty is ending: one that only moves HEAD (a fast-forward, or
# every own commit already upstream) runs post-checkout then and no
# post-rewrite, so it counts as done once no path is unmerged.
operation_in_progress() {
  [ -z "$(git -C "$1" ls-files -u)" ] || return 0
  for state in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD BISECT_LOG; do
    [ ! -e "$(git -C "$1" rev-parse --path-format=absolute --git-path "$state")" ] || return 0
  done
  [ "${2:-}" != rebase ] || return 1
  [ ! -e "$(git -C "$1" rev-parse --path-format=absolute --git-path rebase-apply)" ] || return 0
  rebase_dir=$(git -C "$1" rev-parse --path-format=absolute --git-path rebase-merge)
  [ -e "$rebase_dir" ] || return 1
  [ -f "$rebase_dir/git-rebase-todo" ] && ! grep -qv -e '^#' -e '^[[:space:]]*$' "$rebase_dir/git-rebase-todo" && return 1
  return 0
}

# Build output is only right for the tree it was built from: a workspace whose
# HEAD moved since (a merge, a switch, a detach, a rebase) reads a stale build.
# Run the warm step in $1 unless its last run built HEAD's tree, HEAD is unborn,
# an operation is in progress, or WORKRIFT_WARM=0. The step runs in the
# foreground, its output in a log in the Git directory. The marker is cleared
# first: a step that fails may leave the output half gone, so no tree counts as
# built until one succeeds. $2 is the checkout whose Git config holds the warm
# step (create reads the source's, as before), $3 post-rewrite's argument. An
# amend changes no file in the working tree, so, like the commit before it
# (which runs no hook), it builds nothing.
warm_build() {
  [ "${WORKRIFT_WARM:-1}" != 0 ] || return 0
  [ "${3:-}" != amend ] || return 0
  warm=$(warm_command "$2")
  [ -n "$warm" ] || return 0
  tree=$(git -C "$1" rev-parse -q --verify 'HEAD^{tree}') || return 0
  tree_file=$(warmed_tree_file "$1")
  if [ -f "$tree_file" ] && [ "$(cat "$tree_file")" = "$tree" ]; then
    return 0
  fi
  ! operation_in_progress "$1" "${3:-}" || return 0
  warm_log=$(git -C "$1" rev-parse --path-format=absolute --git-path workrift-warm.log)
  printf 'workrift: rebuilding changed packages (WORKRIFT_WARM=0 skips)\n' >&2
  : >"$tree_file"
  if run_warm "$1" "$warm" >"$warm_log" 2>&1; then
    printf '%s\n' "$tree" >"$tree_file"
    printf 'workrift: warm step done; log: %s\n' "$warm_log" >&2
  else
    printf 'workrift: warm step failed in %s; build output may be stale; log: %s\n' "$1" "$warm_log" >&2
  fi
}

dependency_hook_marker='# Managed by workrift: keep dependencies in step with the lock file.'

managed_hook_config() {
  printf '%s\n' "$dependency_hook_marker"
  for hook in post-checkout post-merge; do
    printf '%s:\n  jobs:\n    - name: workrift deps\n      run: workrift deps\n' "$hook"
  done
  # post-rewrite's argument (rebase or amend) tells deps a rebase has ended.
  printf 'post-rewrite:\n  jobs:\n    - name: workrift deps\n      run: workrift deps {1}\n'
}

# A workspace keeps the lefthook-local.yml its source had when it was made;
# deps brings a managed one up to date, so its next hook runs today's jobs. The
# hooks lefthook installed stay: the file changes jobs, not which hooks run.
sync_dependency_hooks() {
  local_config="$1/lefthook-local.yml"
  [ -f "$local_config" ] && grep -qxF "$dependency_hook_marker" "$local_config" || return 0
  managed=$(managed_hook_config)
  [ "$(cat "$local_config")" = "$managed" ] || printf '%s\n' "$managed" >"$local_config"
}

# lefthook merges lefthook-local.yml into the tracked lefthook.yml, and the
# repository's prepare script regenerates .git/hooks from the merged config.
install_dependency_hooks() {
  [ -f "$1/lefthook.yml" ] || return 0
  local_config="$1/lefthook-local.yml"
  if [ -e "$local_config" ] && ! grep -qxF "$dependency_hook_marker" "$local_config"; then
    printf 'workrift: %s is not managed by workrift; dependency hooks not installed\n' "$local_config" >&2
    return 0
  fi
  managed_hook_config >"$local_config"
  exclude_file=$(git -C "$1" rev-parse --path-format=absolute --git-path info/exclude)
  mkdir -p "$(dirname "$exclude_file")"
  grep -qxF '/lefthook-local.yml' "$exclude_file" 2>/dev/null || printf '/lefthook-local.yml\n' >>"$exclude_file"
  if [ -x "$1/node_modules/.bin/lefthook" ]; then
    (cd "$1" && node_modules/.bin/lefthook install >/dev/null) 3>&- 6>&- 7>&- 8>&- 9>&-
  fi
}

# The folder name of a branch's workspace: create names the workspace by it,
# and remove finds a workspace by it (workspace_by_name).
workspace_name() {
  printf '%s' "$1" |
    tr '/[:space:]' '--' |
    tr -cd '[:alnum:]._-' |
    sed 's/^-*//; s/-*$//'
}

# Where origin's default branch $2 and the branch $3 are, read from the base
# $1 without writing it (ls-remote): remote_main and remote_branch (empty when
# origin has no such branch). A create fetches into its workspace, never into
# the base: a fetch writes the base's refs and objects through files it renames
# into place, and a copy beside it would fail on the one that went away.
remote_heads() {
  r_heads=$(git -C "$1" ls-remote origin "refs/heads/$2" "refs/heads/$3")
  remote_main=$(printf '%s\n' "$r_heads" | awk -v ref="refs/heads/$2" '$2 == ref { print $1 }')
  remote_branch=$(printf '%s\n' "$r_heads" | awk -v ref="refs/heads/$3" '$2 == ref { print $1 }')
  [ -n "$remote_main" ] || fail "origin has no branch $2 (git ls-remote in $1)"
}

# After the copy, outside any lock: the workspace $1 fetches origin's default
# branch $3 and, when origin has it, the branch $2, and moves the branch it
# was made on to where it starts: a branch the base had is fast-forwarded to
# origin's, one origin has starts there and tracks it, a new one starts at
# origin's default branch with no upstream (its first push sets its own). The
# copy started at the base's HEAD, so only the files that differ are written.
# $4 says the base had the branch. Git hooks print to stdout, and stdout
# carries only the workspace path.
workspace_start() {
  if [ -n "$remote_branch" ]; then
    git -C "$1" fetch --no-tags origin "+refs/heads/$3:refs/remotes/origin/$3" "+refs/heads/$2:refs/remotes/origin/$2" >&2
  else
    git -C "$1" fetch --no-tags origin "+refs/heads/$3:refs/remotes/origin/$3" >&2
  fi
  if [ "$4" = true ]; then
    [ -z "$remote_branch" ] || git -C "$1" merge --ff-only "origin/$2" >&2
  elif [ -n "$remote_branch" ]; then
    git -C "$1" reset -q --keep "origin/$2" >&2
    git -C "$1" branch --quiet --set-upstream-to "origin/$2" "$2" >&2
  else
    git -C "$1" reset -q --keep "origin/$3" >&2
  fi
}

# `gh stack` keeps its metadata in .git/gh-stack of the checkout that made the
# stack. Carry it over when the command runs from that checkout.
find_gh_stack_metadata() {
  source_path=$1
  branch=$2
  caller_git_dir=$(git rev-parse --absolute-git-dir 2>/dev/null || true)
  if [ -z "$caller_git_dir" ] || [ ! -f "$caller_git_dir/gh-stack" ]; then
    return 1
  fi
  if [ "$(git remote get-url origin 2>/dev/null || true)" != "$(git -C "$source_path" remote get-url origin)" ]; then
    return 1
  fi
  jq empty "$caller_git_dir/gh-stack" >/dev/null 2>&1 || {
    printf 'workrift: invalid gh stack metadata: %s\n' "$caller_git_dir/gh-stack" >&2
    return 2
  }
  jq -e --arg branch "$branch" \
    'any(.stacks[]?; .trunk.branch == $branch or any(.branches[]?; .branch == $branch))' \
    "$caller_git_dir/gh-stack" >/dev/null || return 1
  printf '%s\n' "$caller_git_dir/gh-stack"
}

create_workspace() {
  branch=$1
  source_path=$(resolve_source)
  require_source "$source_path"
  name=$(workspace_name "$branch")
  [ -n "$name" ] || fail 'branch does not make a valid workspace name'

  phase_label="create $branch"
  create_started=$(date +%s)
  main=$(main_branch "$source_path")
  phase "look up $branch and $main on origin"
  remote_heads "$source_path" "$main" "$branch"

  if gh_stack_metadata=$(find_gh_stack_metadata "$source_path" "$branch"); then
    :
  else
    status=$?
    [ "$status" -eq 1 ] || exit "$status"
    gh_stack_metadata=
  fi

  # While the copy is made, the Git hooks its branch switch fires (lefthook's
  # post-checkout and post-merge run `workrift deps`) install and build
  # nothing: this create installs and builds the workspace once the base's
  # lock is free.
  WORKRIFT_CREATING=1
  export WORKRIFT_CREATING
  phase "lock $source_path"
  lock_purpose="create $branch"
  # The copy reads the base under the shared lock, beside every other copy.
  # A move a kill cut short (the moving marker) is repaired before any copy:
  # its install again, under the exclusive lock.
  lock_source "$source_path" shared
  while [ -e "$(moving_file "$source_path")" ]; do
    unlock_source
    phase 'base: repair a move a kill cut short'
    repair_base "$source_path"
    lock_source "$source_path" shared
  done
  phase 'locked'
  base_wants "$source_path" "$main" "$remote_main"
  # One clone or delete of a copy base at a time (lock_clone).
  phase 'clone turn'
  lock_clone "$source_path" "clone $name (create $branch)"
  phase "clone $name"
  made=$(work_new "$source_path" "$name" "$branch")
  unlock_clone
  unlock_source
  work_deps_tag=${made%%	*}
  made=${made#*	}
  had_branch=${made%%	*}
  workspace=${made#*	}
  phase "fetch $branch and $main into the workspace"
  workspace_start "$workspace" "$branch" "$main" "$had_branch"
  unset WORKRIFT_CREATING

  start_advance "$source_path" "$main"

  if [ -n "$gh_stack_metadata" ]; then
    cp -p "$gh_stack_metadata" "$(git -C "$workspace" rev-parse --absolute-git-dir)/gh-stack"
    printf 'Imported gh stack metadata from %s.\n' "$gh_stack_metadata" >&2
  fi

  # The install is decided from the workspace's final head: work_new may have
  # fast-forwarded the branch to origin's after `work new` installed, and the
  # hook that merge fired deferred (WORKRIFT_CREATING). `work new` installs
  # by the base's work.toml [deps] when it finds the lock changed (Installed):
  # then the deps step `workrift deps` runs (work deps, by work's record of
  # what it installed) brings it to the lock the workspace ends with, and
  # installs nothing when that is the lock work installed. Otherwise workrift
  # installs when the final lock differs from what the copy carries.
  phase 'workspace: install if its lock file changed'
  # Untrusted: work installed nothing (its work.toml's commands are not
  # trusted on this host), so workrift installs with its own fixed command,
  # as for NoDeps (trust_note).
  # work new starts the workspace at the base's head, so its Unchanged is of
  # the base's lock; the branch the workspace moved to after may carry another.
  # Where work installs ([deps]), work deps (by its own record) installs that
  # one, once, and the next `workrift deps` finds it installed.
  # workspace_deps says itself when work did not trust the file.
  w_noted=false
  case "$work_deps_tag" in
    Unchanged)
      if work_installs "$source_path"; then
        workspace_deps "$source_path" "$workspace" >&2
        w_noted=true
      else
        sync_dependencies "$workspace" >&2
      fi
      ;;
    '' | NoDeps | Untrusted) sync_dependencies "$workspace" >&2 ;;
    Installed)
      workspace_deps "$source_path" "$workspace" >&2
      w_noted=true
      ;;
  esac
  [ "$w_noted" = true ] || trust_note "$source_path" "$work_deps_tag"
  # The copied build output matches the source's tree, not the branch's. A warm
  # step that shares its cache with the source rebuilds only what differs.
  note_cold "$source_path"
  phase 'workspace: warm step if its tree changed'
  warm_build "$workspace" "$source_path" >&2
  phase "done: $workspace"
  printf '%s\n' "$workspace"
}

initialize_source() {
  repository=$1
  source_path=${2:-$workrift_root/$(basename "$repository" .git)}
  if [ -e "$source_path" ] && [ -n "$(find "$source_path" -mindepth 1 -maxdepth 1 -print -quit)" ]; then
    fail "path is not empty: $source_path"
  fi
  # On btrfs a new base starts as a subvolume, so each workspace of it is one
  # snapshot (workrift subvolume converts a base made before).
  if [ ! -e "$source_path" ] && [ ! -L "$source_path" ] &&
    [ "$(stat -f -c %T "$(dirname "$source_path")" 2>/dev/null)" = btrfs ]; then
    btrfs subvolume create "$source_path" >/dev/null || fail "btrfs subvolume create $source_path failed"
  fi
  git clone "$repository" "$source_path"
  work_init "$source_path"
  apply_base_settings "$source_path"
  refresh_source "$source_path"
}

# A base's host settings, by its path: the warm step (base_warm) and the file
# its .env links to (base_env); both empty for a base the table does not name.
# Goes away once Ergo's work declares the warm step in the base's work.toml.
base_settings() {
  base_warm=
  base_env=
  case "$1" in
    "$workrift_root/bite")
      base_warm="TURBO_CACHE=local:rw TURBO_CACHE_DIR=$workrift_root/.cache/turbo bun run compile"
      base_env="$HOME/.config/bite-workbox/bite-env/.env"
      ;;
  esac
}

# The one writer of a base's host settings, run by init and by bootstrap
# (`workrift settings`): the .env link and workrift.warm, from base_settings.
# A warm step or an .env already set to something else stays, and is reported.
apply_base_settings() {
  base_settings "$1"
  if [ -n "$base_env" ]; then
    if [ -e "$1/.env" ] && [ ! -L "$1/.env" ]; then
      printf 'workrift: %s/.env is a file of its own; left as it is, not linked to %s\n' "$1" "$base_env" >&2
    else
      ln -sfn "$base_env" "$1/.env"
      # The link is the host's, never a change of the base's.
      exclude_file=$(git -C "$1" rev-parse --path-format=absolute --git-path info/exclude)
      mkdir -p "$(dirname "$exclude_file")"
      grep -qxF '/.env' "$exclude_file" 2>/dev/null || printf '/.env\n' >>"$exclude_file"
    fi
  fi
  if [ -n "$base_warm" ]; then
    current=$(warm_command "$1")
    if [ -z "$current" ]; then
      git -C "$1" config workrift.warm "$base_warm"
    elif [ "$current" != "$base_warm" ]; then
      printf "workrift: %s keeps its warm step '%s'; workrift's table has '%s'\n" "$1" "$current" "$base_warm" >&2
    fi
  fi
}

# One line when the base has no warm step and never warmed: its workspaces
# start cold (no build output).
note_cold() {
  if [ -z "$(warm_command "$1")" ] && [ ! -s "$(warmed_tree_file "$1")" ]; then
    printf 'workrift: %s has no warm step (git config workrift.warm) and was never warmed; its workspaces start cold\n' "$1" >&2
  fi
}

# A base's locks are queues of tickets, kept outside the base, in its state
# folder (state_dir): a copy (`work new`) clones the whole base,
# Git directory too, and a file a sibling adds or removes in it while the copy
# runs fails that copy (cp: ...: No such file or directory; 2 of 60 creates
# when the holder records were kept in .git, 2026-11-21). Nothing workrift
# writes changes the base while a copy may read it: every write of the base (a
# fetch, a fast-forward, an install, the managed hooks, a warm, a settings
# change) is a writer's, under the exclusive lock.
#
# Two queues, always taken in this order and never one while waiting for the
# other the wrong way round:
#   advance/  one advance, refresh or repair at a time
#   base/     the base's lock: shared (.r) while a copy reads the base,
#             exclusive (.w) while the base changes
# A ticket is a file named <number>.<r|w>, numbered in the order of arrival
# (allocated under the state folder's queue.lock, held for milliseconds). Its
# owner holds it locked (flock -x) from its allocation to its end, so it ends
# when the owner closes it, exits or dies (kill -9 included: the kernel drops
# the lock). A writer enters once every earlier ticket has ended; a reader once
# every earlier writer has. So service is in arrival order across both kinds,
# readers next to each other in line go in together, a writer is never
# starved by a stream of readers (those behind it wait for it), and readers
# never by writers (a reader waits only for the writers before it). A wait is
# bounded by the holds before it in line. The background advance alone is
# polite: it takes its place in line only once the line is empty, or after
# advance_every seconds (queue_enter's polite mode), so creates rarely wait
# behind it for the copies before it.
#
# Linux flock keeps no order among waiters: before 2026-11-22 the lock was one
# flock taken with `flock -w 60` in a loop, and three creates waited about
# 78 minutes while eight that came later got the lock.
#
# A ticket records its owner (pid and identity, process_identity), since when,
# whether it waits or holds, and what for, so a waiter can say whom it waits
# for. A ticket whose owner is gone (a child that inherited the descriptor
# outlived it) is no longer waited for once a waiter sees the owner gone, within
# seconds; one whose lock is free is removed by the next allocation.
git_path() {
  git -C "$1" rev-parse --path-format=absolute --git-path "$2"
}

# The folder of a base's workspaces, by work's own rule (Ergo's
# modules/work/work/api.ergo Home): work.toml's [work] storage, relative to the
# base, with <base> its folder's name; else <base's folder>/.work/<base's name>.
#
# Fails when a read fails (awk, sed, dirname, basename): a home read wrong is
# another state folder and another line, so it is never guessed.
base_home() {
  h_storage=
  if [ -f "$1/work.toml" ]; then
    h_storage=$(awk '
      /^[[:space:]]*\[/ { section = $0; gsub(/[[:space:]]/, "", section); next }
      section == "[work]" && /^[[:space:]]*storage[[:space:]]*=/ {
        line = $0
        sub(/^[^=]*=[[:space:]]*"/, "", line)
        sub(/".*$/, "", line)
        print line
        exit
      }' "$1/work.toml") || return 1
  fi
  h_name=$(basename "$1") || return 1
  if [ -z "$h_storage" ]; then
    h_parent=$(dirname "$1") || return 1
    printf '%s/.work/%s\n' "$h_parent" "$h_name"
    return 0
  fi
  h_storage=$(printf '%s' "$h_storage" | sed "s|<base>|$h_name|g") || return 1
  case "$h_storage" in
    /*) printf '%s\n' "$h_storage" ;;
    *) printf '%s/%s\n' "$1" "$h_storage" ;;
  esac
}

# The base's state folder, into state_value: <home>/.workrift beside its
# workspaces, outside the base (a storage inside the base is refused: a copy
# would read it).
state_dir() {
  if [ "${state_for:-}" != "$1" ]; then
    s_dir=$(base_home "$1") || fail "the workspaces' folder of $1 does not read (work.toml's [work] storage; awk, sed, dirname or basename failed): nothing done"
    s_dir=$s_dir/.workrift
    mkdir -p "$s_dir" || fail "mkdir -p $s_dir failed (the state folder of $1): nothing done"
    s_dir=$(cd "$s_dir" && pwd -P) || fail "the state folder $s_dir does not resolve: nothing done"
    s_base=$(cd "$1" && pwd -P) || fail "$1 does not resolve: nothing done"
    case "$s_dir/" in
      "$s_base/"*) fail "the state folder $s_dir is inside the base $1 (work.toml's storage): a copy of the base would read it" ;;
    esac
    state_for=$1
    state_value=$s_dir
  fi
}

# A Git command that changes the base, under its exclusive lock: no automatic
# gc or maintenance (a detached gc would repack the base beside the next
# copies) and no ticket descriptor for a child to keep.
base_git() {
  b_dir=$1
  shift
  git -c gc.auto=0 -c maintenance.auto=false -C "$b_dir" "$@" 3>&- 6>&- 7>&- 8>&- 9>&-
}

# The identity of the process $1, the same whoever reads it (empty when it is
# gone): a pid's start, so a pid a new process reuses is another identity.
# Read so that no environment changes it: `ps -o lstart` prints the start in
# the caller's TZ and locale, and a waiter with another TZ or LANG took a live
# holder for dead (two exclusive holders, 2026-11-22). On Linux it is the start
# in clock ticks since boot (field 22 of /proc/<pid>/stat, after the command
# name, which may hold spaces and parentheses) and the boot's id; elsewhere
# (macOS) ps's lstart with the locale and the zone forced: LC_ALL=C TZ=UTC0.
# Every write and every check of an identity is this function.
# WORKRIFT_STAT_PROC stands for /proc, for tests only.
identity_proc=${WORKRIFT_STAT_PROC:-/proc}
process_identity() {
  case "$1" in '' | *[!0-9]*) return 0 ;; esac
  if [ -r "$identity_proc/self/stat" ]; then
    i_stat=$(cat "$identity_proc/$1/stat" 2>/dev/null) || return 0
    # A read that fails is no identity (empty: process_is asks kill -0),
    # never another one, which would read as a process gone.
    i_tick=$(printf '%s\n' "${i_stat##*) }" | awk '{ print $20 }') || return 0
    case "$i_tick" in '' | *[!0-9]*) return 0 ;; esac
    i_boot=$(cat "$identity_proc/sys/kernel/random/boot_id" 2>/dev/null) || return 0
    [ -n "$i_boot" ] || return 0
    printf 'boot %s tick %s\n' "$i_boot" "$i_tick"
  else
    LC_ALL=C TZ=UTC0 ps -o lstart= -p "$1" 2>/dev/null | sed 's/^ *//; s/ *$//' || true
  fi
}

# Whether the owner a ticket file records is known to be gone: its pid no
# longer has the identity recorded. A ticket whose record cannot be read (empty,
# cut short) has no known owner, so it is never taken for gone: while its lock
# is held it is live (fail closed: wait rather than grant twice).
ticket_owner_gone() {
  t_pid=$(sed -n 1p "$1" 2>/dev/null) || return 1
  case "$t_pid" in '' | *[!0-9]*) return 1 ;; esac
  t_start=$(sed -n 2p "$1" 2>/dev/null) || return 1
  [ -n "$t_start" ] || return 1
  if process_is "$t_pid" "$t_start"; then return 1; fi
  [ "$process_was" = gone ]
}

# Whether the process $1 is still the one whose identity is $2: status 0 when
# it is; else 1, and process_was says gone (no such pid, or the pid is another
# process now) or unknown (its identity does not read while the pid lives: a
# ps or a cat that failed on a loaded host). A failed read is never "gone":
# kill -0 is a builtin, no fork.
process_is() {
  process_was=
  p_now=$(process_identity "$1")
  if [ -n "$p_now" ]; then
    [ "$p_now" = "$2" ] && return 0
    process_was=gone
    return 1
  fi
  if kill -0 "$1" 2>/dev/null; then process_was=unknown; else process_was=gone; fi
  return 1
}

# Whether a ticket is live: locked, and its owner not known to be gone. A
# ticket being written under queue.lock is never looked at outside it.
ticket_live() {
  [ -f "$1" ] || return 1
  if flock -n -x "$1" true 3>&- 6>&- 7>&- 8>&- 9>&-; then
    return 1
  fi
  ! ticket_owner_gone "$1"
}

# The parent of the process $1 (empty when it is gone): field 4 of
# /proc/<pid>/stat on Linux (after the command name), `ps -o ppid` elsewhere.
process_parent() {
  case "$1" in '' | *[!0-9]*) return 0 ;; esac
  if [ -r "$identity_proc/self/stat" ]; then
    p_stat=$(cat "$identity_proc/$1/stat" 2>/dev/null) || return 0
    printf '%s\n' "${p_stat##*) }" | awk '{ print $2 }'
  else
    ps -o ppid= -p "$1" 2>/dev/null | tr -d ' ' || true
  fi
}

# When the process $1 started, in seconds since the epoch (empty when it is
# gone or the platform cannot tell): on Linux the boot's time (btime of
# /proc/stat) plus its start in ticks (field 22 of /proc/<pid>/stat) over
# CLK_TCK, exact to the second; elsewhere now less its age, `ps -o etime`
# ([[dd-]hh:]mm:ss, digits in any locale), to the second.
process_started_at() {
  case "$1" in '' | *[!0-9]*) return 0 ;; esac
  if [ -r "$identity_proc/self/stat" ]; then
    s_stat=$(cat "$identity_proc/$1/stat" 2>/dev/null) || return 0
    s_tick=$(printf '%s\n' "${s_stat##*) }" | awk '{ print $20 }')
    s_boot=$(awk '$1 == "btime" { print $2 }' "$identity_proc/stat" 2>/dev/null)
    s_hz=$(getconf CLK_TCK 2>/dev/null || true)
    case "$s_tick:$s_boot:$s_hz" in *::* | :* | *: | *[!0-9:]*) return 0 ;; esac
    [ "$s_hz" -gt 0 ] || return 0
    printf '%s\n' $((s_boot + s_tick / s_hz))
  else
    s_age=$(LC_ALL=C ps -o etime= -p "$1" 2>/dev/null | tr -d ' ')
    case "$s_age" in '' | *[!0-9:-]*) return 0 ;; esac
    printf '%s\n' "$s_age" | awk -v now="$(date +%s)" '{
      d = 0; t = $0; i = index(t, "-")
      if (i) { d = substr(t, 1, i - 1); t = substr(t, i + 1) }
      n = split(t, p, ":"); s = 0
      for (k = 1; k <= n; k++) s = s * 60 + p[k]
      print now - (d * 86400 + s)
    }'
  fi
}

# Whether the process $1 runs a workrift's refresh, init or create: a word of
# its command line that is a workrift script (named workrift*, or a file whose
# third line is this script's own, as every workrift's has been), followed by
# one of those words. /proc/<pid>/cmdline on Linux (one argument a line), `ps
# -o args` elsewhere.
process_runs_old_holder() {
  if [ -r "$identity_proc/$1/cmdline" ]; then
    r_args=$(tr '\0' '\n' <"$identity_proc/$1/cmdline" 2>/dev/null) || return 1
  else
    r_args=$(LC_ALL=C ps -o args= -p "$1" 2>/dev/null | tr ' ' '\n') || return 1
  fi
  r_ifs=$IFS
  IFS='
'
  set -f
  r_prev=
  r_found=1
  for r_word in $r_args; do
    case "$r_word" in
      refresh | init | create)
        if [ -n "$r_prev" ]; then
          case "${r_prev##*/}" in
            workrift*) r_found=0 ;;
            *) [ "$(sed -n 3p "$r_prev" 2>/dev/null)" != '# Branch workspaces on top of Rift.' ] || r_found=0 ;;
          esac
        fi
        ;;
    esac
    r_prev=$r_word
  done
  set +f
  IFS=$r_ifs
  return "$r_found"
}

# Whether the process $1 has the file $2 open (by inode, any descriptor):
# /proc/<pid>/fd on Linux, lsof elsewhere. Unknown counts as no.
process_has_open() {
  if [ -d "$identity_proc/$1/fd" ]; then
    for o_fd in "$identity_proc/$1/fd"/*; do
      [ ! "$o_fd" -ef "$2" ] || return 0
    done
    return 1
  fi
  command -v lsof >/dev/null 2>&1 || return 1
  o_paths=$(lsof -a -p "$1" -Fn 2>/dev/null | sed -n 's/^n//p')
  o_ifs=$IFS
  IFS='
'
  set -f
  o_found=1
  for o_path in $o_paths; do
    [ ! "$o_path" -ef "$2" ] || o_found=0
  done
  set +f
  IFS=$o_ifs
  return "$o_found"
}

# Whether the ancestor $1 is the older workrift that holds the lock of the
# base whose Git directory is $2, by what that process is now, never by a pid
# in a file alone (B3, 2026-11-22: the old script removes its holder file only
# in its exit trap, so a kill -9 leaves one, five in bite's .git that day, and
# a pid reused by deps' own shell then passed for the holder). All of:
#   - a holder file names it (written right after the old lock is taken);
#   - it started no later than that file's time: a process alive when the
#     file was written with its pid is the one that wrote it, so this rules
#     out a pid reused since (exact to the second; one second of slack);
#   - it runs the old workrift's refresh, init or create;
#   - it has this base's lock file open (the base it works on, from what it
#     holds rather than its cwd or arguments, which name a workspace or rely
#     on WORKRIFT_SOURCE);
#   - the lock is held.
# Together these make it the holder now: the old script removes its holder
# file before it lets the lock go, so the writer of a file still present,
# still running, still holds it. No platform names the holding process
# itself: /proc/locks shows the pid of the flock(1) that took the lock, which
# has exited (the lock lives on on the shell's descriptor), and a waiter has
# the file open as a holder does.
old_holder_is() {
  o_file=$2/workrift-lock-holders/$1
  [ -f "$o_file" ] && [ -f "$2/workrift.lock" ] || return 1
  o_since=$(awk 'NR == 1 { print $1 }' "$o_file" 2>/dev/null)
  case "$o_since" in '' | *[!0-9]*) return 1 ;; esac
  o_start=$(process_started_at "$1")
  [ -n "$o_start" ] && [ "$o_start" -le $((o_since + 1)) ] || return 1
  process_runs_old_holder "$1" || return 1
  process_has_open "$1" "$2/workrift.lock" || return 1
  ! flock -n -s "$2/workrift.lock" true 3>&- 6>&- 7>&- 8>&- 9>&-
}

# What a process this one descends from holds of the base $1, as `<kind>
# <pid> <purpose>`: kind old (the older workrift holds the lock, and it is
# that ancestor: old_holder_is), w or r (a ticket of this script, in and
# locked, whose record names the ancestor's pid and identity as
# process_identity reads it now); nothing when no ancestor holds it. A Git
# hook (`workrift deps` from lefthook-local.yml) is a child of the Git command
# a holder runs in the base: it must never wait in line behind the holder it
# runs inside, which waits for it (B2, 2026-11-22: an older refresh's `git
# switch` fired the new deps, which waited for that refresh's lock). Whatever
# is not shown to be such a holder is not one: deps then waits in line, which
# is visible and named, where a wrong skip would leave the base uninstalled.
ancestor_hold() {
  a_git=$(git -C "$1" rev-parse --absolute-git-dir 2>/dev/null) || return 0
  state_dir "$1"
  a_pid=$$
  a_n=0
  while a_pid=$(process_parent "$a_pid") && [ -n "$a_pid" ] && [ "$a_pid" -gt 1 ] && [ "$a_n" -lt 64 ]; do
    a_n=$((a_n + 1))
    if old_holder_is "$a_pid" "$a_git"; then
      # The file reads `<since> <purpose>`.
      a_what=$(cat "$a_git/workrift-lock-holders/$a_pid" 2>/dev/null || true)
      printf 'old %s %s\n' "$a_pid" "${a_what#* }"
      return 0
    fi
    a_identity=
    for a_ticket in "$state_value"/base/*.[rw]; do
      [ -e "$a_ticket.in" ] && [ "$(sed -n 1p "$a_ticket" 2>/dev/null)" = "$a_pid" ] || continue
      [ -n "$a_identity" ] || a_identity=$(process_identity "$a_pid")
      [ -n "$a_identity" ] && [ "$(sed -n 2p "$a_ticket" 2>/dev/null)" = "$a_identity" ] || continue
      ! flock -n -x "$a_ticket" true 3>&- 6>&- 7>&- 8>&- 9>&- || continue
      printf '%s %s %s\n' "${a_ticket##*.}" "$a_pid" "$(sed -n 4p "$a_ticket")"
      return 0
    done
  done
}

# Under queue.lock: drops the queue's tickets that are not live.
queue_sweep() {
  for q_old in "$1"/*.[rw]; do
    [ -f "$q_old" ] || continue
    ticket_live "$q_old" || rm -f "$q_old" "$q_old.in"
  done
  for q_old in "$1"/*.in; do
    [ -e "$q_old" ] && [ ! -e "${q_old%.in}" ] || continue
    rm -f "$q_old"
  done
}

# Whether queue $1 (a folder) holds a live ticket.
queue_busy() {
  for q_any in "$1"/*.[rw]; do
    ! ticket_live "$q_any" || return 0
  done
  return 1
}

# The number of a ticket file.
ticket_number() {
  t_n=${1##*/}
  printf '%s\n' "${t_n%.*}"
}

# The live tickets the ticket $1 (of kind $2) waits for: every earlier one for
# a writer, every earlier writer for a reader; one a line, earliest first.
#
# Fails when the sort fails: a line that does not read is never "nothing
# ahead", which would let this ticket in beside a holder.
ticket_ahead() {
  a_mine=$(ticket_number "$1")
  a_list=
  for a_file in "${1%/*}"/*.[rw]; do
    [ -f "$a_file" ] && [ "$a_file" != "$1" ] || continue
    a_n=$(ticket_number "$a_file")
    [ "$a_n" -lt "$a_mine" ] || continue
    case "$2:$a_file" in r:*.r) continue ;; esac
    ticket_live "$a_file" || continue
    a_list="$a_list$a_n $a_file
"
  done
  [ -n "$a_list" ] || return 0
  a_sorted=$(printf '%s' "$a_list" | LC_ALL=C sort -n) && [ -n "$a_sorted" ] || return 1
  a_ifs=$IFS
  IFS='
'
  set -f
  for a_file in $a_sorted; do printf '%s\n' "${a_file#* }"; done
  set +f
  IFS=$a_ifs
}

# Words for the tickets ahead of $1 ($2: its kind): how many, and the oldest.
ticket_ahead_words() {
  w_ahead=$(ticket_ahead "$1" "$2")
  w_count=$(printf '%s' "$w_ahead" | grep -c . || true)
  w_first=$(printf '%s\n' "$w_ahead" | head -n 1)
  if [ -z "$w_first" ]; then
    printf ' nothing ahead'
    return 0
  fi
  printf ' behind %s; the first %s' "$w_count" "$(ticket_words "$w_first")"
}

# One ticket in words: `pid P (what), holding since T` or `waiting since T`.
# A ticket whose owner is stopped (SIGSTOP, a Ctrl-Z of a waiting create)
# holds everyone behind it until it runs again; no waiter skips it (it would go
# in beside a later writer once it runs), so the line names it for a person.
ticket_words() {
  if [ -e "$1.in" ]; then t_state=holding; else t_state=waiting; fi
  t_who=$(sed -n 1p "$1")
  t_stopped=
  case "$(LC_ALL=C ps -o stat= -p "$t_who" 2>/dev/null)" in
    *T*) t_stopped="; it is stopped: kill -CONT $t_who to go on, or end it" ;;
  esac
  printf 'pid %s (%s), %s since %s%s' "$t_who" "$(sed -n 4p "$1")" "$t_state" "$(clock_time "$(sed -n 3p "$1")")" "$t_stopped"
}

# What holds or waits in a base's queue $2 (base or advance), in words.
queue_words() {
  state_dir "$1"
  qw_found=
  for qw_each in "$state_value/$2"/*.[rw]; do
    ticket_live "$qw_each" || continue
    printf ' %s' "$(ticket_words "$qw_each")"
    qw_found=true
  done
  [ -n "$qw_found" ] || printf ' none'
}

# Writes a ticket's record, once, under queue.lock (a record rewritten later
# could be read empty, its owner taken for gone): owner, its start, since,
# purpose. That it holds is a file beside it, <ticket>.in, made once it is in.
ticket_record() {
  holder_start=${holder_start:-$(process_identity "$holder_pid")}
  # A record with no start would read as an owner gone: no ticket without it.
  [ -n "$holder_start" ] || fail "the identity of this process (pid $holder_pid) does not read (ps or /proc failed): no place in line taken, nothing done"
  t_since=$(date +%s) || fail "the clock does not read (date failed): no place in line taken, nothing done"
  printf '%s\n%s\n%s\n%s\n' "$holder_pid" "$holder_start" "$t_since" "$lock_purpose" >"$1" ||
    fail "the ticket $1 could not be written: no place in line taken, nothing done"
}

# queue_enter BASE QUEUE KIND FD MODE: a ticket of KIND (r or w) in the base's
# QUEUE, held on descriptor FD (6, 8 or 9), its path in queue_ticket. MODE:
#   wait    take a place in line now and wait for the tickets ahead
#   try     take it only when the queue holds no live ticket (else return 1)
#   polite  take a place once the line is empty, or after advance_every
#           seconds, whichever comes first, then wait
# While it waits, a line says whom for, at once and each minute.
queue_enter() {
  q_base=$1
  state_dir "$1"
  q_dir=$state_value/$2
  q_kind=$3
  q_fd=$4
  q_mode=$5
  # Called as a condition (set -e off in it): every command that can fail is
  # checked here, none is left to set -e.
  mkdir -p "$q_dir" || fail "mkdir -p $q_dir (the line of $q_base) failed: no place in line taken, nothing done"
  q_since=$(date +%s) || fail "the clock does not read (date failed): no place in line taken, nothing done"
  while :; do
    exec 3>"${q_dir%/*}/queue.lock"
    # A blocking flock ends only once it holds the lock, so a failure is an
    # error (no flock, a file it cannot lock): never go on without the mutex.
    flock -x 3 || fail "flock of ${q_dir%/*}/queue.lock failed"
    queue_sweep "$q_dir"
    if [ "$q_mode" = wait ] || ! queue_busy "$q_dir"; then
      break
    fi
    if [ "$q_mode" = try ]; then
      exec 3>&-
      return 1
    fi
    # A clock that does not read is the patience spent: take the place now.
    q_now=$(date +%s) || q_now=$((q_since + advance_every))
    q_left=$((q_since + advance_every - q_now))
    [ "$q_left" -gt 0 ] || break
    exec 3>&-
    # Polite: wait for what is in line now to end (or the patience to run
    # out), without a place, then look again.
    for q_in in "$q_dir"/*.[rw]; do
      [ -f "$q_in" ] || continue
      q_now=$(date +%s) || q_now=$((q_since + advance_every))
      q_left=$((q_since + advance_every - q_now))
      [ "$q_left" -gt 0 ] || break
      ticket_wait "$q_in" "$q_left"
    done
  done
  # The next number is past both the counter and every ticket present: a
  # counter deleted or garbled never numbers a ticket below a live one.
  q_n=$(cat "${q_dir%/*}/next" 2>/dev/null || true)
  case "$q_n" in '' | *[!0-9]*) q_n=0 ;; esac
  for q_any in "$q_dir"/*.[rw]; do
    [ -f "$q_any" ] || continue
    q_has=$(ticket_number "$q_any")
    case "$q_has" in '' | *[!0-9]*) continue ;; esac
    [ "$q_has" -le "$q_n" ] || q_n=$q_has
  done
  q_n=$((q_n + 1))
  # A base with no lock file of the older workrift yet gets it from a writer
  # (legacy_take), so a copy that finds none goes in as a writer, alone: once
  # per base, and the file is never made while a copy runs.
  if [ "$2" = base ] && [ "$q_kind" = r ] && [ ! -f "$(legacy_path "$q_base")" ]; then
    q_kind=w
  fi
  printf '%s\n' "$q_n" >"${q_dir%/*}/next"
  queue_ticket=$q_dir/$q_n.$q_kind
  eval "exec $q_fd>\"\$queue_ticket\""
  flock -x "$q_fd" || fail "flock of $queue_ticket failed"
  ticket_record "$queue_ticket"
  exec 3>&-
  q_ahead=$(ticket_ahead "$queue_ticket" "$q_kind") ||
    fail "the line of $q_base ($q_dir) does not read (sort failed): no place in line kept, nothing done"
  if [ -n "$q_ahead" ]; then
    q_what='the lock'
    [ "$2" != clone ] || q_what='the clone turn'
    printf 'workrift: waiting for %s of %s:%s\n' "$q_what" "$q_base" "$(ticket_ahead_words "$queue_ticket" "$q_kind")" >&2
    q_mine=$queue_ticket
    (
      while sleep 60 >/dev/null 2>&1; do
        [ -n "$(process_identity "$holder_pid")" ] || exit 0
        printf 'workrift: still waiting for %s of %s:%s; in line since %s\n' \
          "$q_what" "$q_base" "$(ticket_ahead_words "$q_mine" "$q_kind")" "$(clock_time "$q_since")" >&2
      done
    ) 3>&- 6>&- 7>&- 8>&- 9>&- &
    q_talker=$!
    # queue_patience (seconds; unset: no end) bounds the wait: past it the
    # ticket is given back and queue_enter returns 1 (workrift subvolume).
    q_until=
    if [ -n "${queue_patience:-}" ]; then
      q_now=$(date +%s) || { queue_leave "$q_fd" "$queue_ticket"; fail "the clock does not read (date failed) in line for $q_base: no place in line kept, nothing done"; }
      q_until=$((q_now + queue_patience))
    fi
    printf '%s\n' "$q_ahead" | while IFS= read -r q_in; do
      q_rest=
      if [ -n "$q_until" ]; then
        # A clock that does not read is the bound passed (the line is looked
        # at again after), never an arithmetic error.
        q_now=$(date +%s) || q_now=$q_until
        q_rest=$((q_until - q_now))
        [ "$q_rest" -gt 0 ] || q_rest=1
      fi
      ticket_wait "$q_in" "$q_rest"
    done
    # KILL, which no inherited ignore stops (the talker holds nothing), then
    # reaped here, quietly: bash (macOS's sh) otherwise reports the killed
    # job, its whole source, on stderr.
    kill -KILL "$q_talker" 2>/dev/null || true
    wait "$q_talker" 2>/dev/null || true
    if [ -n "$q_until" ]; then
      q_ahead=$(ticket_ahead "$queue_ticket" "$q_kind") ||
        fail "the line of $q_base ($q_dir) does not read (sort failed): no place in line kept, nothing done"
      if [ -n "$q_ahead" ]; then
        queue_leave "$q_fd" "$queue_ticket"
        return 1
      fi
    fi
  fi
  # A ticket whose file went while it waited (its queue folder removed) is no
  # place in line any more: those who came after could not see it. Fail closed.
  [ -f "$queue_ticket" ] || fail "the ticket $queue_ticket was removed while it waited: the line of $q_base cannot be trusted; nothing done"
  if [ "$2" = base ]; then
    legacy_take "$q_base" "$q_kind" "$q_mode" || {
      queue_leave "$q_fd" "$queue_ticket"
      return 1
    }
  fi
  printf '' >"$queue_ticket.in" || {
    queue_leave "$q_fd" "$queue_ticket"
    fail "$queue_ticket.in could not be written (the mark that this ticket holds): no place in line kept, nothing done"
  }
}

# The lock the workrift before these tickets took (dotfiles a5821de8 and
# earlier, until 2026-11-22): an flock held exclusively on <base>/.git/
# workrift.lock for a whole create, its base advance and install included,
# with holder files written under .git/workrift-lock-holders/ while it holds.
# A script that is installed replaces the file, so creates already running on
# the old one (queued for hours, 2026-11-22) go on beside new ones on the same
# base. So every base ticket also takes that flock once in: shared for a
# reader, exclusive for a writer, ticket first and then this lock, always in
# that order (an old workrift holds no ticket, so no wait goes round in a
# cycle). An old create and a new copy then never run together, nor an old
# base move beside a new copy, nor a new move beside an old create, while new
# copies still run beside each other.
#
# The file is never emptied or removed. A reader opens it read-only. A writer
# opens it to append (writing nothing), which makes it where it is missing:
# an old create started before the install makes it only at its own lock,
# after its fetch, so a base with none could have an old create move it
# beside a new copy that took no lock on it (F1, 2026-11-22). A copy that
# finds no file therefore goes in as a writer (queue_enter): the file is made
# under the exclusive ticket, when no copy of this script runs and no old
# workrift holds it (an old holder has made it), before any copy relies on it.
#
# Every hold of this script so takes this flock beside its ticket: a second
# sign of a holder, independent of the queue's files. A holder whose ticket
# file is gone (its queue folder removed by hand) still holds it, and the next
# one in waits here for it.
#
# An old waiter loops on `flock -w 60`, and Linux grants a shared flock beside
# a waiting exclusive one, so a stream of new copies could hold it off without
# end. A reader therefore lets an old waiter go first: while /proc/locks shows
# an exclusive flock blocked on this file's inode, it waits. Nothing new waits
# exclusively on that file while a reader is in (a writer's ticket excludes it),
# so such a waiter is an old workrift; an inode that matches another device's
# file only delays. An old waiter so waits at most for the new copies already
# in. macOS has no list of blocked flocks: there old waiters take their chance
# (no host runs workrift there). New ones wait behind old ones no longer than
# the old ones last: no old workrift starts after an install.
#
# Delete this (legacy_take, legacy_yield and the descriptor 7 closes) once every
# host runs this script and no older workrift runs: after 2026-12-06 (two weeks
# of daily installs), on the check `pgrep -f workrift` naming no process older
# than the install. Follow-up in the unit create-fair.
legacy_path() {
  l_git=$(git -C "$1" rev-parse --absolute-git-dir 2>/dev/null) && [ -n "$l_git" ] || return 1
  printf '%s/workrift.lock\n' "$l_git"
}

legacy_take() {
  # No Git directory, no older workrift's lock; a Git that fails where there
  # is one is never "none" (the older workrift would run beside this one).
  if ! legacy_file=$(legacy_path "$1"); then
    [ -e "$1/.git" ] || return 0
    fail "git rev-parse --absolute-git-dir failed in $1: the older workrift's lock cannot be taken; nothing done"
  fi
  if [ "$2" = w ]; then
    exec 7>>"$legacy_file"
  else
    # Made by the writer before it (queue_enter); gone only if a person
    # removed it, and then there is nothing to take.
    [ -f "$legacy_file" ] || return 0
    exec 7<"$legacy_file"
  fi
  case "$2:$3" in
    w:try)
      flock -n -x 7 3>&- 6>&- 8>&- 9>&- || {
        exec 7<&-
        return 1
      }
      return 0
      ;;
    r:*)
      legacy_yield "$1" "$legacy_file"
      l_mode=-s
      ;;
    *) l_mode=-x ;;
  esac
  if ! flock -n "$l_mode" 7 3>&- 6>&- 8>&- 9>&-; then
    printf 'workrift: waiting for %s of %s: an older workrift holds it, or a workrift whose ticket went\n' "$legacy_file" "$1" >&2
    flock "$l_mode" 7 3>&- 6>&- 8>&- 9>&- || fail "flock of $legacy_file failed"
  fi
}

# Waits while an exclusive flock is blocked on the file $2 (see legacy_take).
legacy_yield() {
  [ -r "$proc_root/locks" ] || return 0
  y_ino=$(ls -di "$2" | awk '{ print $1 }')
  y_said=
  while awk -v ino="$y_ino" '
      $2 == "->" && $3 == "FLOCK" && $5 == "WRITE" { n = split($7, p, ":"); if (p[n] == ino) found = 1 }
      END { exit !found }' "$proc_root/locks"; do
    if [ -z "$y_said" ]; then
      printf 'workrift: an older workrift waits for the lock of %s: it goes first\n' "$1" >&2
      y_said=true
    fi
    sleep 1
  done
}

# Waits until the ticket $1 has ended: its lock free (a blocking flock that
# takes nothing of anyone's) or its owner gone, at most $2 seconds when set.
# The descriptors of this process's own tickets stay out of the flock child:
# were this process killed while it waits, the child would keep them.
ticket_wait() {
  w_until=
  if [ -n "$2" ]; then
    w_now=$(date +%s) || return 0
    w_until=$((w_now + $2))
  fi
  while [ -f "$1" ]; do
    # Each look waits 5 s at most, and no longer than the bound left.
    w_step=5
    if [ -n "$w_until" ]; then
      # A clock that does not read ends the wait (the caller looks at the
      # line again), never an arithmetic error that stops the shell.
      w_now=$(date +%s) || return 0
      w_step=$((w_until - w_now))
      [ "$w_step" -le 5 ] || w_step=5
      [ "$w_step" -ge 1 ] || w_step=1
    fi
    ! flock -w "$w_step" -s "$1" true 3>&- 6>&- 7>&- 8>&- 9>&- || return 0
    ! ticket_owner_gone "$1" || return 0
    [ -z "$w_until" ] || [ "$(date +%s)" -lt "$w_until" ] || return 0
  done
}

# Gives a ticket back: its descriptor closed, then its file removed.
queue_leave() {
  eval "exec $1>&-"
  # Its lock is closed, so a file left is a dead ticket every reader skips and
  # the next sweep removes: said, never a stop after the work is done.
  rm -f "$2" "$2.in" ||
    printf 'workrift: the ticket %s stays (rm failed); its lock is free, so the line takes it for ended\n' "$2" >&2
}

# Removes this process's tickets at exit (their locks end with it anyway).
tickets_at_exit() {
  t_rc=$?
  # A command that failed under set -e ends the script with no word of why: say
  # where it stopped, so a failure seen once (a busy host) can be read after.
  # (workrift subvolume only: sv_at is its step, set once its arguments read.)
  # It says the three facts of every other stop too (sv_facts): what happened,
  # the state both trees are in, the command that goes on.
  if [ "$t_rc" -ne 0 ] && [ -z "${fail_said:-}" ] && [ -n "${sv_at:-}" ]; then
    printf 'workrift: subvolume stopped with status %s and no message (a command failed under set -e) at the step %s\n' "$t_rc" "$sv_at" >&2
    sv_facts >&2 || true
  fi
  for t_mine in "${base_ticket:-}" "${advance_ticket:-}" "${hold_ticket:-}" "${clone_ticket:-}" "${move_ticket:-}"; do
    [ -z "$t_mine" ] || rm -f "$t_mine" "$t_mine.in"
  done
}

# The base's lock: shared ($2 = shared) or exclusive (the default), on
# descriptor 9. Release with unlock_source, or at exit.
lock_source() {
  if [ "${2:-exclusive}" = shared ]; then l_kind=r; else l_kind=w; fi
  queue_enter "$1" base "$l_kind" 9 "${3:-wait}" || return 1
  base_ticket=$queue_ticket
}

unlock_source() {
  # The older workrift's lock (legacy_take) first, then the ticket.
  exec 7<&-
  queue_leave 9 "$base_ticket"
  base_ticket=
}

# The base's advance lock, on descriptor 6: tried once ($2 = try; fails when
# another advance runs) or waited for.
lock_advance() {
  if [ "${2:-}" = try ]; then
    queue_enter "$1" advance w 6 try || return 1
  else
    queue_enter "$1" advance w 6 wait
  fi
  advance_ticket=$queue_ticket
}

unlock_advance() {
  queue_leave 6 "$advance_ticket"
  advance_ticket=
}

# The clone turn: a third queue, clone/, beside base/ and advance/. On a base
# whose workspaces are file copies, a create's clone (`work new`) and a
# remove's delete (`work rm`, and its purge) each take it, exclusively, so one
# of them runs at a time per base, in arrival order across both kinds. On the
# workbox's btrfs (2026-11-22, load 40-70, ~400k files a Bite tree) one reflink
# copy of the base took 0-1 s alone and four started together 1,262-1,287 s
# each; a copy beside one removal's rm -rf stalled 12-17 min and the removal
# took 16-21 min instead of 23 s to 3 min: they contend on the file system's
# tree locks, so side by side is slower than one after another. Agents could
# not keep to one at a time by convention. Everything else of a create (its
# fetch, install and warm) and of a remove (its checks) stays concurrent.
#
# A create takes it while it holds the base's shared ticket, never the other
# way round, and a holder of the turn waits for nothing of the base: so no
# wait goes round in a cycle (an advance waiting for that shared ticket waits
# for the turns ahead of it in line, which end). A dead holder or waiter ends
# its ticket as any other (the kernel drops its flock).
#
# A base whose workspaces are btrfs snapshots takes no turn: each is one
# snapshot made and one subvolume deleted, side by side. That is a base that
# is the root of a btrfs subvolume (inode 256 on btrfs) and whose work tries
# its btrfs cloner first (`work --json doctor`'s cloners): work falls through
# to a file copy only when the base is no subvolume (Ergo's btrfs.ergo). In
# doubt (doctor fails or answers otherwise), it takes the turn: slower, never
# worse.
#
# A workrift from before the turn (dotfiles 83b97f9e and earlier) takes none:
# its clones and deletes run beside this one's, as they did beside each other,
# until no such process runs. It never reads clone/ (its sweep and its waits
# name base/ and advance/ only), and the shared counter `next` stays monotonic
# under queue.lock for both.
base_snapshots() {
  [ "$(stat -f -c %T "$1" 2>/dev/null)" = btrfs ] && [ "$(stat -c %i "$1" 2>/dev/null)" = 256 ] || return 1
  work_in "$1" --json doctor 2>/dev/null 3>&- 6>&- 7>&- 8>&- 9>&- |
    jq -e '(.cloners // [])[0] == "btrfs"' >/dev/null 2>&1
}

# The clone turn of the base $1 for the purpose $2 (`clone NAME (create
# BRANCH)`, `delete NAME (remove PATH)`: the line of whoever waits names it),
# on descriptor 8; none on a snapshot base. clone_waited says whether anyone
# was ahead.
lock_clone() {
  clone_waited=false
  ! base_snapshots "$1" || return 0
  c_purpose=$lock_purpose
  lock_purpose=$2
  queue_enter "$1" clone w 8 wait
  lock_purpose=$c_purpose
  clone_ticket=$queue_ticket
  [ -z "$q_ahead" ] || clone_waited=true
}

unlock_clone() {
  [ -n "${clone_ticket:-}" ] || return 0
  queue_leave 8 "$clone_ticket"
  clone_ticket=
}

# Written under the exclusive lock before the base moves (fast-forward,
# install), removed once it has: a copy never reads a base with it.
moving_file() {
  state_dir "$1"
  printf '%s/moving\n' "$state_value"
}

# Seconds since the epoch as a UTC time of day, on Linux and macOS.
clock_time() {
  date -u -d "@$1" +%H:%M:%SZ 2>/dev/null || date -u -r "$1" +%H:%M:%SZ
}

# One line per step of a create or an advance, with the seconds since it
# began; none from a command that names no phase_label (refresh).
phase() {
  [ -n "${phase_label:-}" ] || return 0
  printf 'workrift: %s: %s (%ss)\n' "$phase_label" "$1" "$(($(date +%s) - create_started))" >&2
}

# A create starts an advance of the base (fetch, fast-forward, install, hooks)
# at most once in this many seconds. With a score of agents landing, main moves
# every few minutes. A lane never starts behind: its branch starts at origin's
# default branch as fetched into the workspace; only the copied build output is
# for an older tree, and the workspace's own install and warm step bring it up
# to date. WORKRIFT_ADVANCE_EVERY overrides it, for tests only. It is also how
# long the background advance defers to copies before it takes its place in
# line (queue_enter's polite mode).
advance_every=${WORKRIFT_ADVANCE_EVERY:-600}

# When an advance last moved the base, in seconds since the epoch; written only
# once one succeeded, so a failed one holds no window.
advanced_stamp_file() {
  state_dir "$1"
  printf '%s/advanced-at\n' "$state_value"
}

# The tree whose warm step last failed in the base: it is not tried again for
# that tree; a new tree or a refresh tries again.
warm_failed_file() {
  state_dir "$1"
  printf '%s/warm-failed\n' "$state_value"
}

# How far the base's build output lags its tree: `<moves> <warmed at>`, the
# moves since the base's last warm and when that warm ended (0: never, or
# before this record). An advance moves the base without warming it (warming
# under the exclusive lock would keep every copy out for minutes; 628 s on the
# workbox, 2026-11-20), so the base's output ages until a refresh warms it.
staleness_file() {
  state_dir "$1"
  printf '%s/staleness\n' "$state_value"
}

# Reads staleness_file into stale_moves and stale_since.
read_staleness() {
  s_file=$(staleness_file "$1")
  stale_moves=0
  stale_since=0
  [ ! -f "$s_file" ] || read -r stale_moves stale_since <"$s_file" || true
  case "${stale_moves:-}" in '' | *[!0-9]*) stale_moves=0 ;; esac
  case "${stale_since:-}" in '' | *[!0-9]*) stale_since=0 ;; esac
}

# A health check's threshold: the base's output is old past this many moves or
# seconds since its warm.
stale_moves_max=12
stale_seconds_max=86400

# Whether an advance warms the base too, under the exclusive lock (git config
# workrift.advanceWarm true): copies then wait for the warm, and their
# workspaces build nothing that was on main at the advance. Off by default.
advance_warms() {
  [ "$(git -C "$1" config --get --type=bool workrift.advanceWarm 2>/dev/null || true)" = true ]
}

# Whether the base's managed lefthook-local.yml is missing or out of date.
hooks_stale() {
  [ -f "$1/lefthook.yml" ] || return 1
  [ -e "$1/lefthook-local.yml" ] || return 0
  grep -qxF "$dependency_hook_marker" "$1/lefthook-local.yml" || return 1
  [ "$(cat "$1/lefthook-local.yml")" != "$(managed_hook_config)" ]
}

# The workspace shares every unchanged block with the source, so a source behind
# the default branch makes the workspace's start rewrite each file changed since,
# and those files stop being shared: the base is brought up to date, but only
# what it lacks, by an advance (run_advance) after the copy, never in front of
# it. Under the shared lock, a create reads, by reads alone, what the base lacks
# into advance_due (its HEAD is not origin's default branch $3, as ls-remote
# answered, and no advance within advance_every), want_hooks (the managed hooks
# missing or old) and, where advances warm, want_warm; it says when the base
# is behind inside the window, and how old its build output is.
base_wants() {
  advance_due=false
  want_hooks=false
  want_warm=false
  if [ -n "$3" ] && [ "$(git -C "$1" rev-parse HEAD)" != "$3" ]; then
    last=$(cat "$(advanced_stamp_file "$1")" 2>/dev/null || true)
    case "$last" in '' | *[!0-9]*) last=0 ;; esac
    since=$(($(date +%s) - last))
    if [ "$since" -ge "$advance_every" ]; then
      advance_due=true
    else
      printf 'workrift: %s is behind origin/%s; an advance moved it %ss ago, the next comes after %ss: this workspace starts at origin/%s and builds what differs itself\n' \
        "$1" "$2" "$since" "$advance_every" "$2" >&2
    fi
  fi
  ! hooks_stale "$1" || want_hooks=true
  read_staleness "$1"
  if [ "$stale_moves" -gt 0 ]; then
    if [ "$stale_since" -gt 0 ]; then
      s_when="its last warm ended $(age_words $(($(date +%s) - stale_since))) ago"
    else
      s_when='no warm recorded'
    fi
    phase "base: moved $stale_moves times since its build output was made ($s_when); this workspace builds what differs (workrift refresh warms the base)"
  fi
  if advance_warms "$1" && [ -n "$(warm_command "$1")" ] && [ "${WORKRIFT_WARM:-1}" != 0 ]; then
    tree=$(git -C "$1" rev-parse 'HEAD^{tree}')
    if [ "$(cat "$(warmed_tree_file "$1")" 2>/dev/null || true)" != "$tree" ]; then
      if [ "$(cat "$(warm_failed_file "$1")" 2>/dev/null || true)" = "$tree" ]; then
        printf "workrift: the warm step failed in %s for its tree %s and is not tried again until main moves or a refresh; this workspace builds itself; log: %s\n" \
          "$1" "$tree" "$(git_path "$1" workrift-warm.log)" >&2
      else
        want_warm=true
      fi
    fi
  fi
}

# After the copy, with no base lock held: an advance of the base in the
# background (`workrift advance`, its output in the state folder's
# advance.log) when the base lacks anything, unless one already runs. The
# create does not wait for it; a create that starts once it has ended copies
# what it made. Out of the caller's session where setsid is (Linux), so an
# interrupt of the create does not cut the base's move.
start_advance() {
  [ "$advance_due" = true ] || [ "$want_hooks" = true ] || [ "$want_warm" = true ] || return 0
  state_dir "$1"
  if queue_busy "$state_value/advance"; then
    printf 'workrift: an advance of %s is under way:%s; this workspace builds what differs itself\n' "$1" "$(queue_words "$1" advance)" >&2
    return 0
  fi
  a_log=$state_value/advance.log
  a_launch=
  if command -v setsid >/dev/null 2>&1; then a_launch=setsid; fi
  # shellcheck disable=SC2086 # no launcher, or setsid
  WORKRIFT_SOURCE=$1 $a_launch "$0" advance </dev/null >>"$a_log" 2>&1 3>&- 6>&- 7>&- 8>&- 9>&- &
  phase "base: advance in the background (pid $!, log $a_log)"
}

# `workrift advance`: bring the base to origin's default branch (when due), and
# its install and managed hooks up to date; where advances warm, its warm step
# too. One at a time (the advance lock, tried once: another advance running is
# this one's work). All of it runs under the exclusive lock, taken politely
# (once no copy is in line, or after advance_every), with the moving marker,
# and the Git hooks it fires defer. A kill anywhere leaves every lock free
# (the kernel drops them) and the base either moving (the next create repairs
# it before any copy) or with no warm marker (a refresh warms it).
run_advance() {
  source_path=$(resolve_source)
  require_source "$source_path"
  main=$(main_branch "$source_path")
  phase_label="advance $source_path"
  create_started=$(date +%s)
  lock_purpose=advance
  if ! lock_advance "$source_path" try; then
    phase 'another advance runs: nothing to do'
    return 0
  fi
  phase "started by pid $holder_pid"
  WORKRIFT_CREATING=1
  export WORKRIFT_CREATING
  phase "lock $source_path"
  lock_source "$source_path" exclusive polite
  phase 'locked'
  phase "base: fetch $main from origin"
  base_git "$source_path" fetch --no-tags origin "+refs/heads/$main:refs/remotes/origin/$main" >&2
  base_wants "$source_path" "$main" "$(git -C "$source_path" rev-parse "origin/$main")"
  moved=false
  base_move "$source_path" "$main"
  warm_ok=true
  if advance_warms "$source_path"; then
    base_warm "$source_path"
  fi
  unlock_source
  unset WORKRIFT_CREATING
  if [ "$moved" = true ] && [ "$warm_ok" = true ]; then
    date +%s >"$(advanced_stamp_file "$source_path")"
  fi
  phase 'done'
  unlock_advance
}

# The base's move, under its exclusive lock: the fast-forward when due, the
# install for the lock file it ends with, and the managed hooks.
base_move() {
  [ -z "$(git -C "$1" status --porcelain)" ] || fail "source has changes: $1"
  : >"$(moving_file "$1")"
  if [ "$advance_due" = true ]; then
    if [ "$(git -C "$1" branch --show-current)" != "$2" ]; then
      base_git "$1" switch "$2" >&2
    fi
    phase "base: fast-forward to origin/$2"
    base_git "$1" merge --ff-only "origin/$2" >&2
    phase 'base: install if its lock file changed'
    sync_dependencies "$1" >&2
    moved=true
    read_staleness "$1"
    printf '%s %s\n' $((stale_moves + 1)) "$stale_since" >"$(staleness_file "$1")"
  fi
  if hooks_stale "$1"; then
    phase 'base: managed hooks'
    install_dependency_hooks "$1" >&2
  fi
  rm -f "$(moving_file "$1")"
}

# The base's warm step, under its exclusive lock, unless the last one built
# HEAD's tree or failed for it. Sets warm_ok.
base_warm() {
  warm_ok=true
  [ -n "$(warm_command "$1")" ] && [ "${WORKRIFT_WARM:-1}" != 0 ] || return 0
  tree=$(git -C "$1" rev-parse 'HEAD^{tree}')
  [ "$(cat "$(warmed_tree_file "$1")" 2>/dev/null || true)" != "$tree" ] || return 0
  failed_file=$(warm_failed_file "$1")
  if [ "$(cat "$failed_file" 2>/dev/null || true)" = "$tree" ]; then
    warm_ok=false
    return 0
  fi
  phase 'base: warm step'
  warm_build "$1" "$1" >&2
  if [ "$(cat "$(warmed_tree_file "$1")" 2>/dev/null || true)" = "$tree" ]; then
    rm -f "$failed_file"
    printf '0 %s\n' "$(date +%s)" >"$(staleness_file "$1")"
  else
    printf '%s\n' "$tree" >"$failed_file"
    warm_ok=false
  fi
}

# A move a kill cut short (the moving marker): under the advance lock and the
# exclusive lock, the install again for the lock file the base has. A base
# with changes (a fast-forward cut in the middle of writing files) is refused
# for a person to look at: no copy is made of it.
repair_base() {
  lock_advance "$1"
  lock_source "$1"
  if [ -e "$(moving_file "$1")" ]; then
    r_dirty=$(git -C "$1" status --porcelain)
    [ -z "$r_dirty" ] ||
      fail "$1 was left in the middle of a move (a fast-forward cut short?) with changes: $(printf '%s' "$r_dirty" | head -n 3 | tr '\n' ' '); nothing copied; look at it, then run workrift refresh"
    sync_dependencies "$1" >&2
    rm -f "$(moving_file "$1")"
  fi
  unlock_source
  unlock_advance
}

# `workrift refresh`: the base to origin's default branch, installed, its
# hooks managed and its warm step built, all under the exclusive lock (copies
# wait for it, in line).
refresh_source() {
  source_path=${1:-$(resolve_source)}
  require_source "$source_path"
  lock_purpose=refresh
  lock_advance "$source_path"
  main=$(main_branch "$source_path")
  # The hooks the switch and the fast-forward fire defer: refresh installs and
  # warms itself.
  WORKRIFT_CREATING=1
  export WORKRIFT_CREATING
  lock_source "$source_path"
  base_git "$source_path" fetch --prune origin
  [ -z "$(git -C "$source_path" status --porcelain)" ] || fail "source has changes: $source_path"
  : >"$(moving_file "$source_path")"
  base_git "$source_path" switch "$main"
  base_git "$source_path" merge --ff-only "origin/$main"
  install_dependencies "$source_path"
  install_dependency_hooks "$source_path"
  rm -f "$(moving_file "$source_path")"
  warm=$(warm_command "$source_path")
  if [ -n "$warm" ]; then
    : >"$(warmed_tree_file "$source_path")"
    run_warm "$source_path" "$warm"
    git -C "$source_path" rev-parse 'HEAD^{tree}' >"$(warmed_tree_file "$source_path")"
    rm -f "$(warm_failed_file "$source_path")"
    printf '0 %s\n' "$(date +%s)" >"$(staleness_file "$source_path")"
  else
    note_cold "$source_path"
  fi
  unlock_source
  unset WORKRIFT_CREATING
  unlock_advance
  trust_note "$source_path"
  printf 'Warm source is ready at %s.\n' "$source_path"
}

# `workrift hold [--shared] -- COMMAND...`: COMMAND run in the base with its
# lock held, exclusive unless --shared, in line like any create or advance:
# work on the base by hand (a gc, a repair) that no copy may read half done.
hold_source() {
  h_mode=exclusive
  if [ "${1:-}" = --shared ]; then
    h_mode=shared
    shift
  fi
  [ "${1:-}" = -- ] || { usage >&2; exit 2; }
  shift
  [ "$#" -gt 0 ] || { usage >&2; exit 2; }
  source_path=$(resolve_source)
  require_source "$source_path"
  lock_purpose="hold $*"
  lock_source "$source_path" "$h_mode"
  h_status=0
  (cd "$source_path" && "$@") 3>&- 6>&- 7>&- 8>&- 9>&- || h_status=$?
  unlock_source
  return "$h_status"
}

remove_workspace() {
  with_children=false
  remove_dry_run=false
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --with-children) with_children=true ;;
      --dry-run) remove_dry_run=true ;;
      -*) usage >&2; exit 2 ;;
      *) break ;;
    esac
    shift
  done
  [ "$#" -le 1 ] || { usage >&2; exit 2; }
  target=${1:-$PWD}
  # A path is absolute or starts with . or ..; anything else is the
  # branch create was given (scratch/x), never a path inside the current
  # checkout, which Git would take for that checkout.
  case "$target" in
    /*) ;;
    . | .. | ./* | ../*) target=$PWD/$target ;;
    *) target=$(workspace_by_name "$target") ;;
  esac
  work_remove "$target" "$with_children" "$remove_dry_run"
}

# The first process whose working folder is $1 or inside it, as `PID COMMAND`;
# fails when there is none.
process_in() {
  for process_cwd in "$proc_root"/[0-9]*/cwd; do
    cwd=$(readlink "$process_cwd" 2>/dev/null || true)
    case "$cwd/" in
      "$1/"*)
        process_pid=${process_cwd%/cwd}
        process_pid=${process_pid##*/}
        printf '%s %s\n' "$process_pid" "$(cat "$proc_root/$process_pid/comm" 2>/dev/null || printf '?')"
        return 0
        ;;
    esac
  done
  return 1
}

is_active() {
  process_in "$1" >/dev/null
}

is_recent() {
  find "$1" -xdev \( -name node_modules -o -name .turbo -o -name .trash \) -prune \
    -o -mmin "-$prune_idle_minutes" -print -quit 2>/dev/null | grep -q .
}

is_pinned() {
  test -f "$keep_file" && grep -qxF "$1" "$keep_file"
}

# Remove workspaces that nobody has touched for two days (work_prune).
prune_workspaces() {
  dry_run=false
  if [ "${1:-}" = "--dry-run" ]; then
    dry_run=true
  elif [ "$#" -ne 0 ]; then
    usage >&2
    exit 2
  fi

  work_dir=$(mktemp -d)
  trap 'rm -rf "$work_dir"' EXIT

  work_prune "$dry_run"
}

check_source() {
  source_path=$(resolve_source)
  require_source "$source_path"
  test -w "$source_path"
  main_branch "$source_path" >/dev/null
  # A base on btrfs that is a plain folder: work copies it file by file.
  if [ "$(stat -f -c %T "$source_path" 2>/dev/null)" = btrfs ] && [ "$(stat -c %i "$source_path" 2>/dev/null)" != 256 ]; then
    printf 'workrift: warning: %s is a plain folder on btrfs, not a subvolume: each workspace is a file-by-file copy; workrift subvolume converts it (a dry run unless --apply)\n' "$source_path" >&2
  fi
  # An advance moves the base without warming it: its build output ages until
  # a refresh, and each new workspace builds more of what differs.
  if [ -n "$(warm_command "$source_path")" ]; then
    read_staleness "$source_path"
    c_age=0
    [ "$stale_since" -eq 0 ] || c_age=$(($(date +%s) - stale_since))
    if [ "$stale_moves" -ge "$stale_moves_max" ] || [ "$c_age" -ge "$stale_seconds_max" ]; then
      printf 'workrift: warning: the build output of %s is %s moves behind its tree (%s); its workspaces each build what differs: run workrift refresh at a quiet time\n' \
        "$source_path" "$stale_moves" "$([ "$stale_since" -gt 0 ] && printf 'warmed %s ago' "$(age_words "$c_age")" || printf 'no warm recorded')" >&2
    fi
  fi
  printf 'Warm source checks passed: %s\n' "$source_path"
}

# The work backend. Every call names its base with WORK_BASE and runs in it:
# inside an adopted Rift copy, work would otherwise take the copy for the base.
# Variables here start with w_, since sh functions share one scope.

work_in() {
  w_in_base=$1
  shift
  (cd "$w_in_base" && WORK_BASE=$w_in_base "$work_bin" "$@")
}

# The bases work has registered whose folder is still there: a base deleted
# without `work` (a test's scratch base) stays in its list, and is no base.
work_bases() {
  w_json=$("$work_bin" --json bases) || fail "work --json bases failed (exit $?): ${w_json:-no output}"
  printf '%s' "$w_json" | jq -e 'type == "array" and all(.[]; type == "string")' >/dev/null 2>&1 ||
    fail "work --json bases answered no list of paths: $(printf '%s' "${w_json:-no output}" | head -c 200)"
  printf '%s' "$w_json" | jq -r '.[]' | while IFS= read -r w_listed; do
    if [ -d "$w_listed" ]; then
      printf '%s\n' "$w_listed"
    fi
  done
}

# The base's active workspaces, one a line: name, id, path, parent, since.
# A base whose folder went away (even while this runs) has none; any other
# failure of work list fails.
work_workspaces() {
  [ -d "$1" ] || return 0
  if ! w_json=$(work_in "$1" --json list); then
    [ -d "$1" ] || return 0
    fail "work list failed in $1: $w_json"
  fi
  printf '%s' "$w_json" |
    jq -r '.[] | select(.state._tag == "Active") | [.name, .id, .path, .parent, (.since | tostring)] | @tsv'
}

# A [deps] table in the base's work.toml: work installs in each workspace.
work_installs() {
  [ -f "$1/work.toml" ] && grep -q '^\[deps\]' "$1/work.toml"
}

# The base whose registry holds the checkout at $1, else the base with its origin.
work_resolve_source() {
  w_top=$1
  w_bases=$(work_bases)
  w_old_ifs=$IFS
  IFS='
'
  for w_base in $w_bases; do
    if [ "$w_base" = "$w_top" ]; then
      IFS=$w_old_ifs
      printf '%s\n' "$w_base"
      return
    fi
    w_rows=$(work_workspaces "$w_base")
    if printf '%s\n' "$w_rows" | cut -f3 | grep -qxF "$w_top"; then
      IFS=$w_old_ifs
      printf '%s\n' "$w_base"
      return
    fi
  done
  IFS=$w_old_ifs

  w_origin=$(normalized_origin "$w_top")
  [ -n "$w_origin" ] || fail "no origin remote in $w_top"
  w_matches=$(printf '%s\n' "$w_bases" | while IFS= read -r w_candidate; do
    if [ -n "$w_candidate" ] && [ -d "$w_candidate" ] && [ "$(normalized_origin "$w_candidate")" = "$w_origin" ]; then
      printf '%s\n' "$w_candidate"
    fi
  done)
  case "$(printf '%s' "$w_matches" | grep -c .)" in
    1) printf '%s\n' "$w_matches" ;;
    0) fail "no warm source for $w_origin; run workrift init" ;;
    *) fail "several warm sources for $w_origin; set WORKRIFT_SOURCE: $(printf '%s' "$w_matches" | tr '\n' ' ')" ;;
  esac
}

# The base's work.toml stays out of Git's view, as step C's runbook does.
work_init() {
  if ! git -C "$1" ls-files --error-unmatch work.toml >/dev/null 2>&1; then
    w_exclude=$(git -C "$1" rev-parse --path-format=absolute --git-path info/exclude)
    mkdir -p "$(dirname "$w_exclude")"
    grep -qxF work.toml "$w_exclude" 2>/dev/null || printf 'work.toml\n' >>"$w_exclude"
  fi
  (cd "$1" && "$work_bin" init >/dev/null)
}

# `work new` of a workspace for branch $3 in the base $1, named $2, or $2-N
# while a trashed workspace still holds the name; $4 is the default branch.
# Prints what work's install did (its deps tag), a tab, and the path.
# The branch continues the base's branch of that name, else origin's
# (tracking it), else starts at origin's default branch, as with Rift.
# After a `work new` that failed: a failure work reports (CloneFailed and the
# rest) leaves nothing, since work deletes the folder it made and drops its
# reservation (modules/work/work/new.ergo Fill: Leave, unreserve). A work that
# died on the way (a kill, a crash) leaves its Creating record and maybe a
# folder; that one is handed to `work gc -id`, work's own command for it, which
# deletes a clone it never marked and activates one it did (said here).
# Git's lock and temporary files under the Git directory $1, a path a line:
# its *.lock files, gc.pid, refs/**.lock, objects/maintenance.lock and
# objects/pack/tmp_*. workrift.lock and workrift-turnstile.lock are flock
# files of the line, not Git's. A copy of a live .git carries the ones a Git
# process held in it at that instant.
#
# Fails when a walk fails (a copy's locks that do not read are never "none").
git_carried_locks() {
  [ -d "$1" ] || return 0
  find "$1" -maxdepth 1 -type f \( -name '*.lock' -o -name gc.pid \) \
    ! -name workrift.lock ! -name workrift-turnstile.lock 2>/dev/null || return 1
  [ ! -d "$1/refs" ] || find "$1/refs" -type f -name '*.lock' 2>/dev/null || return 1
  [ ! -f "$1/objects/maintenance.lock" ] || printf '%s\n' "$1/objects/maintenance.lock"
  [ ! -d "$1/objects/pack" ] || find "$1/objects/pack" -maxdepth 1 -name 'tmp_*' 2>/dev/null || return 1
}

# Deletes from the new workspace $2 (never the base $1) the Git lock and
# temporary files its copy carried from the base, each named. The workspace is
# private until create prints its path, so a lock in it is no live one.
sweep_carried_locks() {
  local k_git k_file
  [ "$2" != "$1" ] || return 0
  k_git="$2/.git"
  [ -d "$k_git" ] || return 0
  git_carried_locks "$k_git" | while IFS= read -r k_file; do
    case "$k_file" in
      "$2"/.git/?*)
        printf 'workrift: removed %s from the new workspace: the copy carried it from %s, where a Git process held it\n' "$k_file" "$1" >&2
        case "$k_file" in "$2"/.git/?*) rm -rf -- "$k_file" ;; esac
        ;;
    esac
  done
}

work_new_failed() {
  f_left=$(work_in "$1" --json list 2>/dev/null |
    jq -r --arg n "$2" '.[] | select(.name == $n and .state._tag == "Creating") | .id' 2>/dev/null || true)
  [ -n "$f_left" ] || return 0
  printf 'workrift: work new left its Creating record %s (%s); work gc -id collects it\n' "$2" "$f_left" >&2
  work_in "$1" gc -id "$f_left" >&2 || printf 'workrift: work gc -id %s failed; the record stays for work gc\n' "$f_left" >&2
  f_now=$(work_in "$1" --json list 2>/dev/null |
    jq -r --arg i "$f_left" '.[] | select(.id == $i) | "\(.state._tag) \(.path)"' 2>/dev/null || true)
  if [ -n "$f_now" ]; then
    printf 'workrift: after work gc, the record of %s is %s\n' "$2" "$f_now" >&2
  fi
}

work_new() {
  w_source=$1
  w_name=$2
  w_branch=$3
  w_json=$(work_in "$w_source" --json list) || fail "work list failed in $w_source: $w_json"
  w_free=$w_name
  w_n=2
  while w_state=$(printf '%s' "$w_json" | jq -r --arg n "$w_free" '.[] | select(.name == $n) | .state._tag') && [ -n "$w_state" ]; do
    case "$w_state" in
      *Active*) fail "workspace already exists: $(printf '%s' "$w_json" | jq -r --arg n "$w_free" '.[] | select(.name == $n and .state._tag == "Active") | .path')" ;;
    esac
    w_free=$w_name-$w_n
    w_n=$((w_n + 1))
  done

  # A branch the base has is checked out as it is; any other starts at the
  # base's HEAD, so the copy's checkout writes nothing, and workspace_start
  # moves it to where it starts once the base's lock is free.
  w_had=false
  if git -C "$w_source" show-ref --verify --quiet "refs/heads/$w_branch"; then
    w_from=
    w_had=true
  else
    w_from=$(git -C "$w_source" rev-parse HEAD)
  fi
  # An install or hook work runs must not inherit the source lock.
  if ! w_made=$(work_in "$w_source" --json new -branch "$w_branch" ${w_from:+-from "$w_from"} "$w_free" 3>&- 6>&- 7>&- 8>&- 9>&-); then
    work_new_failed "$w_source" "$w_free"
    fail "work new failed for $w_branch in $w_source: $w_made (when Git names an index.lock: a Git process held it in the base the instant the workspace was copied; run the create again)"
  fi
  w_path=$(printf '%s' "$w_made" | jq -r '.path')
  [ -n "$w_path" ] && [ -d "$w_path/.git" ] || fail "work new made no workspace for $w_branch: $w_made"
  sweep_carried_locks "$w_source" "$w_path"
  # Untrusted is said once by create's trust_note.
  printf '%s' "$w_made" | jq -r '[.deps._tag, .hooks._tag] | map(select(test("Fail"))) | .[] | "workrift: work new: \(.)"' >&2

  # work gives the clone's origin a push URL that refuses every push; a branch
  # made here is pushed for review, as one made in a Rift is.
  if [ "$(git -C "$w_path" config --get remote.origin.pushurl || true)" = no-push:workspaces-never-push-origin ]; then
    git -C "$w_path" config --unset remote.origin.pushurl
  fi
  printf '%s\t%s\t%s\n' "$(printf '%s' "$w_made" | jq -r '.deps._tag')" "$w_had" "$w_path"
}

# The commits of the checkout $1 found nowhere else, newest first, one hash a
# line: reachable from HEAD or a branch, from no remote-tracking ref and from
# none of the tips $2 (the base's branches). A land merges a branch into main in
# another workspace and pushes main from there, so this checkout's remote refs
# may lag: when any commit looks unsaved, origin is fetched and they are read
# again. A merge of two parents whose tree is the one `git merge-tree` makes of
# them holds nothing of its own (its parents are judged on their own); any
# other commit, a merge with an edit or a resolved conflict among them, is
# work. The plugin's process/unpushed.ts is the same rule.
work_own_commits() {
  # shellcheck disable=SC2086 # one argument per tip
  o_all=$(git -C "$1" rev-list HEAD --branches --ignore-missing --not --remotes $2)
  [ -n "$o_all" ] || return 0
  GIT_TERMINAL_PROMPT=0 git -C "$1" fetch --quiet --no-tags origin >/dev/null 2>&1 ||
    printf 'workrift: no fetch from origin in %s; its remote refs may be stale\n' "$1" >&2
  # shellcheck disable=SC2086 # one argument per tip
  o_all=$(git -C "$1" rev-list HEAD --branches --ignore-missing --not --remotes $2)
  for o_commit in $o_all; do
    read -r _ o_first o_second o_more <<EOF
$(git -C "$1" rev-list --parents -n 1 "$o_commit")
EOF
    if [ -n "${o_second:-}" ] && [ -z "${o_more:-}" ] &&
      o_merged=$(git -C "$1" merge-tree --write-tree "$o_first" "$o_second" 2>/dev/null) &&
      [ "$(printf '%s\n' "$o_merged" | head -n 1)" = "$(git -C "$1" rev-parse "$o_commit^{tree}")" ]; then
      continue
    fi
    printf '%s\n' "$o_commit"
  done
}

# The plugin's removal rule (workspace.ts): no uncommitted change, no commit on
# no remote and in no branch of the base, and no stash entry of its own. $1 is
# the workspace, $2 the base, $3 the stash commits of the folders above it.
work_require_held() {
  w_dirty=$(git -C "$1" status --porcelain -- . ':(exclude).rift')
  [ -z "$w_dirty" ] || fail "$1 has uncommitted changes: $(printf '%s' "$w_dirty" | head -n 3 | tr '\n' ' ')"
  w_tips=$(git -C "$2" for-each-ref --format='%(objectname)' refs/heads)
  w_own=$(work_own_commits "$1" "$w_tips")
  # shellcheck disable=SC2086 # one argument per commit
  [ -z "$w_own" ] || fail "$1 has commits on no remote and in no branch of $2: $(git -C "$1" show -s --format='%h %s' $w_own | head -n 3 | tr '\n' ' ')"
  for w_stash in $(git -C "$1" stash list --format=%H); do
    printf '%s\n' "$3" | grep -qxF "$w_stash" || fail "$1 has stash entries of its own"
  done
}

# The path of the one active workspace, of any work base, that create made
# for the branch $1: named workspace_name of it, or that name and -N (work_new
# adds -N while a trashed workspace holds the name) on branch $1. None, or
# more than one, fails: a name never picks among several.
workspace_by_name() {
  n_name=$(workspace_name "$1")
  [ -n "$n_name" ] || fail "not a workspace: $1 (a branch name or an absolute path)"
  n_bases=$(work_bases)
  n_found=
  n_old_ifs=$IFS
  IFS='
'
  for n_base in $n_bases; do
    IFS=$n_old_ifs
    n_json=$(work_list_checked "$n_base") || exit 1
    # shellcheck disable=SC2016 # jq's variables
    n_paths=$(printf '%s' "$n_json" | jq -r --arg n "$n_name" --arg b "$1" \
      '.[] | select(.state._tag == "Active" and (.name == $n or ((.name | startswith($n + "-") and (ltrimstr($n + "-") | test("^[0-9]+$"))) and .branch == $b))) | .path') ||
      fail "work --json list in $n_base does not read"
    [ -z "$n_paths" ] || n_found="$n_found$n_paths
"
  done
  IFS=$n_old_ifs
  n_found=$(printf '%s' "$n_found" | sed '/^$/d')
  case "$(printf '%s' "$n_found" | grep -c .)" in
    1) printf '%s\n' "$n_found" ;;
    0) fail "not a workspace: no active workspace of any work base is named $n_name, the name create gives $1 (a half-made one is removed only by its absolute path)" ;;
    *) fail "several workspaces answer to $1: $(printf '%s' "$n_found" | tr '\n' ' '); name one by its absolute path" ;;
  esac
}

work_remove() {
  if ! w_target=$(git -C "$1" rev-parse --show-toplevel 2>/dev/null); then
    work_remove_half_made "$1" "$3"
    return
  fi
  w_with_children=$2
  w_base=
  w_bases=$(work_bases)
  w_old_ifs=$IFS
  IFS='
'
  for w_candidate in $w_bases; do
    if ! w_json=$(work_in "$w_candidate" --json list); then
      [ -d "$w_candidate" ] || continue
      fail "work list failed in $w_candidate: $w_json"
    fi
    if printf '%s' "$w_json" | jq -e --arg p "$w_target" 'any(.[]; .path == $p and .state._tag == "Active")' >/dev/null; then
      w_base=$w_candidate
      break
    fi
  done
  IFS=$w_old_ifs
  if [ -z "$w_base" ]; then
    # A Creating record over a checkout: a live lane whose create never
    # recorded its end, not a half-made folder.
    w_records=$(work_records_at "$w_target") || fail "not a workspace of any work base, and work's records do not read: $w_target"
    w_stale=$(printf '%s\n' "$w_records" | awk -F "$record_separator" -v p="$w_target" '$4 == "Creating" && $6 == p { print $5; exit }')
    [ -z "$w_stale" ] || fail "$(stale_lane_words "$w_target" "$w_stale")"
    fail "not a workspace of any work base: $w_target"
  fi

  # shellcheck disable=SC2016 # jq's variables
  w_tree='[.[] | select(.state._tag == "Active")] as $all
    | def below($p): ($all[] | select(.parent == $p) | .path) as $k | $k, below($k);
    def above($p): ($all[] | select(.path == $p) | .parent) as $q | $q, above($q);'
  w_id=$(printf '%s' "$w_json" | jq -r --arg p "$w_target" '.[] | select(.path == $p and .state._tag == "Active") | .id')
  w_name=$(printf '%s' "$w_json" | jq -r --arg p "$w_target" '.[] | select(.path == $p and .state._tag == "Active") | .name')
  w_children=$(printf '%s' "$w_json" | jq -r --arg p "$w_target" '.[] | select(.parent == $p and .state._tag == "Active") | .path')
  # work rm -tree trashes the whole subtree, so a child workspace that someone
  # still uses would go with it.
  if [ -n "$w_children" ] && [ "$w_with_children" = false ]; then
    fail "$w_target has child workspaces; pass --with-children to trash them too: $(printf '%s' "$w_children" | tr '\n' ' ')"
  fi

  # work rm refuses a workspace whose head no branch of its parent holds, even
  # when origin holds it; the rule above is the owner's, and -abandon follows it.
  w_doomed=$(printf '%s' "$w_json" | jq -r --arg p "$w_target" "$w_tree"' $p, below($p)')
  work_remove_checks

  w_verb=trash
  [ "$purge_trash" = true ] && w_verb=delete
  if [ "$3" = true ]; then
    printf '%s\n' "$w_doomed" | sed "s/^/would $w_verb: /"
    return 0
  fi

  # One clone or delete of a copy base at a time (lock_clone). After a wait
  # in line the workspace may have changed (an agent wrote in it, a shell
  # entered it): the checks again, under the turn, before anything goes.
  lock_clone "$w_base" "delete $w_name (remove $w_target)"
  [ "$clone_waited" = false ] || work_remove_checks
  if [ "$w_with_children" = true ]; then
    w_out=$(work_in "$w_base" --json rm -abandon -expect "$w_id" -tree "$w_name") || fail "work rm failed for $w_target: $w_out"
  else
    w_out=$(work_in "$w_base" --json rm -abandon -expect "$w_id" "$w_name") || fail "work rm failed for $w_target: $w_out"
  fi
  [ "$purge_trash" != true ] || work_purge "$w_base" "$w_json" "$w_doomed" "$w_out"
  unlock_clone
}

# The removal rule over every workspace work_remove would remove (w_doomed, of
# the list w_json, the base w_base): each held (work_require_held), and none a
# process works in.
work_remove_checks() {
  for w_path in $w_doomed; do
    w_above=$(printf '%s' "$w_json" | jq -r --arg p "$w_path" "$w_tree"' above($p)')
    w_inherited=$(for w_up in $w_above; do git -C "$w_up" stash list --format=%H; done)
    work_require_held "$w_path" "$w_base" "$w_inherited"
  done
  # A folder a process works in is not deleted under it (a shell, a daemon).
  w_old_ifs=$IFS
  IFS='
'
  for w_path in $w_doomed; do
    if w_user=$(process_in "$w_path"); then
      IFS=$w_old_ifs
      fail "a process works in $w_path (pid $w_user); end it, then remove again"
    fi
  done
  IFS=$w_old_ifs
}

# The records of every base whose path is $1 or a folder below it, one a
# line: base, name, id, state, since and path, each ended by record_separator
# (a tab would let an empty id vanish). It fails closed: work missing or
# failing, or an answer that is not a list of records each with a name, id,
# path, state tag and since (not JSON, not a list, a row short of one, no
# output at all), fails with what came back, never reads as "no record".
record_separator=$(printf '\037')
# `work --json list` of the base $1, printed only when it is a list of records
# each with a name, id, path, state tag and since; anything else fails.
work_list_checked() {
  l_json=$(work_in "$1" --json list) || fail "work --json list failed in $1 (exit $?): ${l_json:-no output}"
  printf '%s' "$l_json" | jq -e 'type == "array" and all(.[]; type == "object"
      and (.name | type) == "string" and (.id | type) == "string" and (.path | type) == "string"
      and (.state | type) == "object" and (.state._tag | type) == "string" and (.since | type) == "number")' >/dev/null 2>&1 ||
    fail "work --json list in $1 answered no list of records (each with a name, id, path, state and since): $(printf '%s' "${l_json:-no output}" | head -c 200)"
  printf '%s' "$l_json"
}
work_records_at() {
  r_bases=$(work_bases) || return 1
  r_old_ifs=$IFS
  IFS='
'
  for r_base in $r_bases; do
    IFS=$r_old_ifs
    r_json=$(work_list_checked "$r_base") || exit 1
    printf '%s' "$r_json" | jq -r --arg b "$r_base" --arg p "$1" --arg s "$record_separator" \
      '.[] | select(.path == $p or (.path | startswith($p + "/"))) | [$b, .name, .id, .state._tag, (.since | tostring), .path] | join($s)' ||
      fail "work --json list in $r_base does not read"
  done
  IFS=$r_old_ifs
}

# A duration in seconds as hours, else minutes: 7h, 10m.
age_words() {
  if [ "$1" -ge 3600 ]; then printf '%sh' "$(($1 / 3600))"; else printf '%sm' "$(($1 / 60))"; fi
}

# The refusal of a Creating record ($2 its since) over the folder $1 that
# holds a .git.
stale_lane_words() {
  printf '%s has a record in state Creating, %s old, but holds a .git: it looks like a live lane whose create never recorded its end (a stale record), not a half-made one; nothing is removed. work has no command that marks such a record active; ask work'"'"'s maintainers for one, and do not edit the registry by hand' \
    "$1" "$(age_words $(($(date +%s) - $2)))"
}

# A folder a cut `workrift create` left (the server restarted mid-create,
# 2026-11-19): in a base's .work/<repo>/, with no .git and no record, so work
# cannot take it. Deleted for good (the workbox keeps no trash; never moved),
# and only the one path the caller named, never one read from a listing, a
# glob or the subvolumes: that path must be absolute and already resolved (no
# link, no `..`), a direct child of the .work/<repo>/ folder of a work base,
# not one of work's own entries (.registry, .lock, .work-trash), hold no .git,
# be no record's path in any base nor hold one, be no mount point nor hold one,
# and no process may work in it or hold a file open under it. The base's
# workrift lock is held throughout, so no create or refresh runs meanwhile. A
# btrfs subvolume (inode 256 on btrfs) goes by one `btrfs subvolume delete` of
# that path; a plain folder by an rm that never crosses into another file
# system. Neither follows a link: a link in it is unlinked. $2 true is a dry run.
#
# A cut `work new` can also leave its reservation: a record in state Creating
# of that path (the real scratch-vfy-sync-parity, 2026-11-20). That folder is
# half-made only on positive proof, shown to the caller: no .git (a live lane
# has one; a Creating record over a folder with one is a live lane whose
# create never recorded its end, and is refused), the record at least an hour
# old (work itself takes an id-less reservation as abandoned after an hour),
# its maker gone (the reservation's lock is free) and no workrift create
# holding the base's lock, plus every check above. Then work's own
# `work gc -id <id>` deletes the folder and drops the record together; the
# registry stays work's.
work_remove_half_made() {
  h_path=$1
  h_dry_run=$2
  h_no() { fail "$1; nothing deleted"; }
  case "$h_path" in
    /*) ;;
    *) h_no "not a workspace: $h_path (a half-made one is removed only by its absolute path)" ;;
  esac
  while [ "${h_path%/}" != "$h_path" ] && [ "$h_path" != / ]; do h_path=${h_path%/}; done
  [ ! -L "$h_path" ] || h_no "$h_path is a symbolic link; name the folder itself"
  [ -d "$h_path" ] || h_no "not a workspace: $h_path"
  h_real=$(cd "$h_path" && pwd -P) || h_no "cannot resolve $h_path"
  [ "$h_real" = "$h_path" ] || h_no "$h_path resolves to $h_real; name that path itself"
  case "$h_path" in
    *[][*?\\]*) h_no "$h_path holds a glob character; remove it by hand" ;;
  esac
  h_dir=${h_path%/*}
  h_name=${h_path##*/}
  h_repo=${h_dir##*/}
  h_work=${h_dir%/*}
  [ "${h_work##*/}" = .work ] && [ -n "$h_repo" ] ||
    h_no "not a workspace: $h_path is not a direct child of a .work/<repo>/ folder"
  case "$h_name" in
    .*) h_no "$h_path is work's own ($h_name), not a workspace" ;;
  esac
  h_base=${h_work%/*}/$h_repo
  h_bases=$(work_bases) || h_no "work's bases do not read"
  printf '%s\n' "$h_bases" | grep -qxF "$h_base" || h_no "not a workspace: $h_dir is the folder of no work base ($h_base is none)"
  h_old_ifs=$IFS
  IFS='
'
  for h_one in $h_bases; do
    case "$h_one/" in
      "$h_path/"*) IFS=$h_old_ifs; h_no "$h_path is or holds the base $h_one" ;;
    esac
  done
  IFS=$h_old_ifs

  # No create or refresh of the base runs while this looks and deletes (the
  # base's lock, exclusive, on descriptor 8, taken only when nothing is in line).
  lock_purpose="remove half-made $h_path"
  queue_enter "$h_base" base w 8 try ||
    h_no "a workrift create, advance or refresh is in line for the lock of $h_base:$(queue_words "$h_base" base); try again once it ends"
  hold_ticket=$queue_ticket

  # No record names it or a folder below it, but one: a Creating record of
  # this very path in this base, with an id, which work gc -id takes.
  h_records=$(work_records_at "$h_path") || h_no "work's records do not read"
  h_creating=false
  if [ -n "$h_records" ]; then
    IFS=$record_separator read -r h_rbase h_rname h_rid h_rstate h_rsince h_rpath <<EOF
$h_records
EOF
    if [ "$(printf '%s\n' "$h_records" | wc -l)" -eq 1 ] && [ "$h_rstate" = Creating ] &&
      [ "$h_rpath" = "$h_path" ] && [ "$h_rbase" = "$h_base" ] && [ -n "$h_rid" ]; then
      h_creating=true
    else
      h_no "$h_path is the path of a record of $h_rbase, $h_rname ($h_rstate); remove it with work"
    fi
  fi
  if [ -e "$h_path/.git" ] || [ -L "$h_path/.git" ]; then
    [ "$h_creating" = false ] || h_no "$(stale_lane_words "$h_path" "$h_rsince")"
    h_no "$h_path holds a .git but is no workspace Git reads; remove it by hand"
  fi

  h_mounts=$proc_root/self/mountinfo
  [ -r "$h_mounts" ] || h_no "cannot read the mount table ($h_mounts)"
  h_coded=$(printf '%s' "$h_path" | sed 's/\\/\\134/g; s/ /\\040/g; s/	/\\011/g')
  h_mount=$(awk -v p="$h_coded" '$5 == p || index($5, p "/") == 1 { print $5; exit }' "$h_mounts")
  [ -z "$h_mount" ] || h_no "a file system is mounted at $h_mount"

  h_user=$(find "$proc_root" -mindepth 1 -maxdepth 3 \
    \( ! -path "$proc_root/[0-9]*" -prune \) -o \
    \( -path "$proc_root/[0-9]*/*" ! -path "$proc_root/[0-9]*/fd" ! -path "$proc_root/[0-9]*/fd/*" ! -path "$proc_root/[0-9]*/cwd" -prune \) -o \
    \( \( -lname "$h_path" -o -lname "$h_path/*" \) -print -quit \) 2>/dev/null || true)
  if [ -n "$h_user" ]; then
    h_pid=${h_user#"$proc_root"/}
    h_pid=${h_pid%%/*}
    h_no "a process works in or holds a file open under $h_path (pid $h_pid $(cat "$proc_root/$h_pid/comm" 2>/dev/null || printf '?'))"
  fi

  # A Creating record: a create that is not over yet is no half-made one.
  # It is old enough, and its maker is gone: work's maker holds the
  # reservation's lock (<storage>/.lock-<id>) while it copies, and gives it
  # back (removing the file) when it ends.
  if [ "$h_creating" = true ]; then
    h_age=$(($(date +%s) - h_rsince))
    [ "$h_age" -ge "$half_made_min_age" ] ||
      h_no "the Creating record of $h_path is $(age_words "$h_age") old, younger than $((half_made_min_age / 60)) minutes: its create may still be on its way"
    h_reservation=$h_dir/.lock-$h_rid
    if [ -e "$h_reservation" ] && ! flock -n "$h_reservation" true; then
      h_no "a create still runs for $h_rname: its maker holds $h_reservation"
    fi
  fi

  h_entries=$(find "$h_path" -mindepth 1 2>/dev/null | wc -l | tr -d ' ')
  if [ "$h_creating" = true ]; then
    h_kind="a folder work reserved; work gc -id $h_rid (work's own command) deletes it and drops its record"
    h_subvolume=false
  elif [ "$(stat -f -c %T "$h_path" 2>/dev/null)" = btrfs ] && [ "$(stat -c %i "$h_path" 2>/dev/null)" = 256 ]; then
    h_kind='a btrfs subvolume with no record (deleted by one btrfs subvolume delete of its path)'
    h_subvolume=true
  else
    h_kind='a plain folder (deleted without crossing into another file system)'
    h_subvolume=false
  fi
  printf 'half-made workspace: %s\n' "$h_path"
  if [ "$h_creating" = true ]; then
    printf '  record %s (id %s) of %s is Creating, %s old (at least %s minutes)\n' "$h_rname" "$h_rid" "$h_rbase" "$(age_words "$h_age")" "$((half_made_min_age / 60))"
    printf '  no .git (a live lane has one)\n'
    printf "  no create running: its reservation lock is free and no workrift create holds the base's lock\n"
    printf '  no mount at or below it\n'
  else
    printf '  no .git, no record in any work base, no mount at or below it\n'
  fi
  printf '  no process works in it or holds a file open under it\n'
  printf '  %s entries; %s\n' "$h_entries" "$h_kind"
  if [ "$h_dry_run" = true ]; then
    printf 'would delete: %s\n' "$h_path"
    return 0
  fi
  if [ "$h_creating" = true ]; then
    # work gc -id takes that one record, and only while its maker is gone; it
    # answers the names it purged. Anything but this one, and the folder or
    # the record still there, is reported as it is.
    h_out=$(work_in "$h_base" --json gc -id "$h_rid") || h_no "work gc -id $h_rid failed: $h_out"
    h_left=$(work_records_at "$h_path") || h_left='(the records do not read)'
    if [ "$(printf '%s' "$h_out" | jq -c '.purged' 2>/dev/null)" != "$(jq -cn --arg n "$h_rname" '[$n]')" ] ||
      [ -e "$h_path" ] || [ -L "$h_path" ] || [ -n "$h_left" ]; then
      fail "work gc -id $h_rid answered $h_out; the folder is $([ -e "$h_path" ] && printf 'still there' || printf 'gone'), its record $([ -n "$h_left" ] && printf 'still there' || printf 'gone')"
    fi
  elif [ "$h_subvolume" = true ]; then
    btrfs subvolume delete "$h_path" >/dev/null || h_no "btrfs subvolume delete $h_path failed"
  elif rm --version >/dev/null 2>&1; then
    rm -rf --one-file-system -- "$h_path" || true
  else
    rm -rf -x -- "$h_path" || true
  fi
  [ ! -e "$h_path" ] && [ ! -L "$h_path" ] || fail "$h_path is not all deleted: $(find "$h_path" -mindepth 1 2>/dev/null | head -n 3 | tr '\n' ' ')"
  printf 'deleted: %s\n' "$h_path"
}

# The workbox keeps no trash (owner, 2026-11-19): after `work rm`, each record
# it trashed is deleted by work itself, `work gc -id ID`, which takes that one
# record and deletes only its folder (work's PurgingTouchesOneEntry). workrift
# deletes no path of its own. Before any gc, every record rm answered must be
# one of the workspaces this removal named ($3, from the list $2 read before
# it), by a non-empty id that is the answer's only one, and its trash folder
# must be <that workspace's folder's parent>/.work-trash/<one name>, neither
# the base, nor holding the base or a workspace that stays. Anything else, and
# no gc runs: the trash stays, named. $1 is the base, $4 rm's answer. On the
# Mac (and wherever WORKRIFT_PURGE=0) the trash stays, as before.
#
# A base whose work keeps no trash (`trash = false`) deletes the folder and
# the record in the rm itself, and answers "trash": "" for it; a gc -id then
# finds no record and purges nothing. For such a row no gc runs, and the end
# state is proven instead: the folder is gone, and a `work --json list` that
# reads as a list of records has no record of that id. A row whose trash is a
# path keeps the rule above, and its gc -id must answer that one name.
work_purge() {
  p_base=$1
  p_list=$2
  p_doomed=$3
  p_answer=$4
  # Joined by record_separator: a tab is whitespace to read, so an empty trash would shift the fields.
  # shellcheck disable=SC2016 # jq's variables
  p_rows=$(printf '%s' "$p_answer" | jq -r --arg s "$record_separator" \
    '.[] | [.id, .trash, .name] | if all(.[]; type == "string") then join($s) else error("a field is no string") end') ||
    fail "work rm's answer does not read; nothing deleted: $p_answer"
  p_trashes=$(printf '%s' "$p_answer" | jq -r '.[].trash')
  p_left() { fail "$1; nothing deleted, the trash stays: $(printf '%s' "$p_trashes" | tr '\n' ' ')"; }
  [ -n "$p_rows" ] || p_left "work rm answered no removed workspace"
  # Read with the shell's builtins, or with the status of the one command
  # checked: a jq that fails is never an empty list (a trash that holds a kept
  # workspace would pass), nor a cut that fails no duplicate.
  p_ids=
  while IFS= read -r p_row; do
    p_id=${p_row%%"$record_separator"*}
    case "$p_ids" in *"
$p_id
"*) p_left "work rm answered one id twice" ;; esac
    p_ids="${p_ids:-
}$p_id
"
  done <<EOF
$p_rows
EOF
  p_active=$(printf '%s' "$p_list" | jq -r '.[] | select(.state._tag == "Active") | .path') ||
    p_left "work's list of workspaces does not read (jq failed), so no kept workspace can be told from the trash"
  p_kept=$p_base
  while IFS= read -r p_one; do
    [ -n "$p_one" ] || continue
    case "
$p_doomed
" in *"
$p_one
"*) continue ;; esac
    p_kept="$p_kept
$p_one"
  done <<EOF
$p_active
EOF
  p_plan=
  p_gone=
  while IFS=$record_separator read -r p_id p_trash p_name; do
    [ -n "$p_id" ] || p_left "work rm answered $p_name with no id"
    p_was=$(printf '%s' "$p_list" | jq -r --arg id "$p_id" '[.[] | select(.id == $id and .state._tag == "Active") | .path] | if length == 1 then .[0] else "" end')
    if [ -z "$p_was" ] || ! printf '%s\n' "$p_doomed" | grep -qxF "$p_was"; then
      p_left "work rm answered id $p_id, which is none of the workspaces asked for"
    fi
    if [ -z "$p_trash" ]; then
      p_gone="$p_gone$p_id$record_separator$p_was
"
      continue
    fi
    case "$p_trash" in
      /*) ;;
      *) p_trash=$p_base/$p_trash ;;
    esac
    p_entry=${p_trash##*/}
    case "$p_entry" in
      '' | . | ..) p_left "the trash folder of $p_was has no name: $p_trash" ;;
    esac
    [ "$p_trash" = "${p_was%/*}/.work-trash/$p_entry" ] ||
      p_left "the trash folder of $p_was is not beside it: $p_trash"
    while IFS= read -r p_one; do
      case "$p_one/" in
        "$p_trash/"*) p_left "the trash folder $p_trash holds $p_one" ;;
      esac
    done <<EOF
$p_kept
EOF
    p_plan="$p_plan$p_id$record_separator$p_trash$record_separator$p_was$record_separator$p_name
"
  done <<EOF
$p_rows
EOF
  p_failed=
  while IFS=$record_separator read -r p_id p_trash p_was p_name; do
    [ -n "$p_id" ] || continue
    if ! p_gc=$(work_in "$p_base" --json gc -id "$p_id"); then
      printf 'workrift: work gc -id %s failed; its trash stays at %s: %s\n' "$p_id" "$p_trash" "$p_gc" >&2
      p_failed="$p_failed $p_trash"
    elif [ -e "$p_trash" ]; then
      printf 'workrift: work gc -id %s left its trash at %s: %s\n' "$p_id" "$p_trash" "$p_gc" >&2
      p_failed="$p_failed $p_trash"
    elif [ "$(printf '%s' "$p_gc" | jq -c '.purged' 2>/dev/null)" != "$(jq -cn --arg n "$p_name" '[$n]')" ]; then
      printf 'workrift: work gc -id %s answered %s, not the one name %s; its trash was at %s\n' "$p_id" "$p_gc" "$p_name" "$p_trash" >&2
      p_failed="$p_failed $p_trash"
    else
      printf 'deleted: %s\n' "$p_was"
    fi
  done <<EOF
$p_plan
EOF
  p_unproven=
  if [ -n "$p_gone" ]; then
    # work said nothing went to its trash: the folder and the record must both be gone.
    p_after=$(work_list_checked "$p_base") || fail "work rm answered that nothing went to the trash, but work's records do not read, so the deletion is unproven"
    while IFS=$record_separator read -r p_id p_was; do
      [ -n "$p_id" ] || continue
      if [ -e "$p_was" ] || [ -L "$p_was" ]; then
        printf 'workrift: work rm answered that nothing went to the trash, but %s is still there\n' "$p_was" >&2
        p_unproven="$p_unproven $p_was"
      else
        # jq -e: 0 listed, 1 not listed; any other status read nothing.
        p_rc=0
        printf '%s' "$p_after" | jq -e --arg id "$p_id" 'any(.[]; .id == $id)' >/dev/null || p_rc=$?
        case "$p_rc" in
          0)
            printf 'workrift: work rm answered that nothing went to the trash, but work --json list still lists id %s (%s)\n' "$p_id" "$(printf '%s' "$p_after" | jq -c --arg id "$p_id" '[.[] | select(.id == $id) | {path, state: .state._tag}]')" >&2
            p_unproven="$p_unproven $p_was"
            ;;
          1) printf 'deleted: %s\n' "$p_was" ;;
          *)
            printf 'workrift: work rm answered that nothing went to the trash, but whether work --json list still lists id %s does not read (jq status %s)\n' "$p_id" "$p_rc" >&2
            p_unproven="$p_unproven $p_was"
            ;;
        esac
      fi
    done <<EOF
$p_gone
EOF
  fi
  [ -z "$p_failed" ] || fail "removed, but not deleted; the trash stays:$p_failed"
  [ -z "$p_unproven" ] || fail "removed, but not proven deleted:$p_unproven"
}

# The workspaces of one base (a work_workspaces file) that Rift's prune would
# remove, by its rules: one is kept when missing, pinned, in use by a process
# or written in the last two days, and so is every workspace above a kept one.
# Prints the same skip and `would remove` lines; removes nothing.
work_prune_list() {
  : >"$work_dir/kept.txt"
  : >"$work_dir/stale.txt"
  while IFS='	' read -r _ _ w_path _ _; do
    if [ ! -d "$w_path" ]; then
      printf 'skip missing: %s\n' "$w_path"
      printf '%s\n' "$w_path" >>"$work_dir/kept.txt"
    elif is_pinned "$w_path"; then
      printf 'skip pinned: %s\n' "$w_path"
      printf '%s\n' "$w_path" >>"$work_dir/kept.txt"
    elif is_active "$w_path"; then
      printf 'skip active: %s\n' "$w_path"
      printf '%s\n' "$w_path" >>"$work_dir/kept.txt"
    elif is_recent "$w_path"; then
      printf 'skip recent: %s\n' "$w_path"
      printf '%s\n' "$w_path" >>"$work_dir/kept.txt"
    else
      printf '%s\n' "$w_path" >>"$work_dir/stale.txt"
    fi
  done <"$1"
  while IFS= read -r w_up; do
    while w_up=$(awk -F '	' -v p="$w_up" '$3 == p { print $4 }' "$1") && [ -n "$w_up" ]; do
      printf '%s\n' "$w_up"
    done
  done <"$work_dir/kept.txt" >"$work_dir/protected.txt"
  while IFS= read -r w_path; do
    if grep -qxF "$w_path" "$work_dir/protected.txt"; then
      printf 'skip parent of kept workspaces: %s\n' "$w_path"
    else
      printf 'would remove: %s\n' "$w_path"
    fi
  done <"$work_dir/stale.txt"
}

# Prune under work. A base that holds a path in the keep file is left out
# whole (gc has no pin). --dry-run lists, by Rift's rules, what would go.
# While work_gc_safe is not true, prune only lists too, and says it is held.
# Once it is, each other base runs `work gc -idle`, which removes the
# workspaces no new, ready or sync touched for two days, keeping the work of
# each in the base at refs/work/archive/NAME/ID (-archive), and empties the
# base's trash, whatever its age (-older 0s: the workbox keeps no trash). work
# itself keeps the trash of a workspace gc -idle removes for a day (Ergo's
# IdleTrash), so the next prune deletes it.
work_prune() {
  w_dry_run=$1
  w_bases=$(work_bases)
  if [ -z "$w_bases" ]; then
    printf 'no workspaces registered\n'
    return 0
  fi
  if [ "$w_dry_run" = false ] && [ "$work_gc_safe" != true ]; then
    printf "held: work gc is not safe yet (data-loss finding in work's verify)\n"
  fi
  w_failures=0
  w_old_ifs=$IFS
  IFS='
'
  for w_base in $w_bases; do
    IFS=$w_old_ifs
    work_workspaces "$w_base" >"$work_dir/workspaces.tsv"
    w_kept=
    is_pinned "$w_base" && w_kept=$w_base
    while IFS='	' read -r _ _ w_path _ _; do
      if is_pinned "$w_path"; then
        w_kept="${w_kept:+$w_kept }$w_path"
      fi
    done <"$work_dir/workspaces.tsv"
    if [ -n "$w_kept" ]; then
      printf 'skip base with kept workspaces: %s (kept: %s)\n' "$w_base" "$w_kept"
      continue
    fi
    if [ "$w_dry_run" = true ] || [ "$work_gc_safe" != true ]; then
      work_prune_list "$work_dir/workspaces.tsv"
      continue
    fi
    if ! w_out=$(work_in "$w_base" --json gc -idle "$work_idle" -archive -older 0s); then
      printf 'failed to prune: %s: %s\n' "$w_base" "$w_out" >&2
      w_failures=$((w_failures + 1))
      continue
    fi
    printf '%s' "$w_out" | jq -r --arg base "$w_base" '
      (.idle[] | if .removed
        then "removed: \(.name) of \($base)" + (if .archived != "" then " (archive: \(.archived))" else "" end)
        else "skip \(.name) of \($base): \(.why)" end),
      (.purged[] | "emptied from the trash: \(.) of \($base)")'
  done
  IFS=$w_old_ifs
  test "$w_failures" -eq 0
}

# `workrift deps` in a workspace of a base whose work.toml has [deps] is
# `work deps`; anywhere else it is workrift's own install. When work answers
# Untrusted (the base's work.toml commands changed since a person ran `work
# trust`: work-trust.md, 2026-11-20), work installed nothing, so workrift
# installs with its own fixed command, never the untrusted file's. Any other
# failure of work deps (DepsFailed: its install ran and failed) fails.
work_deps() {
  workspace_deps "$(resolve_source)" "$1"
}

# The deps step of the checkout $2 of the base $1, as `workrift deps` runs it.
workspace_deps() {
  w_base=$1
  w_top=$2
  if ! work_installs "$w_base" || [ "$w_base" = "$w_top" ]; then
    sync_dependencies "$w_top"
    return
  fi
  w_rows=$(work_workspaces "$w_base")
  w_name=$(printf '%s\n' "$w_rows" | awk -F '	' -v p="$w_top" '$3 == p { print $1 }')
  [ -n "$w_name" ] || fail "not a workspace of $w_base: $w_top"
  # stdout passes through as it comes; stderr is read for the tag, then shown.
  w_status=0
  { w_said=$(work_in "$w_base" deps -name "$w_name" 2>&1 >&3 3>&-) || w_status=$?; } 3>&1
  if [ "$w_status" -eq 0 ]; then
    [ -z "$w_said" ] || printf '%s\n' "$w_said" >&2
    return 0
  fi
  if printf '%s' "$w_said" | grep -q '"_tag":"Untrusted"'; then
    printf 'workrift: work deps answered Untrusted and installed nothing\n' >&2
    trust_note "$w_base" Untrusted
    sync_dependencies "$w_top"
    return
  fi
  printf '%s\n' "$w_said" >&2
  exit "$w_status"
}

# One line when work does not trust the base's work.toml commands on this
# host: `work --json doctor` says trusted false, or work answered Untrusted
# ($2). work then skips the file's [deps] install and its hooks, and workrift
# installs with its own fixed command instead: git config workrift.install,
# else the lock file's (bun install --frozen-lockfile, pnpm install
# --frozen-lockfile, yarn install --immutable, npm ci), else none, as for a
# base with no [deps]. workrift never runs `work trust`: allowing commands a
# teammate's change brought in is a person's call.
trust_note() {
  [ -f "$1/work.toml" ] || return 0
  t_trusted=$(work_in "$1" --json doctor 2>/dev/null | jq -r '.trusted' 2>/dev/null || true)
  [ "$t_trusted" = false ] || [ "${2:-}" = Untrusted ] || return 0
  printf "workrift: %s/work.toml runs commands work does not trust on this host (work doctor: trusted %s), so work skips its [deps] install and hooks and workrift installs with its own fixed command (git config workrift.install, else the lock file's); review the file, then run work trust in %s to let work do it\n" \
    "$1" "${t_trusted:-unknown}" "$1" >&2
}

# `workrift subvolume`: switch a base between a plain folder and the root of a
# btrfs subvolume. Ergo's work snapshots a base that is a subvolume (one call
# per workspace, one `btrfs subvolume delete` per removal) and copies a plain
# folder file by file (~400k files a Bite tree, 12-17 min when removals run
# beside it). Bite's base was made a folder; this converts it in place.
#
# Without --apply it changes nothing: it prints the preflight and the exact
# steps with their absolute paths. The trees it uses sit beside the base:
#   <parent>/.subvolume-move/<name>.new   the subvolume a forward copy fills
#   <parent>/.subvolume-move/<name>.back  the folder a copy back fills
#   <parent>/.subvolume-move/<name>.old   the tree the base was before the
#                                         last switch, kept until --drop-old
# A forward switch (no flag) holds the base's exclusive lock and its clone
# turn in line (creates wait behind it, none fails), copies the base into a new
# subvolume by reflink, verifies it, swaps it in by one renameat2
# (RENAME_EXCHANGE: the base's path never names nothing), parks the old tree at
# .old, waits for every process outside workrift's line to leave it, carries
# the refs it gained into the new base, runs `work refresh` there (every inode
# is new), proves a snapshot workspace can be made and removed, and releases.
# --back switches to the kept tree the same way (or, when none is kept, copies
# into a new folder). --drop-old deletes the kept tree by its exact path, only
# when it is the very tree the last switch parked there. Nothing goes to a
# trash. The checked-out branch is never moved by the carry: a difference is
# kept under refs/subvolume-move/ and named.
#
# A state file in the base's state folder (subvolume/) names the switch under
# way; a run cut at any point (kill -9 too) leaves the old tree or the new one
# whole at the base's path, never neither, and the next --apply finishes it or
# rolls it back. A failure under the hold rolls back at once: the copy is
# deleted, the old tree is swapped back.
#
# Variables here start with sv_ (the paths, read-only once set) or are local.
sv_meta_mib=${WORKRIFT_SUBVOLUME_META_MIB:-1229}
sv_min_slack_mib=${WORKRIFT_SUBVOLUME_MIN_SLACK_MIB:-$((4 * sv_meta_mib + 4096))}
sv_min_free_mib=${WORKRIFT_SUBVOLUME_MIN_FREE_MIB:-40960}
sv_max_used_pct=${WORKRIFT_SUBVOLUME_MAX_USED_PCT:-90}
# How long the carry waits for processes to leave the old tree, how long the
# hold may take to copy and verify, how long the command waits for its turn.
sv_wait_seconds=${WORKRIFT_SUBVOLUME_WAIT:-60}
sv_limit_seconds=${WORKRIFT_SUBVOLUME_LIMIT:-1200}
sv_turn_seconds=${WORKRIFT_SUBVOLUME_TURN_WAIT:-1800}
sv_sysfs=${WORKRIFT_SYSFS_BTRFS:-/sys/fs/btrfs}
sv_smoke=scratch-subvolume-smoke

# renameat2 (Linux) or renamex_np (macOS) of $2 and $3: `exchange` swaps them
# in one call, `rename` moves $2 to $3 and fails when $3 exists. Never a copy.
sv_rename_py='import ctypes, ctypes.util, os, sys
how, a, b = sys.argv[1], os.fsencode(sys.argv[2]), os.fsencode(sys.argv[3])
libc = ctypes.CDLL(ctypes.util.find_library("c"), use_errno=True)
if sys.platform.startswith("linux"):
    r = libc.renameat2(-100, a, -100, b, {"exchange": 2, "rename": 1}[how])
else:
    r = libc.renamex_np(a, b, {"exchange": 2, "rename": 4}[how])
if r != 0:
    sys.exit("%s %s %s: %s" % (how, sys.argv[2], sys.argv[3], os.strerror(ctypes.get_errno())))'

sv_renameat() {
  python3 -c "$sv_rename_py" "$1" "$2" "$3" 3>&- 6>&- 7>&- 8>&- 9>&-
}

# The paths of the base $1, set once and checked once (sv_is): every delete
# names one of these read-only paths itself, never a path it was handed. The
# state folder is only named here: a dry run creates nothing; the hold makes
# it (sv_state_make).
sv_paths() {
  sv_base=$1
  sv_parent=${1%/*}
  sv_name=${1##*/}
  sv_dir=$sv_parent/.subvolume-move
  sv_new=$sv_dir/$sv_name.new
  sv_back=$sv_dir/$sv_name.back
  sv_old=$sv_dir/$sv_name.old
  p_home=$(base_home "$1") ||
    fail "the workspaces' folder of $1 does not read (work.toml's [work] storage; awk, sed, dirname or basename failed): nothing changed"
  if [ -d "$p_home/.workrift" ]; then
    state_dir "$1"
  else
    state_value=$p_home/.workrift
  fi
  sv_state=$state_value/subvolume
  readonly sv_base sv_parent sv_name sv_dir sv_new sv_back sv_old sv_state
  sv_is "$sv_new" new && sv_is "$sv_back" back && sv_is "$sv_old" old ||
    fail "$sv_base: its move folder would be $sv_dir, not a folder beside it under a parent of its own (a base directly under / is refused); nothing changed"
}

# Whether $1 is exactly this base's move path $2 (new, back or old), in a
# .subvolume-move folder beside the base under a parent that is not /.
sv_is() {
  [ "$1" = "$sv_dir/$sv_name.$2" ] && [ "$sv_dir" = "$sv_parent/.subvolume-move" ] &&
    case "$1" in /?*/.subvolume-move/?*.new | /?*/.subvolume-move/?*.back | /?*/.subvolume-move/?*.old) true ;; *) false ;; esac
}

# The state folder, made under the hold (the dry run makes nothing): the one
# state_dir resolves must be the one sv_paths named.
sv_state_make() {
  state_dir "$sv_base"
  [ "$state_value/subvolume" = "$sv_state" ] ||
    fail "the state folder resolves to $state_value, not ${sv_state%/*}; nothing changed"
  mkdir -p "$sv_state" || sv_stop "mkdir -p $sv_state (the state folder of the switch; nothing changed)"
}

# The kind of the path $1: - nothing, L a link, X no folder, S the root of a
# btrfs subvolume (inode 256 on btrfs), F a plain folder.
sv_kind() {
  if [ -L "$1" ]; then
    printf 'L\n'
  elif [ ! -e "$1" ]; then
    printf -- '-\n'
  elif [ ! -d "$1" ]; then
    printf 'X\n'
  else
    # A stat that fails is ? (unknown) and status 1, never F: a subvolume read
    # as a folder would take a switch past its exchange for one before it.
    local k_fs k_ino
    if ! k_fs=$(stat -f -c %T "$1" 2>/dev/null); then
      printf '?\n'
      return 1
    fi
    if [ "$k_fs" != btrfs ]; then
      printf 'F\n'
    elif ! k_ino=$(stat -c %i "$1" 2>/dev/null); then
      printf '?\n'
      return 1
    elif [ "$k_ino" = 256 ]; then
      printf 'S\n'
    else
      printf 'F\n'
    fi
  fi
}

# The kind of $2 into the variable $1, or a stop that says which path does
# not read (sv_kind's ? never reaches a decision).
sv_kind_of() {
  sv_read "$1" sv_kind "$2" || sv_stop "stat of $2 (whether it is a subvolume)"
}

sv_words() {
  case "$1" in
    S) printf 'a btrfs subvolume' ;;
    F) printf 'a plain folder' ;;
    -) printf 'nothing' ;;
    L) printf 'a symbolic link' ;;
    '?') printf 'unknown (its stat failed)' ;;
    *) printf 'no folder' ;;
  esac
}

sv_other() { if [ "$1" = S ]; then printf 'F\n'; else printf 'S\n'; fi; }
sv_copy_path() { if [ "$1" = S ]; then printf '%s\n' "$sv_new"; else printf '%s\n' "$sv_back"; fi; }
sv_copy_word() { if [ "$1" = S ]; then printf 'new\n'; else printf 'back\n'; fi; }
sv_whole() { [ -d "$1/.git" ] && [ -f "$1/work.toml" ]; }

# What a tree is, to know it again: a subvolume by its id, a folder by its
# inode.
#
# Fails when a read fails: an identity is recorded and compared before a
# delete, so it is never a `?` that two failed reads would make equal.
sv_identity() {
  local i_kind i_id
  i_kind=$(sv_kind "$1") || return 1
  case "$i_kind" in
    S) i_id=$(btrfs inspect-internal rootid "$1" 2>/dev/null) && [ -n "$i_id" ] || return 1
      printf 'subvolume %s\n' "$i_id" ;;
    F) i_id=$(stat -c %i "$1" 2>/dev/null) && [ -n "$i_id" ] || return 1
      printf 'folder %s\n' "$i_id" ;;
    *) printf '%s\n' "$i_kind" ;;
  esac
}

# The switch under way: sv_ph (none, copy, swap, carry, rollback, done,
# drop), sv_ph_source (copy or kept) and sv_ph_target (S or F).
sv_phase_read() {
  sv_ph=none
  sv_ph_source=
  sv_ph_target=
  [ -f "$sv_state/phase" ] || return 0
  # A record that is there but does not read is never "no switch under way":
  # a cut switch read as none would never carry what its old tree gained.
  if ! { read -r sv_ph sv_ph_source sv_ph_target <"$sv_state/phase"; } 2>/dev/null || [ -z "$sv_ph" ]; then
    sv_ph=none
    fail "the record of the switch, $sv_state/phase, is there but does not read: nothing changed"
  fi
}

# Writes the record of the switch whole (a file moved into place) or stops.
sv_phase_write() {
  mkdir -p "$sv_state" || sv_stop "mkdir -p $sv_state (the record of the switch: $*)"
  printf '%s\n' "$*" >"$sv_state/phase.$$" || sv_stop "the write of $sv_state/phase.$$ (the record of the switch: $*)"
  mv -f "$sv_state/phase.$$" "$sv_state/phase" || sv_stop "mv of the record of the switch into $sv_state/phase ($*)"
}

# One step: said (with the seconds since the start) and logged in the state
# folder. WORKRIFT_SUBVOLUME_DIE_AT=<step> kills the command there (kill -9 of
# itself), for tests only: a cut at every step must leave a whole base.
sv_step() {
  phase "$1: $2"
  sv_at=$1
  # The step log is read by a person after, and decides nothing: a log that
  # cannot be written is said, and the switch goes on (a stop there would
  # leave a switch half done for a line of text).
  sv_log_flush
  { mkdir -p "$sv_state" && printf '%s %s: %s\n' "$(date -u +%FT%TZ)" "$1" "$2" >>"$sv_state/log"; } 2>/dev/null ||
    printf 'workrift subvolume: the step log %s/log was not written (step %s); the switch goes on\n' "$sv_state" "$1" >&2
  # Tests only: a writer that lands at this step (WORKRIFT_SUBVOLUME_HOOK_AT,
  # a space-separated list of steps, runs WORKRIFT_SUBVOLUME_HOOK with the
  # step as $1), and a kill -9 of the command.
  case " ${WORKRIFT_SUBVOLUME_HOOK_AT:-} " in
    *" $1 "*) sh -c "$WORKRIFT_SUBVOLUME_HOOK" sv-hook "$1" </dev/null >&2 3>&- 6>&- 7>&- 8>&- 9>&- || true ;;
  esac
  [ "${WORKRIFT_SUBVOLUME_DIE_AT:-}" != "$1" ] || kill -KILL $$
}

# The pids in this base's lines (live tickets of its queues), and this one.
sv_line_pids() {
  local l_t
  for l_t in "$state_value"/base/*.[rw] "$state_value"/advance/*.[rw] "$state_value"/clone/*.[rw] "$state_value"/move/*.[rw]; do
    [ -f "$l_t" ] || continue
    ticket_live "$l_t" || continue
    sed -n 1p "$l_t" || return 1
  done
  printf '%s\n' "$$"
}

# Whether the process $1, or one it descends from, is in the line $2 (pids).
sv_in_line() {
  local i_pid="$1" i_n=0
  # A parent that does not read ends the walk: the process counts as outside
  # the line (waited for, or a refusal), never as in it.
  while [ -n "$i_pid" ] && [ "$i_pid" -gt 1 ] && [ "$i_n" -lt 64 ]; do
    case "
$2
" in *"
$i_pid
"*) return 0 ;; esac
    i_pid=$(process_parent "$i_pid") || return 1
    i_n=$((i_n + 1))
  done
  return 1
}

# The processes outside workrift's line that work in the folder $1 or hold a
# file open under it. One in line (a create waiting for the base, a remove,
# their children) writes nothing in the base until its turn, and by then it
# names the base by its path.
#
# Three answers, never two: `use <pid> <command>` a line for each process found
# there; `unknown <pid> <uid>` for each process the walk could not look into
# (its fd folder or working folder refused this user: another user's process,
# root's on the workbox), which may or may not be there; and a status 1 when
# the walk itself failed (anything but that refusal), which is never "nobody
# works there". A process that ends during the walk is none
# (-ignore_readdir_race); a kernel thread or a zombie holds no file, so it is
# never unknown.
sv_users() {
  local u_dir="$1" u_owners u_out u_line u_links='' u_rc='' u_pid u_rest u_seen=' ' u_ifs u_hidden=''
  u_owners=$(sv_line_pids) || return 1
  # find's refusals go to the capture as they come; the paths it found follow
  # it once it ended, each marked, so no line of one is cut by the other. Its
  # status is taken, never a set -e stop of the capture (which keeps -e).
  u_out=$({
    u_frc=0
    u_found=$(LC_ALL=C find "$proc_root" -ignore_readdir_race -mindepth 1 -maxdepth 3 \
      \( ! -path "$proc_root/[0-9]*" -prune \) -o \
      \( -path "$proc_root/[0-9]*/*" ! -path "$proc_root/[0-9]*/fd" ! -path "$proc_root/[0-9]*/fd/*" ! -path "$proc_root/[0-9]*/cwd" -prune \) -o \
      \( \( -lname "$u_dir" -o -lname "$u_dir/*" \) -print \) 2>&3) || u_frc=$?
    printf 'rc %s\n' "$u_frc"
    printf '%s\n' "$u_found" | while IFS= read -r u_line; do [ -z "$u_line" ] || printf 'L %s\n' "$u_line"; done
  } 3>&1) || return 1
  while IFS= read -r u_line; do
    case "$u_line" in
      'L '*) u_links="$u_links${u_line#L }
" ;;
      'rc '*) u_rc=${u_line#rc } ;;
      *)
        # A refusal of one process's fd or working folder names an unknown
        # process; any other message is a failed walk.
        u_rest=${u_line#"find: "}
        u_rest=${u_rest#"'"}
        case "$u_rest" in "$proc_root"/*) ;; *) return 1 ;; esac
        u_rest=${u_rest#"$proc_root"/}
        u_pid=${u_rest%%/*}
        case "$u_pid" in '' | *[!0-9]*) return 1 ;; esac
        case "${u_rest#"$u_pid"}" in
          "/fd': Permission denied" | "/cwd': Permission denied" | "/fd: Permission denied" | "/cwd: Permission denied") ;;
          *) return 1 ;;
        esac
        case "$u_hidden" in *" $u_pid "*) ;; *) u_hidden="${u_hidden:- }$u_pid " ;; esac
        ;;
    esac
  done <<EOF
$u_out
EOF
  case "$u_rc" in
    0) ;;
    '' | *[!0-9]*) return 1 ;;
    *) [ -n "$u_hidden" ] || return 1 ;;
  esac
  u_ifs=$IFS
  IFS='
'
  set -f
  for u_line in $u_links; do
    u_pid=${u_line#"$proc_root"/}
    u_pid=${u_pid%%/*}
    case "$u_seen" in *" $u_pid "*) continue ;; esac
    u_seen="$u_seen$u_pid "
    ! sv_in_line "$u_pid" "$u_owners" || continue
    # The name is for a person only.
    printf 'use %s %s\n' "$u_pid" "$(cat "$proc_root/$u_pid/comm" 2>/dev/null || printf '?')"
  done
  set +f
  IFS=$u_ifs
  for u_pid in $u_hidden; do
    case "$u_seen" in *" $u_pid "*) continue ;; esac
    sv_unknown_pid "$u_pid" "$u_owners" || return 1
  done
}

# Prints `unknown <pid> <uid>` for the process $1 the walk could not look into,
# unless it holds no file (gone, a kernel thread, a zombie) or is in the line
# $2. Its stat and status are readable by anyone: one that does not read while
# the process is still there fails.
sv_unknown_pid() {
  local k_pid="$1" k_owners="$2" k_stat k_state k_flags k_key k_value k_uid='?'
  [ -e "$proc_root/$k_pid" ] || return 0
  if ! { IFS= read -r k_stat <"$proc_root/$k_pid/stat"; } 2>/dev/null; then
    [ -e "$proc_root/$k_pid" ] || return 0
    return 1
  fi
  # The fields after the command name (which may hold spaces and parentheses):
  # the state, then the flags as the seventh; PF_KTHREAD is 0x00200000.
  k_stat=${k_stat##*) }
  set -f
  # shellcheck disable=SC2086 # split into its fields on purpose
  set -- $k_stat
  set +f
  k_state=${1:-}
  k_flags=${7:-}
  case "$k_flags" in '' | *[!0-9]*) return 1 ;; esac
  [ "$k_state" != Z ] || return 0
  [ $((k_flags & 0x200000)) -eq 0 ] || return 0
  ! sv_in_line "$k_pid" "$k_owners" || return 0
  if { while read -r k_key k_value _; do [ "$k_key" != Uid: ] || k_uid=$k_value; done <"$proc_root/$k_pid/status"; } 2>/dev/null; then :; else
    [ -e "$proc_root/$k_pid" ] || return 0
    return 1
  fi
  printf 'unknown %s %s\n' "$k_pid" "$k_uid"
}

# The processes in the folder $1, every one known, into sv_users_found (`pid
# command` a line). Unknown ones (sv_users) are read again with privilege
# where sudo -n works: a read-only find of exactly their fd and working
# folders, its command line in the step log. Where it does not, the switch
# goes on beside them only with --beside-unreadable (said in the step log);
# else status 2, sv_why naming them and the two ways on. Status 1 with sv_why
# when a walk fails.
sv_users_known() {
  local k_all k_line k_users='' k_unknown='' k_n=0 k_uids=' ' k_pid k_uid k_found
  sv_users_found=
  sv_read k_all sv_users "$1" || { sv_why="the processes in $1 do not read (find over $proc_root failed)"; return 1; }
  while IFS= read -r k_line; do
    case "$k_line" in
      'use '*) k_users="$k_users${k_line#use }
" ;;
      'unknown '*)
        k_line=${k_line#unknown }
        k_pid=${k_line%% *}
        k_uid=${k_line#* }
        k_unknown="$k_unknown $k_pid"
        k_n=$((k_n + 1))
        case "$k_uids" in *" $k_uid "*) ;; *) k_uids="$k_uids$k_uid " ;; esac
        ;;
    esac
  done <<EOF
$k_all
EOF
  k_uids=${k_uids# }
  k_uids=${k_uids% }
  if [ "$k_n" -gt 0 ]; then
    if sudo -n true 2>/dev/null; then
      sv_log "the walk could not look into $k_n process(es) of uid $k_uids; read again with privilege, read only:"
      for k_pid in $k_unknown; do
        sv_log "  sudo -n find $proc_root/$k_pid/fd $proc_root/$k_pid/cwd -maxdepth 1 ( -lname $1 -o -lname $1/* ) -print"
        if ! k_found=$(sudo -n find "$proc_root/$k_pid/fd" "$proc_root/$k_pid/cwd" -maxdepth 1 \( -lname "$1" -o -lname "$1/*" \) -print 2>/dev/null); then
          # One gone meanwhile holds nothing.
          [ ! -e "$proc_root/$k_pid" ] || { sv_why="the privileged read of process $k_pid failed (sudo -n find over $proc_root/$k_pid)"; return 1; }
          continue
        fi
        [ -z "$k_found" ] || k_users="$k_users$k_pid $(cat "$proc_root/$k_pid/comm" 2>/dev/null || printf '?') (uid $(sv_uid_of "$k_pid"), read with sudo)
"
      done
    elif [ "${sv_beside_unreadable:-no}" = yes ]; then
      sv_log "beside $k_n process(es) of uid $k_uids it could not look into (--beside-unreadable; no sudo -n here): pids$k_unknown"
    else
      sv_why="$k_n process(es) of uid $k_uids could not be looked into (their open files and working folders are another user's), so one in $1 cannot be ruled out: run it where sudo -n works (it reads them, read only), or pass --beside-unreadable to run beside them"
      sv_unknown_next="$(sv_command "$sv_mode") where sudo -n works, or $(sv_beside_unreadable_command "$sv_mode")"
      return 2
    fi
  fi
  sv_users_found=${k_users%
}
}

# The uid of the process $1 (status), ? if it does not read.
sv_uid_of() {
  local o_key o_value o_uid='?'
  { while read -r o_key o_value _; do [ "$o_key" != Uid: ] || o_uid=$o_value; done <"$proc_root/$1/status"; } 2>/dev/null || :
  printf '%s' "$o_uid"
}

# A line for a person on stderr now, and in the step log with the next step
# (the log of the last switch is replaced only once this one starts) or a
# refusal under the hold.
sv_log() {
  local l_at
  printf 'workrift subvolume: %s\n' "$1" >&2
  l_at=$(date -u +%FT%TZ) || l_at='(no clock)'
  sv_log_held="${sv_log_held:-}$l_at $1
"
}

# Writes the lines sv_log holds into the step log; one that cannot be written
# is said, and the switch goes on (the log decides nothing).
sv_log_flush() {
  [ -n "${sv_log_held:-}" ] && [ -d "${sv_state:-}" ] || return 0
  { printf '%s' "$sv_log_held" >>"$sv_state/log"; } 2>/dev/null ||
    printf 'workrift subvolume: the step log %s/log was not written; the switch goes on\n' "$sv_state" >&2
  sv_log_held=
}

# Whether the process $1 is another user's (its uid printed): a read of its
# working folder, environment or open files is then refused this user, and
# what it would tell is unknown. Its status is readable by anyone; one that
# does not read, or this user's own process, is no other user's.
sv_foreign() {
  local f_uid
  f_uid=$(sv_uid_of "$1")
  case "$f_uid" in '' | *[!0-9]*) return 1 ;; esac
  [ "$f_uid" != "$sv_my_uid" ] || return 1
  printf '%s' "$f_uid"
}

# Removals running or in line, `this|other pid what` a line: a workrift remove
# or prune, a work rm or gc, an rm under the base's workspaces, a delete in the
# clone turn's line. `this` is a removal of this base (an argument, its
# working folder or its WORKRIFT_SOURCE names the base or its workspaces);
# `other` one of another base, or of none it can tell, named with its working
# folder.
#
# A read that fails for a process still there (its command line, working
# folder or environment) makes it `this … (does not read)`: a removal it cannot
# rule out is refused, never taken for none. A process gone meanwhile is none.
# Another user's process, whose reads are refused this user, is `unknown pid
# uid (what)`: the third answer, never none and never this base's.
sv_removals() {
  local r_home r_c r_pid r_t r_what r_cwd r_args r_env r_rec r_uid
  r_home=$(base_home "$sv_base") || return 1
  for r_c in "$proc_root"/[0-9]*/cmdline; do
    r_pid=${r_c%/cmdline}
    r_pid=${r_pid##*/}
    [ "$r_pid" != "$$" ] || continue
    if [ ! -r "$r_c" ]; then
      [ -e "$r_c" ] || continue
      if r_uid=$(sv_foreign "$r_pid"); then
        printf 'unknown %s %s (its command line)\n' "$r_pid" "$r_uid"
      else
        printf 'this %s (its command line does not read)\n' "$r_pid"
      fi
      continue
    fi
    if ! r_args=$(tr '\0' '\n' <"$r_c" 2>/dev/null); then
      [ ! -e "$proc_root/$r_pid" ] || printf 'this %s (its command line does not read)\n' "$r_pid"
      continue
    fi
    [ -n "$r_args" ] || continue
    if ! r_what=$(printf '%s\n' "$r_args" | awk -v home="$r_home" -v base="$sv_base" '
      function here(p) { return p == home || index(p, home "/") == 1 || p == base || index(p, base "/") == 1 }
      { a[NR] = $0 }
      END {
        for (i = 1; i <= NR; i++) {
          n = a[i]; sub(/.*\//, "", n); w = ""
          if (n ~ /^workrift/) for (j = i + 1; j <= NR; j++) if (a[j] == "remove" || a[j] == "prune") { w = "workrift " a[j]; break }
          if (w == "" && n == "work") for (j = i + 1; j <= NR; j++) if (a[j] == "rm" || a[j] == "gc") { w = "work " a[j]; break }
          if (w == "" && i == 1 && n == "rm") for (j = 2; j <= NR; j++) if (here(a[j])) { print "this rm under " home; exit }
          if (w == "") continue
          for (j = i + 1; j <= NR; j++) if (here(a[j])) { print "this " w; exit }
          print "other " w; exit
        }
      }'); then
      printf 'this %s (awk failed on its command line)\n' "$r_pid"
      continue
    fi
    [ -n "$r_what" ] || continue
    case "$r_what" in
      other\ *)
        if ! r_cwd=$(readlink "$proc_root/$r_pid/cwd" 2>/dev/null); then
          r_cwd='?'
          if [ ! -e "$proc_root/$r_pid" ]; then
            :
          elif r_uid=$(sv_foreign "$r_pid"); then
            printf 'unknown %s %s (%s: its working folder and environment, which tell its base)\n' "$r_pid" "$r_uid" "${r_what#other }"
            continue
          else
            r_what="this ${r_what#other } (its working folder does not read)"
          fi
        fi
        case "$r_cwd" in
          "$sv_base" | "$sv_base"/* | "$r_home" | "$r_home"/*) r_what="this ${r_what#other }" ;;
        esac
        case "$r_what" in
          other\ *)
            if ! r_env=$(tr '\0' '\n' <"$proc_root/$r_pid/environ" 2>/dev/null); then
              if [ ! -e "$proc_root/$r_pid" ]; then
                :
              elif r_uid=$(sv_foreign "$r_pid"); then
                printf 'unknown %s %s (%s: its environment, which tells its base)\n' "$r_pid" "$r_uid" "${r_what#other }"
                continue
              else
                r_what="this ${r_what#other } (its environment does not read)"
              fi
            else
              case "
$r_env
" in *"
WORKRIFT_SOURCE=$sv_base
"*) r_what="this ${r_what#other }" ;; esac
            fi
            ;;
        esac
        ;;
    esac
    case "$r_what" in
      this\ *) printf 'this %s %s\n' "$r_pid" "${r_what#this }" ;;
      *) printf 'other %s %s (in %s)\n' "$r_pid" "${r_what#other }" "${r_cwd:-?}" ;;
    esac
  done
  for r_t in "$state_value"/clone/*.[rw]; do
    [ -f "$r_t" ] && ticket_live "$r_t" || continue
    if ! r_rec=$(sed -n '1p;4p' "$r_t"); then
      printf 'this ? (the clone ticket %s does not read)\n' "$r_t"
      continue
    fi
    case "${r_rec#*
}" in
      delete\ *) printf 'this %s %s\n' "${r_rec%%
*}" "${r_rec#*
}" ;;
    esac
  done
}

# Whether the process $1 runs a workrift that takes tickets: a script file it
# holds open (a shell reads its script through an open descriptor) is a
# workrift's and has queue_enter. An older workrift (before the tickets) takes
# no place in line, so it is never waited for; a file replaced since is read
# through the descriptor, not the path.
sv_runs_tickets() {
  local t_fd t_paths t_path
  if [ -d "$identity_proc/$1/fd" ]; then
    for t_fd in "$identity_proc/$1/fd"/*; do
      [ -f "$t_fd" ] || continue
      [ "$(sed -n 3p "$t_fd" 2>/dev/null)" = '# Branch workspaces on top of Rift.' ] || continue
      ! grep -q '^queue_enter() {' "$t_fd" 2>/dev/null || return 0
    done
    return 1
  fi
  command -v lsof >/dev/null 2>&1 || return 1
  t_paths=$(lsof -a -p "$1" -Fn 2>/dev/null | sed -n 's/^n//p')
  printf '%s\n' "$t_paths" | while IFS= read -r t_path; do
    [ -f "$t_path" ] && [ "$(sed -n 3p "$t_path" 2>/dev/null)" = '# Branch workspaces on top of Rift.' ] &&
      grep -q '^queue_enter() {' "$t_path" 2>/dev/null && printf 'yes\n'
  done | grep -q yes
}

# workrift processes outside the line that run an older script: `pid what`.
#
# A process still there whose command line does not read is named (`does not
# read`): one it cannot rule out is refused, never taken for none.
sv_old_workrifts() {
  local o_c o_pid o_owners o_what o_args o_uid
  o_owners=$(sv_line_pids) || return 1
  for o_c in "$proc_root"/[0-9]*/cmdline; do
    o_pid=${o_c%/cmdline}
    o_pid=${o_pid##*/}
    [ "$o_pid" != "$$" ] || continue
    if [ ! -r "$o_c" ]; then
      [ -e "$o_c" ] || continue
      if o_uid=$(sv_foreign "$o_pid"); then
        printf 'unknown %s %s (its command line)\n' "$o_pid" "$o_uid"
      else
        printf '%s ? (its command line does not read)\n' "$o_pid"
      fi
      continue
    fi
    if ! o_args=$(tr '\0' '\n' <"$o_c" 2>/dev/null); then
      [ ! -e "$proc_root/$o_pid" ] || printf '%s ? (its command line does not read)\n' "$o_pid"
      continue
    fi
    [ -n "$o_args" ] || continue
    if ! o_what=$(printf '%s\n' "$o_args" | awk '
      { a[NR] = $0 }
      END { for (i = 1; i < NR; i++) { n = a[i]; sub(/.*\//, "", n); if (n ~ /^workrift/ && a[i + 1] ~ /^(init|create|refresh|advance|deps|hold|settings|remove|prune)$/) { print a[i + 1]; exit } } }'); then
      printf '%s ? (awk failed on its command line)\n' "$o_pid"
      continue
    fi
    [ -n "$o_what" ] || continue
    ! sv_in_line "$o_pid" "$o_owners" || continue
    # Another user's: its open files, which tell whether its script takes
    # tickets, are refused this user.
    if [ -d "$identity_proc/$o_pid/fd" ] && [ ! -r "$identity_proc/$o_pid/fd" ] && o_uid=$(sv_foreign "$o_pid"); then
      printf 'unknown %s %s (workrift %s: its open files, which tell whether it takes a place in line)\n' "$o_pid" "$o_uid" "$o_what"
      continue
    fi
    ! sv_runs_tickets "$o_pid" || continue
    printf '%s workrift %s (an older script: it takes no place in line)\n' "$o_pid" "$o_what"
  done
}

# Git's lock and gc files in the base's Git directory (workrift.lock, the
# older workrift's lock file, is the line's).
# A read that fails is a line of its own (never an empty list, "no lock").
sv_git_locks() {
  local g_dir g_list
  if ! g_dir=$(base_git "$1" rev-parse --absolute-git-dir 2>/dev/null); then
    printf '(git rev-parse --absolute-git-dir failed in %s: its locks are unknown)\n' "$1"
    return 0
  fi
  if ! g_list=$(find "$g_dir" -maxdepth 1 \( -name gc.pid -o -name '*.lock' \) ! -name workrift.lock 2>/dev/null); then
    printf '(find failed in %s: its locks are unknown)\n' "$g_dir"
  fi
  sv_lines "$g_list"
  if ! g_list=$(find "$g_dir/refs" -name '*.lock' 2>/dev/null); then
    printf '(find failed in %s/refs: its locks are unknown)\n' "$g_dir"
  fi
  sv_lines "$g_list"
}

# The btrfs state folder (/sys/fs/btrfs/<uuid>) of the file system holding
# the base, found by its device; empty when none. Fails when findmnt fails.
sv_fs_dir() {
  local f_source f_dev f_uuid
  f_source=$(findmnt -n -o SOURCE --target "$sv_base" 2>/dev/null) || return 1
  f_source=${f_source%%
*}
  f_source=${f_source%%\[*}
  [ -n "$f_source" ] || return 0
  for f_dev in "$sv_sysfs"/*/devices/"${f_source##*/}"; do
    if [ -e "$f_dev" ]; then
      printf '%s\n' "${f_dev%/devices/*}"
      return 0
    fi
  done
  f_uuid=$(findmnt -n -o UUID --target "$sv_base" 2>/dev/null) || f_uuid=
  [ -z "$f_uuid" ] || [ ! -d "$sv_sysfs/$f_uuid" ] || printf '%s\n' "$sv_sysfs/$f_uuid"
}

sv_check() {
  if [ "$1" = ok ]; then
    printf '  ok    %s\n' "$2"
  else
    printf '  NO    %s\n' "$2"
    sv_refused=true
  fi
}

# The checks before a switch ($1: copy or kept), one line each; sets
# sv_refused. Read-only.
sv_preflight() {
  local p_opts p_fs p_total p_used p_slack p_df p_avail p_pct p_list
  sv_refused=false
  printf 'preflight:\n'
  # Every read here is checked: one that fails is a NO of its own, never a
  # value (an empty, a 0) that a check then passes or refuses for the wrong
  # reason.
  if ! sv_read p_opts findmnt -n -o OPTIONS --target "$sv_base"; then
    sv_check no "findmnt -o OPTIONS --target $sv_base failed: the mount options are unknown"
  else
    case ",$p_opts," in
      *,user_subvol_rm_allowed,*) sv_check ok 'the mount has user_subvol_rm_allowed (a workspace is deleted without sudo)' ;;
      *) sv_check no "the mount of $sv_base lacks user_subvol_rm_allowed (options: ${p_opts:-unknown})" ;;
    esac
  fi
  if ! sv_read p_fs sv_fs_dir; then
    sv_check no "findmnt -o SOURCE --target $sv_base failed: quotas and metadata are unknown"
  elif [ -z "$p_fs" ]; then
    sv_check no "cannot find the file system's state under $sv_sysfs: quotas and metadata are unknown"
  else
    if [ -d "$p_fs/qgroups" ]; then
      sv_check no "quotas are on ($p_fs/qgroups): every snapshot delete would recount shared extents"
    else
      sv_check ok 'quotas are off'
    fi
    if [ "$1" = copy ]; then
      # A size that does not read is no 0: a used size read as 0 would pass
      # the gate with the whole total as slack.
      p_total=
      p_used=
      { sv_read p_total cat "$p_fs/allocation/metadata/total_bytes" && sv_read p_used cat "$p_fs/allocation/metadata/bytes_used"; } 2>/dev/null || true
      case "$p_total:$p_used" in
        *[!0-9:]* | :* | *:) p_slack= ;;
        *) p_slack=$(((p_total - p_used) / 1048576)) ;;
      esac
      if [ -z "$p_slack" ]; then
        sv_check no "the metadata sizes under $p_fs/allocation/metadata do not read (total '${p_total}', used '${p_used}'): the slack is unknown"
      elif [ "$p_slack" -ge "$sv_min_slack_mib" ]; then
        sv_check ok "metadata slack ${p_slack} MiB >= ${sv_min_slack_mib} MiB (a copy costs about ${sv_meta_mib} MiB)"
      else
        sv_check no "metadata slack ${p_slack} MiB < ${sv_min_slack_mib} MiB (a copy costs about ${sv_meta_mib} MiB; metadata cannot grow)"
      fi
    fi
  fi
  if [ "$1" = copy ]; then
    sv_read p_df df -Pk "$sv_base" 2>/dev/null || p_df=
    # The second line's fourth and fifth fields, by the shell (no pipe whose
    # first command's failure the last would hide).
    p_df=${p_df#*
}
    p_df=${p_df%%
*}
    p_avail=
    p_pct=
    # shellcheck disable=SC2034 # the fields before and after are skipped
    read -r p_dev p_blocks p_usedk p_avail p_pct p_rest <<EOF || true
$p_df
EOF
    p_df="$p_avail $p_pct"
    p_avail=${p_df%% *}
    p_pct=${p_df#* }
    p_pct=${p_pct%\%}
    case "$p_avail:$p_pct" in
      *[!0-9:]* | :* | *:) sv_check no "df -Pk $sv_base does not read: $p_df" ;;
      *)
        if [ $((p_avail / 1024)) -ge "$sv_min_free_mib" ] && [ "$p_pct" -lt "$sv_max_used_pct" ]; then
          sv_check ok "free $((p_avail / 1024)) MiB >= ${sv_min_free_mib} MiB, used ${p_pct}% < ${sv_max_used_pct}%"
        else
          sv_check no "free $((p_avail / 1024)) MiB (needs ${sv_min_free_mib}), used ${p_pct}% (needs < ${sv_max_used_pct}%)"
        fi
        ;;
    esac
  fi
  if python3 -c 'import ctypes' >/dev/null 2>&1; then
    sv_check ok 'python3 makes the exchange (renameat2 RENAME_EXCHANGE)'
  else
    sv_check no 'no python3 with ctypes: nothing can make the exchange'
  fi
  sv_preflight_live
}

# The lines of $1 joined by `; `, for a message (no fork, no pipe).
sv_joined() {
  local j_out='' j_line
  while IFS= read -r j_line; do
    [ -z "$j_line" ] || j_out="${j_out:+$j_out; }$j_line"
  done <<EOF
$1
EOF
  printf '%s' "$j_out"
}

# The checks that can change at any moment: again under the hold. Each list
# is read through sv_read: a walk that failed is a NO of its own, never an
# empty list that reads as "nobody there".
sv_preflight_live() {
  local p_list p_this='' p_other='' p_n=0 p_line p_unknown='' p_old=''
  if ! sv_read p_list sv_removals; then
    sv_check no "the removals running do not read (the workspaces' folder of $sv_base does not read): a removal of it cannot be ruled out"
  else
    while IFS= read -r p_line; do
      case "$p_line" in
        this\ *) p_this="$p_this${p_line#this }
" ;;
        other\ *) p_other="$p_other${p_line#other }
"
          p_n=$((p_n + 1)) ;;
        unknown\ *) p_unknown="$p_unknown${p_line#unknown }
" ;;
      esac
    done <<EOF
$p_list
EOF
    if [ -z "$p_this" ]; then
      sv_check ok "no removal of $sv_base runs or waits (workrift remove or prune, work rm or gc, rm under its workspaces)"
    else
      sv_check no "a removal of $sv_base runs; let it end: $(sv_joined "$p_this")"
    fi
    if [ -z "$p_other" ]; then
      sv_check ok 'no removal of another base runs'
    elif [ "$sv_beside" = no ]; then
      sv_check no "$p_n removal(s) of another base run, which slow the copy (they share the file system's metadata); pause them, or run beside them with --beside-other-removals: $(sv_joined "$p_other")"
    else
      [ "$p_n" -le "$sv_beside" ] || sv_beside=$p_n
      sv_check ok "beside $p_n removal(s) of another base (--beside-other-removals): $(sv_joined "$p_other")"
    fi
  fi
  if ! sv_read p_list sv_old_workrifts; then
    sv_check no "the workrift processes do not read (the pids of the line do not read): an older workrift cannot be ruled out"
  else
    while IFS= read -r p_line; do
      case "$p_line" in
        '') ;;
        unknown\ *) p_unknown="$p_unknown${p_line#unknown }
" ;;
        *) p_old="$p_old$p_line
" ;;
      esac
    done <<EOF
$p_list
EOF
    if [ -z "$p_old" ]; then
      sv_check ok 'no older workrift (one that takes no place in line) runs'
    else
      sv_check no "an older workrift runs, which would not wait for the switch; let it end: $(sv_joined "$p_old")"
    fi
  fi
  # Another user's removal or workrift whose base, or whose place in line,
  # this user cannot read: the third answer. sudo -n reads only fd and
  # working folders (find, readlink), not an environment or a script, so it
  # cannot settle these: refused unless --beside-unreadable.
  if [ -n "$p_unknown" ]; then
    if [ "${sv_beside_unreadable:-no}" = yes ]; then
      sv_check ok "beside another user's processes it cannot read (--beside-unreadable): $(sv_joined "$p_unknown")"
      sv_log "beside another user's processes it cannot read (--beside-unreadable): $(sv_joined "$p_unknown")"
    else
      sv_check no "another user's processes may be a removal of this base or an older workrift, and their reads are refused this user (pid uid (what)): $(sv_joined "$p_unknown"); let them end, or pass --beside-unreadable to run beside them"
      sv_next="$(sv_beside_unreadable_command "$sv_mode") (beside them), or $(sv_command "$sv_mode") once they ended"
    fi
  fi
  sv_rc=0
  sv_users_known "$sv_base" || sv_rc=$?
  case $sv_rc in
    0)
      if [ -z "$sv_users_found" ]; then
        sv_check ok "no process outside workrift's line works in $sv_base or holds a file open in it"
      else
        sv_check no "processes outside workrift's line work in $sv_base (run this from outside it; end them): $(sv_joined "$sv_users_found")"
      fi
      ;;
    2)
      sv_check no "$sv_why"
      # An unknown removal or workrift above has no sudo way on: its next stays.
      [ -n "$p_unknown" ] || sv_next=$sv_unknown_next
      ;;
    *) sv_check no "$sv_why: a process in it cannot be ruled out" ;;
  esac
  p_list=$(sv_git_locks "$sv_base")
  if [ -z "$p_list" ]; then
    sv_check ok 'no Git lock or gc file in the base'
  else
    sv_check no "Git lock or gc files in the base: $(sv_joined "$p_list")"
  fi
}

# The command that goes on from here, said in sv_facts: a caller that knows
# better sets sv_next. Run from anywhere: it names the base itself.
sv_command() {
  case "$1" in
    S) printf 'cd / && WORKRIFT_SOURCE=%s workrift subvolume --apply' "$sv_base" ;;
    F) printf 'cd / && WORKRIFT_SOURCE=%s workrift subvolume --back --apply' "$sv_base" ;;
    drop) printf 'cd / && WORKRIFT_SOURCE=%s workrift subvolume --drop-old --apply' "$sv_base" ;;
  esac
  [ "${sv_beside_unreadable:-no}" = no ] || printf ' --beside-unreadable'
}

# sv_command $1 with --beside-unreadable.
sv_beside_unreadable_command() {
  case "${sv_beside_unreadable:-no}" in
    yes) sv_command "$1" ;;
    *) printf '%s --beside-unreadable' "$(sv_command "$1")" ;;
  esac
}

# The two facts every end of workrift subvolume but a success says after its
# reason (fail, or the exit trap after a set -e stop): the state both trees
# are in, from the paths and the record of the switch, and the exact command
# that goes on. Reads only; a read that fails is said as unknown. Its reads
# fork at most four times (stat, through sv_kind), so a host that cannot fork
# still gets the record's words and the command.
sv_facts() {
  local f_kb f_ko f_kc f_ph f_src f_tg f_copy f_where f_next
  if [ -z "${sv_base:-}" ] || [ -z "${sv_state:-}" ]; then
    printf 'workrift subvolume: state: the base is not read yet; nothing changed\n'
    printf 'workrift subvolume: next: %s\n' "${sv_next:-fix the cause above, then run the same command again}"
    return 0
  fi
  f_ph=none
  f_src=
  f_tg=
  if [ -f "$sv_state/phase" ]; then
    # shellcheck disable=SC2034 # f_src: the record's middle field, unused here
    { read -r f_ph f_src f_tg <"$sv_state/phase"; } 2>/dev/null || f_ph=unreadable
  fi
  f_kb=$(sv_kind "$sv_base") || f_kb='?'
  f_ko=$(sv_kind "$sv_old") || f_ko='?'
  f_where="$sv_base is $(sv_words "$f_kb") (the live base); $sv_old is $(sv_words "$f_ko")"
  for f_copy in "$sv_new" "$sv_back"; do
    f_kc=$(sv_kind "$f_copy") || f_kc='?'
    [ "$f_kc" = - ] || f_where="$f_where; $f_copy is $(sv_words "$f_kc") (a copy, never the base)"
  done
  case "$f_ph:$f_kb" in
    copy:"$f_tg" | swap:"$f_tg" | carry:"$f_tg" | rollback:"$f_tg")
      f_where="$f_where; a switch to $(sv_words "$f_tg") exchanged and is not finished" ;;
    copy:* | swap:* | rollback:*)
      f_where="$f_where; a switch to $(sv_words "$f_tg") stopped before its exchange: the base never moved" ;;
    carry:*) f_where="$f_where; a switch to $(sv_words "$f_tg") is recorded after its exchange, but the base is not $(sv_words "$f_tg"): look at both trees" ;;
    drop:*) f_where="$f_where; a --drop-old was cut short" ;;
    switched:*) f_where="$f_where; the last switch finished" ;;
    unreadable:*) f_where="$f_where; the record $sv_state/phase does not read" ;;
    *) f_where="$f_where; no switch is under way" ;;
  esac
  printf 'workrift subvolume: state: %s\n' "$f_where"
  if [ -n "${sv_next:-}" ]; then
    f_next=$sv_next
  else
    case "$f_ph" in
      copy | swap | carry | rollback)
        f_next="$(sv_command "$f_tg") (it finishes the switch to $(sv_words "$f_tg"); stopped before its exchange, it deletes its copy and switches again)" ;;
      drop) f_next="$(sv_command drop) (it finishes the drop)" ;;
      unreadable) f_next="look at $sv_state/phase (it names the switch under way), then $(sv_command "${sv_mode:-S}")" ;;
      *) f_next="$(sv_command "${sv_mode:-S}") once the cause above is gone (nothing of a switch is under way)" ;;
    esac
  fi
  printf 'workrift subvolume: next: %s\n' "$f_next"
}

# A command that failed where no check of its own stops the switch: fails
# with what it was and its status (sv_facts adds the state and the command).
# `cmd || sv_stop "what cmd did"`: $? is still cmd's on entry.
sv_stop() {
  sv_stop_status $? "$1"
}

# sv_stop with the status given: for a handler that runs a command first.
sv_stop_status() {
  fail "$2 failed (status $1) at the step ${sv_at:-start}"
}

# The lines of $1, none when it is empty (printf '%s\n' "" would make one).
sv_lines() {
  [ -z "$1" ] || printf '%s\n' "$1"
}

# The names of every ref the store of the tree $1 holds, read from the store
# itself: the files under .git/refs (but lock files) and the names in
# packed-refs. A ref Git cannot resolve is among them. Fails when a read fails,
# or when the refs are not kept in files (reftable: no such listing).
sv_ref_store() {
  local s_dir="$1/.git" s_loose s_packed='' s_format
  if s_format=$(base_git "$1" config --get extensions.refStorage); then
    [ "$s_format" = files ] || return 1
  elif [ $? -ne 1 ]; then
    return 1
  fi
  s_loose=$(find "$s_dir/refs" -type f ! -name '*.lock' -print) || return 1
  if [ -e "$s_dir/packed-refs" ]; then
    s_packed=$(awk '/^[#^]/ { next } NF >= 2 { print $2 }' "$s_dir/packed-refs") || return 1
  fi
  {
    sv_lines "$s_loose" | awk -v p="$s_dir/" 'index($0, p) == 1 { print substr($0, length(p) + 1) }'
    sv_lines "$s_packed"
  } | LC_ALL=C sort -u
}

# The base's refs, `oid ref` a line, sorted; fails when Git cannot list them.
# Never a pipe from Git: a pipeline's status is its last command's, so a Git
# that failed (a fork refused on a loaded host) read as a tree with no refs,
# and a carry from it deleted every ref it had carried before (census, r3).
#
# Strict: Git skips a ref it cannot resolve and still exits 0 (a broken ref
# with a warning, a symbolic ref to nothing with no word), and a carry would
# take the skipped ref for one deleted there. So anything Git says on stderr is
# a failure, and so is a ref the store holds that the list lacks: the store's
# own names (sv_ref_store) are the proof the list is whole, which no word of
# Git's is. A ref made or packed between the two reads is read again (3 tries);
# one that stays missing is named on stderr, and the read fails.
sv_refs() {
  local r_out r_line r_list r_err r_rc r_store r_skipped r_try=1
  while :; do
    r_store=$(sv_ref_store "$1") || {
      printf 'workrift subvolume: the ref store of %s does not read (find or awk failed, or refs not in files)\n' "$1" >&2
      return 1
    }
    # Git's stderr to the capture as it comes, the list after it, marked.
    r_out=$({
      r_rc=0
      r_list=$(base_git "$1" for-each-ref --format='%(objectname) %(refname)' 2>&3) || r_rc=$?
      printf 'rc %s\n' "$r_rc"
      while IFS= read -r r_line; do
        [ -z "$r_line" ] || printf 'L %s\n' "$r_line"
      done <<EOF
$r_list
EOF
    } 3>&1) || return 1
    r_list=
    r_err=
    r_rc=
    while IFS= read -r r_line; do
      case "$r_line" in
        'L '*) r_list="$r_list${r_line#L }
" ;;
        'rc '*) r_rc=${r_line#rc } ;;
        '') ;;
        *) r_err="$r_err$r_line
" ;;
      esac
    done <<EOF
$r_out
EOF
    if [ "$r_rc" != 0 ] || [ -n "$r_err" ]; then
      [ -z "$r_err" ] || printf 'workrift subvolume: git for-each-ref in %s said: %s\n' "$1" "$(sv_joined "$r_err")" >&2
      return 1
    fi
    r_skipped=$(printf '%s--\n%s\n' "$r_list" "$r_store" | awk '$0 == "--" { s = 1; next } !s { g[$2] = 1; next } $0 != "" && !($0 in g)') || return 1
    [ -n "$r_skipped" ] || break
    if [ "$r_try" -ge 3 ]; then
      printf 'workrift subvolume: refs in the store of %s that git for-each-ref skips (broken, or a symbolic ref to nothing; repair or delete them): %s\n' "$1" "$(sv_joined "$r_skipped")" >&2
      return 1
    fi
    r_try=$((r_try + 1))
  done
  sv_lines "${r_list%
}" | LC_ALL=C sort
}

# What a copy must reproduce: HEAD, refs, status (untracked files too), lock
# files and Git's own files (config, info, hooks). Fails when a read fails.
sv_digest() {
  base_git "$1" symbolic-ref -q HEAD || base_git "$1" rev-parse HEAD || return 1
  sv_refs "$1" || return 1
  base_git "$1" --no-optional-locks status --porcelain=v2 --branch --untracked-files=all || return 1
  lock_fingerprint "$1" || return 1
  sv_git_files "$1" || return 1
}

# The object store of the tree $1, a line a file: the listings of
# objects/pack, objects/info (the commit-graph chain too), the loose folders
# and any quarantine, each file with its size and, but for the packs (large,
# and never rewritten under one name), its checksum. A fetch or a repack that
# lands while the copy walks the tree changes it. Fails when a walk fails
# (never a short list that two failed walks would make equal).
sv_store() {
  local s_files s_packs s_line s_list
  [ -d "$1/.git/objects" ] || return 1
  s_files=$(cd "$1/.git/objects" && find . -type f ! -name '*.pack' -exec cksum {} +) || return 1
  s_packs=$(cd "$1/.git/objects" && find . -type f -name '*.pack' -exec wc -c {} +) || return 1
  s_list=$s_files
  while IFS= read -r s_line; do
    case "$s_line" in '' | *' total') ;; *) s_list="$s_list
$s_line" ;; esac
  done <<EOF
$s_packs
EOF
  sv_lines "$s_list" | LC_ALL=C sort
}

# The ref tips of the tree $1, and the tree of each commit or tag among them,
# that its store lacks (`missing` lines of cat-file); empty when whole. Seconds
# for thousands of refs; never a full fsck.
sv_tips_missing() {
  # By name and value only: a field that reads the object (its type) makes
  # for-each-ref stop at the first one missing. Branches and remote branches
  # name commits, whose trees are checked too; any other ref its tip alone.
  # Each stage into a variable, never a pipe: a stage that failed answers a
  # line, not an empty list that reads as nothing missing.
  local t_refs t_names t_check t_missing t_err
  if ! t_refs=$(base_git "$1" for-each-ref --format='%(objectname) %(refname)' 2>"$sv_state/tips.err"); then
    printf 'git for-each-ref failed in %s\n' "$1"
  elif ! t_names=$(sv_lines "$t_refs" | awk '{ print $1; if ($2 ~ /^refs\/(heads|remotes)\//) print $1 "^{tree}" }'); then
    printf 'awk failed on the refs of %s\n' "$1"
  elif ! t_check=$(sv_lines "$t_names" | base_git "$1" cat-file --batch-check 2>/dev/null); then
    printf 'git cat-file failed in %s\n' "$1"
  else
    # grep: 0 lines found, 1 none, anything else failed (never "none").
    if t_missing=$(sv_lines "$t_check" | grep ' missing$'); then
      sv_lines "$t_missing"
    elif [ $? -ne 1 ]; then
      printf 'grep failed on the objects of %s\n' "$1"
    fi
  fi
  # Anything for-each-ref says (a broken ref, a missing object) is a fault.
  if t_err=$(cat "$sv_state/tips.err" 2>/dev/null); then
    sv_lines "$t_err"
  else
    printf 'the errors of git for-each-ref in %s do not read\n' "$1"
  fi
  rm -f "$sv_state/tips.err" || true
}

# Whether the copy $1 is the base as it was when the copy began: HEAD, refs,
# status and lock files equal the base's; the refs and the object store of the
# base unchanged since then and the copy's store equal to it; every ref tip
# and tree in the copy; no Git lock or temporary pack in it. Every read is
# checked: one that failed is "not the base" (copy again, then roll back).
sv_copy_true() {
  local t_store t_a t_b
  t_store=$(cat "$sv_state/store") &&
    t_a=$(sv_digest "$sv_base") && t_b=$(sv_digest "$1") && [ "$t_a" = "$t_b" ] &&
    t_a=$(sv_refs "$sv_base") && t_b=$(cat "$sv_state/refs") && [ "$t_a" = "$t_b" ] &&
    t_a=$(sv_store "$sv_base") && [ "$t_a" = "$t_store" ] &&
    t_b=$(sv_store "$1") && [ "$t_b" = "$t_store" ] &&
    t_a=$(sv_tips_missing "$1") && [ -z "$t_a" ] &&
    t_b=$(git_carried_locks "$1/.git") && [ -z "$t_b" ]
}

# Carries into the tree $2 each ref the tree $1 changed since the refs file
# $3 (`oid ref` lines), where $2 still holds the value of $3; a ref both
# changed, and the branch either tree has checked out, is kept as
# refs/subvolume-move/<ref> in $2 and named. Objects come by a fetch from $1.
#
# Fails with sv_why, having changed nothing, when it cannot read either tree's
# refs or HEAD; fails with sv_why after the loop when a ref could not be moved
# (its compare and swap lost, or Git failed): what it could carry is carried,
# and a rerun carries the rest. Every read lands in a file or a variable and is
# checked; none is piped from Git (sv_refs).
sv_carry() {
  local c_from="$1" c_to="$2" c_snap="$3" c_tmp c_head c_head_from c_ref c_was c_now c_there c_rc c_failed=
  c_tmp=$sv_state/carry.$$
  sv_carried=0
  sv_kept=0
  sv_missed=0
  if ! sv_refs "$c_from" >"$c_tmp.from" || ! sv_refs "$c_to" >"$c_tmp.to"; then
    rm -f "$c_tmp.from" "$c_tmp.to"
    sv_why="git for-each-ref failed in $c_from or $c_to: nothing carried"
    return 1
  fi
  # No HEAD branch (detached) is status 1; anything else is Git failing.
  if c_head=$(base_git "$c_to" symbolic-ref -q HEAD); then :; elif [ $? -eq 1 ]; then c_head=; else
    sv_why="git symbolic-ref HEAD failed in $c_to: nothing carried"
    return 1
  fi
  if c_head_from=$(base_git "$c_from" symbolic-ref -q HEAD); then :; elif [ $? -eq 1 ]; then c_head_from=; else
    sv_why="git symbolic-ref HEAD failed in $c_from: nothing carried"
    return 1
  fi
  if ! awk 'FILENAME == ARGV[1] { s[$2] = $1; all[$2] = 1; next }
    FILENAME == ARGV[2] { f[$2] = $1; all[$2] = 1; next }
    { t[$2] = $1 }
    END { for (r in all) { a = (r in s) ? s[r] : "-"; b = (r in f) ? f[r] : "-"; if (a != b) print r, a, b, ((r in t) ? t[r] : "-") } }' \
    "$c_snap" "$c_tmp.from" "$c_tmp.to" >"$c_tmp.changed" ||
    ! LC_ALL=C sort "$c_tmp.changed" >"$c_tmp.diff"; then
    rm -f "$c_tmp.from" "$c_tmp.to" "$c_tmp.changed" "$c_tmp.diff"
    sv_why="the refs of $c_from and $c_to could not be compared (awk or sort failed): nothing carried"
    return 1
  fi
  while read -r c_ref c_was c_now c_there; do
    case "$c_ref" in refs/subvolume-move/*) continue ;; esac
    # A ref the two trees differed on at the switch (`?`): a value carried
    # only where the other tree has none; a deletion never.
    if [ "$c_was" = "?" ]; then
      [ "$c_now" != - ] || continue
      [ "$c_there" != - ] || c_was=-
    fi
    [ "$c_there" != "$c_now" ] || continue
    # The ref's objects travel with it: a fetch from the other tree brings
    # every object its new value needs that this one lacks (a ref changed
    # after the copy may name objects only that tree has). The ref itself is
    # then moved only from the value this tree still holds (compare and swap).
    if [ "$c_now" != - ]; then
      base_git "$c_to" fetch -q --no-tags --no-write-fetch-head "$c_from" "$c_ref" </dev/null >&2 || true
      # rev-parse -q --verify: 0 there, 1 missing; anything else is Git
      # failing, and the ref is left to the rerun (never counted as "objects
      # did not come"). (cat-file -e answers 128 for both.)
      c_rc=0
      base_git "$c_to" rev-parse -q --verify "$c_now^{object}" >/dev/null 2>&1 || c_rc=$?
      if [ "$c_rc" -eq 0 ]; then
        :
      elif [ "$c_rc" -eq 1 ]; then
        printf 'workrift: subvolume: %s moved to %s in %s, whose objects did not come over: not carried\n' "$c_ref" "$c_now" "$c_from" >&2
        sv_missed=$((sv_missed + 1))
        continue
      else
        printf 'workrift: subvolume: whether %s (%s) came over into %s does not read (git cat-file failed): not carried yet\n' "$c_ref" "$c_now" "$c_to" >&2
        c_failed="${c_failed:+$c_failed, }$c_ref"
        continue
      fi
    fi
    if [ "$c_there" = "$c_was" ] && [ "$c_ref" != "$c_head" ] && [ "$c_ref" != "$c_head_from" ]; then
      # (The arguments are copied to locals above; set -- reuses $@.)
      if [ "$c_now" = - ]; then
        set -- -d "$c_ref" "$c_was"
      elif [ "$c_was" = - ]; then
        set -- "$c_ref" "$c_now" ""
      else
        set -- "$c_ref" "$c_now" "$c_was"
      fi
      if base_git "$c_to" update-ref "$@" </dev/null; then
        printf 'workrift: subvolume: carried %s %s -> %s into %s\n' "$c_ref" "$c_was" "$c_now" "$c_to" >&2
        sv_carried=$((sv_carried + 1))
      else
        printf 'workrift: subvolume: %s could not be moved %s -> %s in %s (it changed there meanwhile, or Git failed): not carried yet\n' "$c_ref" "$c_was" "$c_now" "$c_to" >&2
        c_failed="${c_failed:+$c_failed, }$c_ref"
      fi
    elif [ "$c_now" != - ]; then
      if base_git "$c_to" update-ref "refs/subvolume-move/${c_ref#refs/}" "$c_now" </dev/null; then
        printf 'workrift: subvolume: %s is %s in %s but %s in %s (changed on both sides, or checked out): kept as refs/subvolume-move/%s\n' \
          "$c_ref" "$c_now" "$c_from" "$c_there" "$c_to" "${c_ref#refs/}" >&2
        sv_kept=$((sv_kept + 1))
      else
        c_failed="${c_failed:+$c_failed, }refs/subvolume-move/${c_ref#refs/}"
      fi
    fi
  done <"$c_tmp.diff"
  rm -f "$c_tmp.from" "$c_tmp.to" "$c_tmp.changed" "$c_tmp.diff"
  if [ -n "$c_failed" ]; then
    sv_why="the carry into $c_to could not move $c_failed"
    return 1
  fi
}

# Waits until no process outside the line is in $1, at most sv_wait_seconds;
# fails with sv_why, also when the processes or the clock do not read.
sv_wait_users() {
  local w_until w_users w_now
  w_now=$(date +%s) || { sv_why="the clock does not read (date failed) before the wait for $1"; return 1; }
  w_until=$((w_now + sv_wait_seconds))
  while :; do
    sv_rc=0
    sv_users_known "$1" || sv_rc=$?
    case $sv_rc in
      0) w_users=$sv_users_found ;;
      2)
        sv_unfinished_next=$sv_unknown_next
        return 1
        ;;
      *) return 1 ;;
    esac
    [ -n "$w_users" ] || return 0
    w_now=$(date +%s) || { sv_why="the clock does not read (date failed) while it waits for $1"; return 1; }
    if [ "$w_now" -ge "$w_until" ]; then
      sv_why="processes still work in $1 after ${sv_wait_seconds} s: $(sv_joined "$w_users")"
      return 1
    fi
    sleep 1 || true
  done
}

# The base's line: the move's own (one switch at a time, never waited for),
# then the base's exclusive lock and its clone turn, in line with creates
# and removes, at most sv_turn_seconds. Fails, holding nothing, past that.
sv_hold() {
  lock_purpose="subvolume: switch $sv_base (holds the base about 2-20 min; creates wait behind it)"
  sv_state_make
  queue_enter "$sv_base" move w 6 try ||
    fail "another workrift subvolume runs for $sv_base:$(queue_words "$sv_base" move); nothing changed"
  move_ticket=$queue_ticket
  phase "hold: the exclusive lock of $sv_base and its clone turn, in line (at most ${sv_turn_seconds} s)"
  queue_patience=$sv_turn_seconds
  if ! lock_source "$sv_base" exclusive; then
    queue_patience=
    sv_release
    fail "no turn at the lock of $sv_base within ${sv_turn_seconds} s:$(queue_words "$sv_base" base); nothing changed"
  fi
  # Whether work snapshots the base decides only whether the clone turn is
  # taken; in doubt (any failure) it is taken: slower, never worse.
  if ! base_snapshots "$sv_base"; then
    if ! queue_enter "$sv_base" clone w 8 wait; then
      queue_patience=
      sv_release
      fail "no clone turn of $sv_base within ${sv_turn_seconds} s:$(queue_words "$sv_base" clone); nothing changed"
    fi
    clone_ticket=$queue_ticket
  fi
  queue_patience=
  sv_held_at=$(date +%s) || { sv_rc=$?; sv_release; sv_stop_status "$sv_rc" "date (the clock at the hold)"; }
  phase 'held'
}

sv_release() {
  unlock_clone
  [ -z "${base_ticket:-}" ] || unlock_source
  if [ -n "${move_ticket:-}" ]; then
    queue_leave 6 "$move_ticket"
    move_ticket=
  fi
}

# Deletes the copy a switch to $1 made at its copy path, only while it is of
# kind $1 and the base still holds the whole tree it was copied from.
sv_drop_copy() {
  local d_t="$1" d_path d_kind d_kb d_users
  d_path=$(sv_copy_path "$d_t")
  sv_kind_of d_kind "$d_path"
  [ "$d_kind" != - ] || return 0
  [ "$d_kind" = "$d_t" ] || fail "$d_path is $(sv_words "$d_kind"), not the copy this command makes there; nothing deleted"
  sv_kind_of d_kb "$sv_base"
  [ "$d_kb" = "$(sv_other "$d_t")" ] && sv_whole "$sv_base" ||
    fail "$sv_base is not the whole $(sv_words "$(sv_other "$d_t")") the copy was made from; $d_path is not deleted"
  sv_rc=0
  sv_users_known "$d_path" || sv_rc=$?
  case $sv_rc in
    0) d_users=$sv_users_found ;;
    2)
      sv_next=$sv_unknown_next
      fail "$sv_why: nothing deleted"
      ;;
    *) fail "$sv_why: nothing deleted" ;;
  esac
  [ -z "$d_users" ] || fail "processes work in $d_path ($(sv_joined "$d_users")); end them, then run again"
  # The copy was never the base: the exchange is the only step that puts a
  # tree at the base's path, and the base is still the tree it was copied from.
  sv_step drop-copy "delete the copy $d_path ($(sv_words "$d_t")), never the base"
  if [ "$d_t" = S ]; then
    btrfs subvolume delete "$sv_new" >/dev/null || fail "btrfs subvolume delete $sv_new failed"
  else
    sv_rm_folder back || fail "rm -rf $sv_back failed (the copy, never the base)"
  fi
  [ ! -e "$d_path" ] || fail "$d_path is not all deleted"
  sv_deleted="$sv_deleted $d_path"
}

# Deletes the plain folder of the move path $1 (back or old), never crossing
# into another file system. Fails when rm fails. (GNU rm answers --version;
# a BSD rm, or an rm that could not start, takes -x, which GNU rm refuses: a
# wrong guess deletes nothing and fails.)
sv_rm_folder() {
  if rm --version >/dev/null 2>&1; then
    case "$1" in
      back) nice -n 19 rm -rf --one-file-system -- "$sv_back" ;;
      old) nice -n 19 rm -rf --one-file-system -- "$sv_old" ;;
    esac
  else
    case "$1" in
      back) nice -n 19 rm -rf -x -- "$sv_back" ;;
      old) nice -n 19 rm -rf -x -- "$sv_old" ;;
    esac
  fi
}

# The copy into $2 by cp, its pid and that pid's identity in the state folder
# while it runs. A run whose shell alone is killed leaves its cp running; the
# next run waits for that cp (sv_wait_copier) before it touches the copy. An
# identity that does not read while the cp lives is recorded as `unknown`
# (waited for by its pid alone), never as none; a record that cannot be
# written fails the copy once the cp has ended.
sv_cp() {
  local p_pid p_rc=0 p_id p_rec=true
  cp -a --reflink=always "$1" "$2" 3>&- 6>&- 7>&- 8>&- 9>&- &
  p_pid=$!
  p_id=$(process_identity "$p_pid")
  if [ -z "$p_id" ] && kill -0 "$p_pid" 2>/dev/null; then p_id=unknown; fi
  printf '%s\n%s\n' "$p_pid" "$p_id" >"$sv_state/copier" || p_rec=false
  wait "$p_pid" || p_rc=$?
  rm -f "$sv_state/copier" || true
  [ "$p_rec" = true ] || { [ "$p_rc" -ne 0 ] || p_rc=1; }
  return "$p_rc"
}

# Waits, at most sv_wait_seconds, for the cp of a run cut short to end. A cp
# whose identity does not read while its pid lives is waited for.
sv_wait_copier() {
  local w_pid='' w_id='' w_until w_now
  [ -f "$sv_state/copier" ] || return 0
  { read -r w_pid && read -r w_id; } <"$sv_state/copier" 2>/dev/null || true
  case "$w_pid" in '' | *[!0-9]*)
    fail "the record of a cut run's cp, $sv_state/copier, does not read (pid '$w_pid'): look whether a cp still writes into $sv_new or $sv_back; nothing changed" ;;
  esac
  w_now=$(date +%s) || sv_stop "date (the clock before the wait for a cut run's cp)"
  w_until=$((w_now + sv_wait_seconds))
  while :; do
    if [ "$w_id" = unknown ] || [ -z "$w_id" ]; then
      kill -0 "$w_pid" 2>/dev/null || break
    elif ! process_is "$w_pid" "$w_id" && [ "$process_was" = gone ]; then
      break
    fi
    w_now=$(date +%s) || sv_stop "date (the clock while it waits for a cut run's cp)"
    [ "$w_now" -lt "$w_until" ] ||
      fail "the cp of a run cut short (pid $w_pid) still writes into the copy after ${sv_wait_seconds} s: let it end, or end it (kill $w_pid), then run again; nothing changed"
    phase "wait for the cp of a run cut short (pid $w_pid) to end"
    sleep 1 || true
  done
  printf 'workrift subvolume: the cp of a run cut short (pid %s) has ended\n' "$w_pid" >&2
  rm -f "$sv_state/copier" || sv_stop "rm of $sv_state/copier"
}

# Makes the copy of the base at the copy path of $1, verified: a subvolume
# (or folder) filled by a reflink copy, its index refreshed, its HEAD, refs,
# status and lock files the base's. The refs at the copy go to the state
# folder's refs file. Fails with sv_why.
sv_copy_in() {
  local i_t="$1" i_path i_try=0 i_kind i_now
  i_path=$(sv_copy_path "$i_t")
  sv_step copy-make "$([ "$i_t" = S ] && printf 'btrfs subvolume create' || printf 'mkdir') $i_path"
  if [ "$i_t" = S ]; then
    btrfs subvolume create "$i_path" >/dev/null || { sv_why="btrfs subvolume create $i_path failed"; return 1; }
  else
    mkdir "$i_path" || { sv_why="mkdir $i_path failed"; return 1; }
  fi
  sv_refs_write || return 1
  sv_store "$sv_base" >"$sv_state/store" || { sv_why="the object store of $sv_base could not be listed"; return 1; }
  sv_step copy "cp -a --reflink=always $sv_base/. $i_path/"
  sv_cp "$sv_base/." "$i_path/" ||
    { sv_why="the copy into $i_path failed (a full disk or metadata space?)"; return 1; }
  while :; do
    sv_step refresh "git -C $i_path update-index -q --refresh"
    # The refresh only rewrites stat data the verify compares: a refresh that
    # failed shows as a status that differs, and the .git is copied again.
    base_git "$i_path" update-index -q --refresh >/dev/null 2>&1 || true
    sv_step verify "HEAD, refs, status, lock files and the object store: $sv_base = at the copy = $i_path; every ref tip and its tree in $i_path; no Git lock in it"
    if sv_copy_true "$i_path"; then
      break
    fi
    i_try=$((i_try + 1))
    if [ "$i_try" -ge 3 ]; then
      sv_why="$i_path differs from $sv_base after 3 copies of its .git (the base keeps changing, or a read of it fails)"
      return 1
    fi
    sv_step copy-git "the base changed during the copy: copy its .git again"
    sv_read i_kind sv_kind "$i_path" || { sv_why="stat of $i_path failed"; return 1; }
    [ "$i_kind" = "$i_t" ] || { sv_why="$i_path is no longer the copy"; return 1; }
    if [ "$i_t" = S ]; then
      rm -rf -- "$sv_new/.git" || { sv_why="rm -rf $sv_new/.git failed (the copy's .git, to copy it again)"; return 1; }
    else
      rm -rf -- "$sv_back/.git" || { sv_why="rm -rf $sv_back/.git failed (the copy's .git, to copy it again)"; return 1; }
    fi
    sv_refs_write || return 1
    sv_store "$sv_base" >"$sv_state/store" || { sv_why="the object store of $sv_base could not be listed"; return 1; }
    sv_cp "$sv_base/.git" "$i_path/.git" ||
      { sv_why="the copy of $sv_base/.git failed"; return 1; }
  done
  i_now=$(date +%s) || { sv_why="the clock does not read (date failed) after the copy"; return 1; }
  if [ $((i_now - sv_held_at)) -gt "$sv_limit_seconds" ]; then
    sv_why="the copy and its checks took more than ${sv_limit_seconds} s of the hold"
    return 1
  fi
}

# The smoke workspace's record in work's list $1, into s_id and s_path (both
# empty when there is none); fails when jq fails.
sv_smoke_record() {
  s_id=
  s_path=
  s_rec=$(printf '%s' "$1" | jq -r --arg n "$sv_smoke" '.[] | select(.name == $n and .state._tag == "Active") | [.id, .path, (.cloner // "")] | join("\u001f")') || return 1
  s_rec=${s_rec%%
*}
  [ -n "$s_rec" ] || return 0
  s_id=${s_rec%%"$record_separator"*}
  s_rec=${s_rec#*"$record_separator"}
  s_path=${s_rec%%"$record_separator"*}
  s_cloner=${s_rec#*"$record_separator"}
}

# Removes the smoke workspace, when there is one. Fails with sv_why, also
# when work's list or its record does not read (never "there is none").
sv_smoke_rm() {
  local s_list s_answer s_i=0
  s_list=$(work_in "$sv_base" --json list 2>/dev/null) || { sv_why="work list failed in $sv_base"; return 1; }
  sv_smoke_record "$s_list" || { sv_why="the record of $sv_smoke in work's list does not read (jq failed)"; return 1; }
  [ -n "$s_id" ] || return 0
  sv_step smoke-rm "work rm $sv_smoke ($s_path)"
  s_answer=$(work_in "$sv_base" --json rm -abandon -expect "$s_id" "$sv_smoke" 3>&- 6>&- 7>&- 8>&- 9>&-) ||
    { sv_why="work rm $sv_smoke failed: $s_answer"; return 1; }
  (work_purge "$sv_base" "$s_list" "$s_path" "$s_answer") >&2 || { sv_why="work rm $sv_smoke left it: $s_answer"; return 1; }
  while { [ -e "$s_path" ] || [ -L "$s_path" ]; } && [ "$s_i" -lt 5 ]; do
    sleep 1 || true
    s_i=$((s_i + 1))
  done
  [ ! -e "$s_path" ] || { sv_why="$s_path is still there 5 s after its removal"; return 1; }
}

# The base after a switch to $1 is what work needs. For a subvolume: work
# clones it by btrfs, and a smoke workspace is a btrfs record whose folder is
# a subvolume, removed in one call. Fails with sv_why; a read that fails is
# said as such (never "not a btrfs snapshot").
sv_prove() {
  local v_t="$1" v_answer v_list v_kind v_head
  sv_read v_kind sv_kind "$sv_base" || { sv_why="stat of $sv_base failed: what it is does not read"; return 1; }
  [ "$v_kind" = "$v_t" ] || { sv_why="$sv_base is $(sv_words "$v_kind")"; return 1; }
  [ "$v_t" = S ] || return 0
  base_snapshots "$sv_base" || { sv_why="work does not clone $sv_base by btrfs (work --json doctor: cloners; or the doctor or jq failed)"; return 1; }
  sv_smoke_rm || return 1
  sv_step smoke "work new $sv_smoke in $sv_base: a btrfs record, a subvolume"
  v_head=$(base_git "$sv_base" rev-parse HEAD) || { sv_why="git rev-parse HEAD failed in $sv_base"; return 1; }
  v_answer=$(work_in "$sv_base" --json new -branch "$sv_smoke" -from "$v_head" "$sv_smoke" 3>&- 6>&- 7>&- 8>&- 9>&-) ||
    { sv_why="work new $sv_smoke failed: $v_answer"; sv_smoke_rm || true; return 1; }
  if ! v_list=$(work_in "$sv_base" --json list 2>/dev/null) || ! sv_smoke_record "$v_list"; then
    sv_why="work list failed in $sv_base (or its record of $sv_smoke does not read): the smoke workspace is unproven"
    sv_smoke_rm || true
    return 1
  fi
  if ! sv_read v_kind sv_kind "${s_path:-/nonexistent/smoke}"; then
    sv_why="stat of the smoke workspace $s_path failed: the smoke workspace is unproven"
    sv_smoke_rm || true
    return 1
  fi
  if [ "$s_cloner" != btrfs ] || [ "$v_kind" != S ]; then
    sv_why="the smoke workspace $s_path was made by '$s_cloner' and is $(sv_words "$v_kind"), not a btrfs snapshot"
    sv_smoke_rm || true
    return 1
  fi
  sv_smoke_rm
}

# The exchange is the commit point of a switch. Before it, the base never
# moved and a failure rolls back: the copy (never the base) is deleted, or a
# kept tree stays kept. After it, the tree at the base's path has been the
# live base, and anything may have been written into it (refs, objects,
# reflogs, the index, config, files; work's records live beside it, not in
# it), so nothing rolls it back: a failure after the exchange leaves the new
# tree as the base, keeps the tree it was at .old under its record, and says
# what the base lacks of it. A return is a --back of its own.

# Fails after rolling back a switch to $2 from $1 (copy or kept) that had not
# exchanged, with the reason in sv_why.
sv_abort() {
  local a_source="$1" a_t="$2" a_kb
  a_kb=$(sv_kind "$sv_base") || a_kb='?'
  [ "$a_kb" = "$(sv_other "$a_t")" ] && sv_whole "$sv_base" || {
    sv_release
    fail "$sv_why; and $sv_base is $(sv_words "$a_kb"), not the tree it was before the exchange: nothing rolled back or deleted; look at it"
  }
  sv_step rollback "before the exchange: $sv_base never moved"
  if [ "$a_source" = copy ]; then
    sv_drop_copy "$a_t"
    rm -f "$sv_state/phase" || sv_stop "rm of the record $sv_state/phase (after the copy was deleted)"
  else
    sv_phase_write switched kept "$(sv_other "$a_t")"
  fi
  sv_step rolled-back "$sv_base is $(sv_words "$a_kb") as it was"
  sv_release
  fail "$sv_why; rolled back before the exchange: $sv_base is $(sv_words "$a_kb") as it was, never moved; $(sv_deleted_said)"
}

# What a run deleted, from what it did: only copies that were never the base.
sv_deleted_said() {
  if [ -z "${sv_deleted:-}" ]; then
    printf 'deleted nothing'
  else
    printf 'deleted only its copy that was never the base:%s' "$sv_deleted"
  fi
}

# Records the tree at .old, which was the base until the exchange, by its
# identity: the only tree --drop-old deletes.
#
# Stops when the identity does not read or the record cannot be written: no
# record of `?`, which a drop could take for any tree. (Called after the
# exchange: the rerun records it, sv_resume.)
sv_keep_record() {
  local k_id
  k_id=$(sv_identity "$sv_old") || sv_stop "the identity of $sv_old (btrfs inspect-internal rootid or stat), for the record of the tree kept there"
  printf '%s\n%s\n' "$sv_old" "$k_id" >"$sv_state/kept.$$" || sv_stop "the write of $sv_state/kept.$$ (the record of the tree kept at $sv_old)"
  mv -f "$sv_state/kept.$$" "$sv_state/kept" || sv_stop "mv of the record of the tree kept at $sv_old into $sv_state/kept"
}

# What the tree $2 lacks of what the tree $1 holds, a line each, empty when
# nothing: refs (a ref the carry put under refs/subvolume-move/ is held),
# HEAD, Git's own files (config, info, hooks and the rest outside objects,
# refs, logs, packed-refs and the index), reflog entries, and the index and
# worktree as `git status` sees them. Files Git ignores are not compared.
# Reads only: no file is written, so a dry run may call it.
#
# Each side is read into a variable and checked, and each comparison is
# checked: a read or an awk that fails is said as an `unknown` line (never an
# empty list, which would read as "holds all"). Fails only when a sort fails.
sv_lacks() {
  local l_k="$1" l_b="$2" l_hk l_hb l_x l_y l_out
  if l_x=$(sv_refs "$l_k") && l_y=$(sv_refs "$l_b"); then
    if l_out=$({ printf '=K\n'; sv_lines "$l_x"; printf '=B\n'; sv_lines "$l_y"; } | awk '
      $1 == "=K" { s = 1; next } $1 == "=B" { s = 2; next }
      s == 1 && $2 !~ /^refs\/subvolume-move\// { k[$2] = $1; next }
      s == 2 { b[$2] = $1 }
      END {
        for (r in k) {
          m = "refs/subvolume-move/" substr(r, 6)
          if (((r in b) && b[r] == k[r]) || ((m in b) && b[m] == k[r])) continue
          print "  ref " r " " k[r] ((r in b) ? " (the base has " b[r] ")" : " (the base has no such ref)")
        }
      }'); then
      sv_lines "$l_out" | LC_ALL=C sort || return 1
    else
      printf '  refs: unknown (awk failed comparing them); run it again\n'
    fi
  else
    printf '  refs: unknown (git for-each-ref failed in %s or %s); run it again\n' "$l_k" "$l_b"
  fi
  if sv_head l_hk "$l_k" && sv_head l_hb "$l_b"; then
    [ "$l_hk" = "$l_hb" ] || printf '  HEAD %s (the base has %s)\n' "$l_hk" "$l_hb"
  else
    printf '  HEAD: unknown (git symbolic-ref or rev-parse failed in %s or %s); run it again\n' "$l_k" "$l_b"
  fi
  if l_x=$(sv_git_files "$l_k") && l_y=$(sv_git_files "$l_b"); then
    if l_out=$({ printf '=K\n'; sv_lines "$l_x"; printf '=B\n'; sv_lines "$l_y"; } | awk '
      $1 == "=K" { s = 1; next } $1 == "=B" { s = 2; next }
      { f = $0; sub(/^[^ ]+ [^ ]+ \.\//, "", f) }
      s == 1 { k[f] = $1 " " $2; next }
      s == 2 { b[f] = $1 " " $2 }
      END { for (f in k) if (b[f] != k[f]) print "  Git file .git/" f ((f in b) ? " differs" : " is missing") }'); then
      sv_lines "$l_out" | LC_ALL=C sort || return 1
    else
      printf '  Git files: unknown (awk failed comparing them); run it again\n'
    fi
  else
    printf '  Git files: unknown (find or cksum failed in %s/.git or %s/.git); run it again\n' "$l_k" "$l_b"
  fi
  if l_x=$(sv_reflogs "$l_k") && l_y=$(sv_reflogs "$l_b"); then
    if l_out=$({ printf '=K\n'; sv_lines "$l_x"; printf '=B\n'; sv_lines "$l_y"; } | awk '
      $0 == "=K" { s = 1; next } $0 == "=B" { s = 2; next }
      s == 1 { k[$0] = 1; next }
      s == 2 { b[$0] = 1 }
      END {
        for (l in k) if (!(l in b)) { f = l; sub(/\t.*/, "", f); n[f]++ }
        for (f in n) print "  reflog .git/logs/" f ": " n[f] " entries"
      }'); then
      sv_lines "$l_out" | LC_ALL=C sort || return 1
    else
      printf '  reflogs: unknown (awk failed comparing them); run it again\n'
    fi
  else
    printf '  reflogs: unknown (find or awk failed in %s/.git/logs or %s/.git/logs); run it again\n' "$l_k" "$l_b"
  fi
  if l_x=$(sv_status "$l_k") && l_y=$(sv_status "$l_b"); then
    if l_out=$({ printf '=K\n'; sv_lines "$l_x"; printf '=B\n'; sv_lines "$l_y"; } | awk '
      $0 == "=K" { s = 1; next } $0 == "=B" { s = 2; next }
      s == 1 { k[$0] = 1; next }
      s == 2 { b[$0] = 1 }
      END { for (l in k) if (!(l in b)) print "  worktree or index: " l }'); then
      sv_lines "$l_out" | LC_ALL=C sort || return 1
    else
      printf '  worktree or index: unknown (awk failed comparing them); run it again\n'
    fi
  else
    printf '  worktree or index: unknown (git status failed in %s or %s); run it again\n' "$l_k" "$l_b"
  fi
}

# HEAD of the tree $2 into the variable $1: the branch it names, or the
# commit when detached (symbolic-ref's status 1); fails when Git fails.
# shellcheck disable=SC2034 # h_v is read by the eval
sv_head() {
  local h_v
  if h_v=$(base_git "$2" symbolic-ref -q HEAD 2>/dev/null); then
    :
  elif [ $? -eq 1 ]; then
    h_v=$(base_git "$2" rev-parse -q --verify HEAD 2>/dev/null) || return 1
  else
    return 1
  fi
  eval "$1=\$h_v"
}

# Git's own files of the tree $1: `crc size ./path` a line.
# Fails when the walk fails.
sv_git_files() {
  (
    cd "$1/.git" 2>/dev/null || exit 1
    find . -type f ! -path './objects/*' ! -path './refs/*' ! -path './logs/*' ! -name packed-refs \
      ! -name index ! -name HEAD ! -name '*.lock' ! -name gc.pid ! -name FETCH_HEAD -exec cksum {} + 2>/dev/null
  )
}

# The reflog entries of the tree $1: `<log file><tab><entry>` a line; none
# when it has no logs. Fails when the walk fails.
sv_reflogs() {
  [ -d "$1/.git/logs" ] || return 0
  (
    cd "$1/.git/logs" 2>/dev/null || exit 1
    find . -type f -exec awk '{ f = FILENAME; sub(/^\.\//, "", f); print f "\t" $0 }' {} + 2>/dev/null
  )
}

# The index and worktree of the tree $1 as Git sees them (no branch lines).
# Fails when Git fails (the header lines are dropped by the shell: no grep
# whose failure would read as a clean tree).
sv_status() {
  local s_out s_line
  s_out=$(base_git "$1" --no-optional-locks status --porcelain=v2 --untracked-files=all 2>/dev/null) || return 1
  while IFS= read -r s_line; do
    case "$s_line" in '' | '#'*) ;; *) printf '%s\n' "$s_line" ;; esac
  done <<EOF
$s_out
EOF
}

# Says what the base lacks of the tree kept at .old, from sv_lacks.
sv_lacks_said() {
  local s_lacks
  [ -d "$sv_old" ] || return 0
  if ! s_lacks=$(sv_lacks "$sv_old" "$sv_base"); then
    printf '  what %s lacks of %s is unknown (a sort failed comparing them); run workrift subvolume (a dry run) to see it\n' "$sv_base" "$sv_old"
  elif [ -z "$s_lacks" ]; then
    printf '  %s holds all that %s holds (refs and their objects, HEAD, Git'\''s files, reflogs, the index and the worktree as Git sees them; files Git ignores are not compared)\n' "$sv_base" "$sv_old"
  else
    printf '  %s lacks, of what %s holds (kept there until --drop-old):\n%s\n' "$sv_base" "$sv_old" "$s_lacks"
  fi
}

# After the exchange (phase carry): waits for everyone to leave the tree at
# .old, carries the refs it gained, work refresh, the proof. Never rolls back:
# when processes stay in .old, or the proof fails, the switch ends here with
# the new tree as the base and sv_unfinished or sv_unproved set.
sv_finish() {
  local f_t="$1" f_source="$2"
  sv_unfinished=
  sv_unproved=
  sv_refreshed=
  sv_step carry-wait "wait up to ${sv_wait_seconds} s until no process outside workrift's line is in $sv_old"
  sv_wait_users "$sv_old" || sv_unfinished=$sv_why
  sv_step carry "the refs $sv_old gained since the copy, into $sv_base"
  sv_carry "$sv_old" "$sv_base" "$sv_state/refs" || sv_unfinished=${sv_unfinished:-$sv_why}
  [ -z "$sv_unfinished" ] || return 0
  sv_step work-refresh "work refresh in $sv_base (every inode changed)"
  sv_refreshed=true
  work_in "$sv_base" refresh >/dev/null 3>&- 6>&- 7>&- 8>&- 9>&- || sv_refreshed=false
  sv_step prove "$sv_base is $(sv_words "$f_t") work can use"
  sv_prove "$f_t" || sv_unproved=$sv_why
  if ! sv_baseline_write; then
    sv_unfinished=$sv_why
    return 0
  fi
  sv_phase_write switched "$f_source" "$f_t"
  sv_step switched "$sv_base is $(sv_words "$f_t"); the tree it was is kept at $sv_old"
}

# Ends a switch to $1 that exchanged: releases the line, says what happened,
# and fails when it did not finish or its proof failed.
sv_end() {
  sv_release
  sv_said "$1"
  if [ -n "${sv_unfinished:-}" ]; then
    sv_next=${sv_unfinished_next:-"$(sv_command "$1") once no process works in $sv_old (it carries what $sv_old gained and finishes the switch)"}
    fail "$sv_unfinished; not rolled back: $sv_base has been the live base since the exchange and stays $(sv_words "$1"); the switch is not finished: run workrift subvolume$([ "$1" = F ] && printf ' --back') --apply again (once no process works in $sv_old) to carry what $sv_old gained and finish it"
  fi
  if [ -n "${sv_unproved:-}" ]; then
    sv_next="$(sv_command "$(sv_other "$1")") switches it back; or keep it as it is, the switch is recorded as done"
    fail "$sv_unproved; not rolled back: $sv_base has been the live base since the exchange and stays $(sv_words "$1"); workrift subvolume$([ "$1" = S ] && printf ' --back') --apply switches it back"
  fi
}

# The plan of a switch to $1 from $2 (copy or kept), with its paths.
sv_plan() {
  local n_t="$1" n_c
  n_c=$(sv_copy_path "$n_t")
  printf 'steps (with --apply):\n'
  printf '  1 hold     the exclusive lock of %s and its clone turn, in line (creates wait behind it; at most %s s to get it)\n' "$sv_base" "$sv_turn_seconds"
  if [ "$2" = copy ]; then
    if [ "$n_t" = S ]; then
      printf '  2 copy     btrfs subvolume create %s\n' "$n_c"
    else
      printf '  2 copy     mkdir %s\n' "$n_c"
    fi
    printf '             cp -a --reflink=always %s/. %s/\n' "$sv_base" "$n_c"
    printf '  3 refresh  git -C %s update-index -q --refresh\n' "$n_c"
    printf '  4 verify   HEAD, refs, status, lock files and the object store: %s = at the copy = %s; every ref tip and branch tree in the copy; no Git lock in it (else its .git again, 3 tries)\n' "$sv_base" "$n_c"
    printf '  5 swap     exchange %s and %s (one renameat2 RENAME_EXCHANGE), then rename %s to %s\n' "$sv_base" "$n_c" "$n_c" "$sv_old"
  else
    printf '  2 carry    the refs %s changed since the last switch, into %s\n' "$sv_base" "$sv_old"
    printf '  5 swap     exchange %s and %s (one renameat2 RENAME_EXCHANGE)\n' "$sv_base" "$sv_old"
  fi
  printf '  6 carry    wait up to %s s until no process outside the line is in %s; carry the refs it gained into %s; work refresh in %s\n' "$sv_wait_seconds" "$sv_old" "$sv_base" "$sv_base"
  if [ "$n_t" = S ]; then
    printf '  7 prove    work new %s in %s: a btrfs record, a subvolume; work rm of it, gone within 5 s\n' "$sv_smoke" "$sv_base"
  else
    printf '  7 prove    %s is a plain folder\n' "$sv_base"
  fi
  printf '  8 release  the tree that was the base stays at %s until: workrift subvolume --drop-old --apply\n' "$sv_old"
  printf 'a failure before the exchange rolls back (it deletes the copy, never the base); from the exchange on, the new tree is the base and stays it: a failure after it is said, with what the base lacks of the tree kept at %s; a cut run is finished by the next --apply\n' "$sv_old"
}

# A switch of the base to $1 (S forward, F back); $2 true applies it.
sv_switch() {
  local s_t="$1" s_apply="$2" s_o s_c s_kb s_kc s_ko s_fs s_source s_held=false
  s_o=$(sv_other "$s_t")
  s_c=$(sv_copy_path "$s_t")
  sv_phase_read
  sv_kind_of s_kb "$sv_base"
  sv_kind_of s_kc "$s_c"
  sv_kind_of s_ko "$sv_old"
  printf 'workrift subvolume: %s is %s; %s: %s; %s: %s\n' "$sv_base" "$(sv_words "$s_kb")" "$s_c" "$(sv_words "$s_kc")" "$sv_old" "$(sv_words "$s_ko")"
  case "$sv_ph" in
    drop) fail "a --drop-old was cut short: run workrift subvolume --drop-old --apply to finish it first" ;;
    copy | swap | carry | rollback)
      [ "$sv_ph_target" = "$s_t" ] || fail "a switch to $(sv_words "$sv_ph_target") was cut short ($sv_ph): run workrift subvolume$([ "$sv_ph_target" = F ] && printf ' --back') --apply to finish it first"
      printf 'a switch to %s was cut short (%s): --apply finishes it (cut before its exchange: deletes its copy and switches afresh)\n' "$(sv_words "$s_t")" "$sv_ph"
      if [ "$s_apply" != true ]; then
        printf 'dry run: nothing changed; --apply finishes it\n'
        return 0
      fi
      sv_hold
      s_held=true
      sv_restart=false
      sv_resume "$s_t"
      [ "$sv_restart" = true ] || return 0
      # Cut before its exchange and undone: a switch afresh, still holding.
      sv_phase_read
      sv_kind_of s_kb "$sv_base"
      sv_kind_of s_kc "$s_c"
      sv_kind_of s_ko "$sv_old"
      ;;
  esac
  if [ "$s_kb" = "$s_t" ]; then
    [ "$s_held" = false ] || sv_release
    printf '%s is already %s: nothing to do' "$sv_base" "$(sv_words "$s_t")"
    [ "$s_ko" = - ] || printf '; the tree it was is kept at %s (workrift subvolume --drop-old --apply deletes it)' "$sv_old"
    printf '\n'
    # Said every time: a run cut after its carry never said it.
    [ "$s_ko" = - ] || sv_lacks_said
    return 0
  fi
  [ "$s_kb" = "$s_o" ] && sv_whole "$sv_base" || fail "$sv_base is $(sv_words "$s_kb"), not a whole work base on btrfs"
  sv_read s_fs stat -f -c %T "$sv_base" || sv_stop "stat -f of $sv_base (whether it is on btrfs; nothing changed)"
  [ "$s_fs" = btrfs ] || fail "$sv_base is not on btrfs: nothing to switch"
  [ "$s_kc" = - ] || fail "$s_c is $(sv_words "$s_kc"), left by nothing this command knows: look at it, remove it by hand, run again"
  if [ "$s_ko" = "$s_t" ] && sv_whole "$sv_old"; then
    s_source=kept
  elif [ "$s_ko" = - ]; then
    s_source=copy
  else
    fail "$sv_old is $(sv_words "$s_ko"), not a whole $(sv_words "$s_t") to switch to: drop it first (workrift subvolume --drop-old --apply)"
  fi
  sv_preflight "$s_source"
  sv_plan "$s_t" "$s_source"
  [ "$sv_refused" = false ] || fail 'refused: nothing changed'
  if [ "$s_apply" != true ]; then
    printf 'dry run: nothing changed; --apply runs these steps\n'
    return 0
  fi
  [ "$s_held" = true ] || sv_hold
  # What may have started while it waited for its turn.
  sv_refused=false
  sv_preflight_live >&2
  if [ "$sv_refused" = true ]; then
    sv_log_flush
    sv_release
    fail 'refused under the hold: nothing changed'
  fi
  mkdir -p "$sv_dir" "$sv_state" || { sv_rc=$?; sv_release; sv_stop_status "$sv_rc" "mkdir -p $sv_dir $sv_state (nothing changed)"; }
  rm -f "$sv_state/log" || { sv_rc=$?; sv_release; sv_stop_status "$sv_rc" "rm of the old step log $sv_state/log (nothing changed)"; }
  if [ "$s_source" = copy ]; then
    sv_phase_write copy copy "$s_t"
    sv_copy_in "$s_t" || sv_abort copy "$s_t"
    sv_phase_write swap copy "$s_t"
    sv_step swap "exchange $sv_base and $s_c"
    sv_renameat exchange "$sv_base" "$s_c" || { sv_why='the exchange failed'; sv_abort copy "$s_t"; }
    sv_step swapped "$sv_base is the copy; rename $s_c to $sv_old"
    sv_renameat rename "$s_c" "$sv_old" || fail "rename $s_c $sv_old failed; $sv_base is the new tree, whole: run --apply again"
    sv_keep_record
  else
    sv_phase_write swap kept "$s_t"
    [ -f "$sv_state/refs-at-switch" ] || sv_baseline_write || sv_abort kept "$s_t"
    sv_step carry-in "the refs $sv_base changed since the last switch, into $sv_old"
    sv_carry "$sv_base" "$sv_old" "$sv_state/refs-at-switch" || sv_abort kept "$s_t"
    sv_refs_write || sv_abort kept "$s_t"
    sv_step swap "exchange $sv_base and $sv_old"
    sv_renameat exchange "$sv_base" "$sv_old" || { sv_why='the exchange failed'; sv_abort kept "$s_t"; }
    sv_keep_record
  fi
  sv_phase_write carry "$s_source" "$s_t"
  sv_finish "$s_t" "$s_source"
  sv_end "$s_t"
}

# The refs at a switch: the value where the base and the kept tree agree,
# `?` where they differ (a ref written into one of them after the carry). The
# next switch carries into the kept tree what the base changed since: a change
# of a ref they agreed on; a ref the kept tree lacks; never a deletion or an
# overwrite of a ref they differed on (that one goes under
# refs/subvolume-move/).
sv_baseline() {
  local b_b b_o b_all
  b_b=$(sv_refs "$sv_base") && b_o=$(sv_refs "$sv_old") || return 1
  b_all=$({ printf '=B\n'; sv_lines "$b_b"; printf '=O\n'; sv_lines "$b_o"; } | awk '
    $1 == "=B" { s = 1; next } $1 == "=O" { s = 2; next }
    s == 1 { b[$2] = $1; all[$2] = 1; next }
    { o[$2] = $1; all[$2] = 1 }
    END { for (r in all) print (((r in b) && (r in o) && b[r] == o[r]) ? b[r] : "?"), r }') || return 1
  sv_lines "$b_all" | LC_ALL=C sort -k2
}

# Records the baseline (refs-at-switch) whole or not at all; fails with sv_why.
sv_baseline_write() {
  if sv_baseline >"$sv_state/refs-at-switch.$$"; then
    mv -f "$sv_state/refs-at-switch.$$" "$sv_state/refs-at-switch" && return 0
  fi
  rm -f "$sv_state/refs-at-switch.$$"
  sv_why="the refs of $sv_base and $sv_old could not be read for the record of the switch"
  return 1
}

# Records the base's refs (the state folder's refs file) whole or not at all;
# fails with sv_why.
sv_refs_write() {
  if sv_refs "$sv_base" >"$sv_state/refs.$$"; then
    mv -f "$sv_state/refs.$$" "$sv_state/refs" && return 0
  fi
  rm -f "$sv_state/refs.$$"
  sv_why="git for-each-ref failed in $sv_base"
  return 1
}

# Takes up a cut switch to $1 under the hold, from what the paths hold.
sv_resume() {
  local m_t="$1" m_o m_c m_kb m_kc m_ko m_source="$sv_ph_source"
  m_o=$(sv_other "$m_t")
  m_c=$(sv_copy_path "$m_t")
  # A cp the cut run left running ends before anything touches its copy.
  sv_wait_copier
  sv_kind_of m_kb "$sv_base"
  if [ "$m_kb" = "$m_o" ]; then
    # Cut before the exchange (a phase `rollback` of an older run is the
    # same): the base never moved; the copy is dropped and the caller
    # switches afresh.
    if [ "$m_source" = copy ]; then
      sv_drop_copy "$m_t"
      rm -f "$sv_state/phase" || sv_stop "rm of the record $sv_state/phase (after the cut run's copy was deleted)"
    else
      sv_phase_write switched kept "$m_o"
    fi
    printf 'workrift subvolume: the cut switch had not swapped: %s; the switch starts again\n' "$(sv_deleted_said)" >&2
    sv_restart=true
    return 0
  fi
  # Cut after the exchange: the base is the new tree, and stays it.
  sv_kind_of m_kc "$m_c"
  if [ "$m_source" = copy ] && [ "$m_kc" = "$m_o" ]; then
    sv_kind_of m_ko "$sv_old"
    [ "$m_ko" = - ] || fail "$sv_old is taken; $m_c holds the tree that was the base: look at both"
    sv_step swapped "rename $m_c to $sv_old"
    sv_renameat rename "$m_c" "$sv_old" || fail "rename $m_c $sv_old failed"
  fi
  sv_kind_of m_ko "$sv_old"
  [ "$m_ko" = "$m_o" ] && sv_whole "$sv_old" || fail "$sv_old is not the whole tree the base was; look at it"
  sv_keep_record
  sv_phase_write carry "$m_source" "$m_t"
  sv_finish "$m_t" "$m_source"
  sv_end "$m_t"
}

sv_said() {
  # The report decides nothing: a read that fails here is said as unknown.
  local r_kb r_id r_now
  r_kb=$(sv_kind "$sv_base") || r_kb='?'
  r_id=$(sv_identity "$sv_old") || r_id='its identity does not read'
  if r_now=$(date +%s); then r_now="$((r_now - sv_held_at)) s"; else r_now='? s (the clock does not read)'; fi
  printf 'workrift subvolume: %s is now %s (hold to release %s)\n' "$sv_base" "$(sv_words "$r_kb")" "$r_now"
  printf '  the tree it was is kept at %s (%s); %s\n' "$sv_old" "$r_id" "$(sv_deleted_said)"
  case "${sv_refreshed:-}" in
    true) printf '  work refresh ran in %s\n' "$sv_base" ;;
    false) printf '  work refresh failed in %s: run it there (cd %s && work refresh)\n' "$sv_base" "$sv_base" ;;
    *) printf '  work refresh did not run (the switch is not finished)\n' ;;
  esac
  printf '  carried %s refs; put %s under refs/subvolume-move/; %s not carried (their objects did not come over)\n' "${sv_carried:-0}" "${sv_kept:-0}" "${sv_missed:-0}"
  sv_lacks_said
  [ "${sv_beside:-no}" = no ] || printf "  it ran beside %s removal(s) of another base, the most its checks saw (--beside-other-removals)\n" "$sv_beside"
  if [ "$1" = S ]; then
    printf '  back:  workrift subvolume --back --apply   (a dry run without --apply)\n'
  else
    printf '  forward again: workrift subvolume --apply; its checkout may be behind: workrift refresh\n'
  fi
  printf '  drop:  workrift subvolume --drop-old --apply   (deletes %s)\n' "$sv_old"
}

# --drop-old: deletes the kept tree, by its exact path, only when it is the
# tree the last switch parked there (its identity recorded then).
sv_drop() {
  local d_apply="$1" d_kb d_ko d_path d_want d_have d_base_id d_users d_now
  sv_phase_read
  case "$sv_ph" in
    copy | swap | carry | rollback) fail "a switch is under way or was cut short ($sv_ph): run it again to finish it first" ;;
  esac
  sv_kind_of d_kb "$sv_base"
  sv_kind_of d_ko "$sv_old"
  if [ "$d_ko" = - ]; then
    printf 'workrift subvolume: nothing is kept at %s: nothing to drop\n' "$sv_old"
    # Only a run that applies forgets a record (a cut drop finished): a dry
    # run writes nothing.
    if [ "$d_apply" = true ] && { [ -f "$sv_state/kept" ] || [ "$sv_ph" = drop ]; }; then
      rm -f "$sv_state/kept" || sv_stop "rm of the record $sv_state/kept"
      [ "$sv_ph" != drop ] || sv_phase_write switched - "$d_kb"
    fi
    return 0
  fi
  d_path=
  d_want=
  { read -r d_path && read -r d_want; } <"$sv_state/kept" 2>/dev/null || true
  [ "$d_path" = "$sv_old" ] && [ -n "$d_want" ] ||
    fail "no switch recorded the tree at $sv_old ($sv_state/kept): nothing deleted; look at it"
  case "$d_want" in *'?'*) fail "the record $sv_state/kept names no identity ($d_want): nothing deleted; look at $sv_old" ;; esac
  d_have=$(sv_identity "$sv_old") || sv_stop "the identity of $sv_old (btrfs inspect-internal rootid or stat; nothing deleted)"
  [ "$d_have" = "$d_want" ] ||
    fail "$sv_old is $d_have, not the $d_want the last switch kept there: nothing deleted"
  { [ "$d_kb" = S ] && [ "$d_ko" = F ]; } || { [ "$d_kb" = F ] && [ "$d_ko" = S ]; } ||
    fail "$sv_base is $(sv_words "$d_kb") and $sv_old $(sv_words "$d_ko"): not a base beside the other tree; nothing deleted"
  sv_whole "$sv_base" || fail "$sv_base is not a whole work base: nothing deleted"
  d_base_id=$(sv_identity "$sv_base") || sv_stop "the identity of $sv_base (btrfs inspect-internal rootid or stat; nothing deleted)"
  [ "$d_base_id" != "$d_have" ] || fail "$sv_old is the base itself: nothing deleted"
  printf 'workrift subvolume: drop %s, %s (%s); %s stays %s\n' "$sv_old" "$(sv_words "$d_ko")" "$d_have" "$sv_base" "$(sv_words "$d_kb")"
  if [ "$d_ko" = S ]; then
    printf '  btrfs subvolume delete %s   (one call; the kernel frees its blocks after)\n' "$sv_old"
  else
    printf '  nice -n 19 rm -rf --one-file-system -- %s   (a walk of every file)\n' "$sv_old"
  fi
  sv_rc=0
  sv_users_known "$sv_old" || sv_rc=$?
  case $sv_rc in
    0) d_users=$sv_users_found ;;
    2)
      sv_next=$sv_unknown_next
      fail "$sv_why: nothing deleted"
      ;;
    *) fail "$sv_why: nothing deleted" ;;
  esac
  [ -z "$d_users" ] || fail "processes work in $sv_old ($(sv_joined "$d_users")): nothing deleted"
  # What the base would lose with it, said before it goes.
  sv_lacks_said
  if [ "$d_apply" != true ]; then
    printf 'dry run: nothing changed; --apply deletes it\n'
    return 0
  fi
  lock_purpose="subvolume: drop $sv_old"
  sv_state_make
  queue_enter "$sv_base" move w 6 try ||
    fail "another workrift subvolume runs for $sv_base:$(queue_words "$sv_base" move); nothing changed"
  move_ticket=$queue_ticket
  phase_label="subvolume $sv_base"
  create_started=$(date +%s) || sv_stop "date (the clock before the drop; nothing deleted)"
  sv_phase_write drop - "$d_kb"
  sv_step drop "delete $sv_old ($d_have)"
  if [ "$d_ko" = S ]; then
    btrfs subvolume delete "$sv_old" >/dev/null || fail "btrfs subvolume delete $sv_old failed"
  else
    sv_rm_folder old || fail "rm -rf $sv_old failed; run --drop-old --apply again"
  fi
  [ ! -e "$sv_old" ] || fail "$sv_old is not all deleted; run --drop-old --apply again"
  rm -f "$sv_state/kept" "$sv_state/refs-at-switch" || sv_stop "rm of the records $sv_state/kept and refs-at-switch ($sv_old is deleted)"
  sv_phase_write switched - "$d_kb"
  d_now=$(date +%s) || d_now=$create_started
  sv_step dropped "$sv_old deleted in $((d_now - create_started)) s"
  queue_leave 6 "$move_ticket"
  move_ticket=
  printf 'workrift subvolume: deleted %s in %s s\n' "$sv_old" "$((d_now - create_started))"
}

# `workrift subvolume [--back | --drop-old] [--check] [--apply] [--beside-other-removals] [--beside-unreadable]`.
subvolume_command() {
  local a_mode=forward a_apply=false a_source a_bases
  sv_beside=no
  sv_beside_unreadable=no
  sv_deleted=
  sv_my_uid=$(id -u) || sv_stop "id -u (this user's uid; nothing changed)"
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --back) a_mode=back ;;
      --drop-old) a_mode=drop ;;
      --check) ;;
      --apply) a_apply=true ;;
      --beside-other-removals) sv_beside=0 ;;
      --beside-unreadable) sv_beside_unreadable=yes ;;
      *) usage >&2; exit 2 ;;
    esac
    shift
  done
  case "$a_mode" in forward) sv_mode=S ;; back) sv_mode=F ;; drop) sv_mode=drop ;; esac
  sv_at=start
  a_source=$(resolve_source) || sv_stop "the base's path (resolve_source; nothing changed)"
  case "$a_source" in
    /*) ;;
    *) fail "the base must be an absolute path: $a_source" ;;
  esac
  case "$a_source" in
    *[][*?\\]* | */ | */./* | */../* | */. | */..) fail "$a_source: name the base by its plain absolute path" ;;
  esac
  [ ! -L "$a_source" ] && [ -d "$a_source" ] || fail "not a work base: $a_source"
  [ "$(cd "$a_source" && pwd -P)" = "$a_source" ] || fail "$a_source resolves to $(cd "$a_source" && pwd -P); name that path"
  sv_paths "$a_source"
  require_source "$a_source"
  a_bases=$(work_bases) || sv_stop "work --json bases (nothing changed)"
  case "
$a_bases
" in
    *"
$a_source
"*) ;;
    *) fail "not a work base (work --json bases does not list it): $a_source" ;;
  esac
  # Its own processes stay out of the base, so none of them is a user of it.
  cd / || sv_stop "cd / (nothing changed)"
  phase_label="subvolume $sv_base"
  create_started=$(date +%s) || sv_stop "date (the clock at the start; nothing changed)"
  case "$a_mode" in
    forward) sv_switch S "$a_apply" ;;
    back) sv_switch F "$a_apply" ;;
    drop) sv_drop "$a_apply" ;;
  esac
}

lock_purpose=workrift
holder_pid=$$
trap tickets_at_exit EXIT

# Before the work backend, an absent file meant Rift; now it means work. A
# file that names anything else (rift, the old default) stops every command
# before it does anything.
if [ -e "$backend_file" ]; then
  b_word=$(tr -d '[:space:]' <"$backend_file")
  [ "$b_word" = work ] ||
    fail "$backend_file says '$b_word', but work is the only backend now (Rift is gone): write work into it (printf 'work\\n' >$backend_file)"
fi

# init, create, refresh and deps fetch, clone, install and build. They run below
# the interactive work (the OpenCode service and the TUIs), as the OpenCode
# guard's heavy launcher runs a test: at nice 10 and, where ionice is, in the
# idle I/O class. Every child inherits both: the fetch's `git pack-objects`, the
# install, the warm build. The script runs itself again once under them.
case "${1:-}" in
  init | create | refresh | deps | advance)
    if [ -z "${WORKRIFT_LOWERED:-}" ]; then
      WORKRIFT_LOWERED=1
      export WORKRIFT_LOWERED
      if command -v ionice >/dev/null 2>&1; then
        exec nice -n 10 ionice -c3 "$0" "$@"
      fi
      exec nice -n 10 "$0" "$@"
    fi
    ;;
esac

command=${1:-}
[ "$#" -gt 0 ] && shift
case "$command" in
  init)
    [ "$#" -ge 1 ] && [ "$#" -le 2 ] || { usage >&2; exit 2; }
    initialize_source "$@"
    ;;
  create)
    [ "$#" -eq 1 ] || { usage >&2; exit 2; }
    create_workspace "$1"
    ;;
  deps)
    [ "$#" -le 1 ] || { usage >&2; exit 2; }
    # A hook a create, an advance or a refresh fires while it holds the
    # base's lock: that command installs and builds itself, the build with
    # the lock free (create_workspace, run_advance, refresh_source).
    if [ "${WORKRIFT_CREATING:-}" = 1 ]; then
      exit 0
    fi
    top=$(git rev-parse --show-toplevel 2>/dev/null) || fail 'run inside a Git checkout'
    # Run by hand in a base itself, it installs and builds the base: a change
    # of the base, so under its exclusive lock, in line, never beside a copy.
    d_source=$(resolve_source 2>/dev/null || true)
    # Run by a hook of a command that holds the base (an ancestor of this
    # process: ancestor_hold), it never waits in line behind that holder:
    #   an older workrift's create or refresh: it installs, and its refresh
    #     warms, once its switch or fast-forward is done, so nothing to do;
    #   this script's exclusive ticket (a hold, settings): the base is this
    #     process's already, so it installs under that hold;
    #   this script's shared ticket (a hold --shared): a change of the base
    #     beside copies is never right, and waiting is waiting for itself, so
    #     it says so and leaves the install to a `workrift deps` after it.
    # (This script's create, advance and refresh say so by WORKRIFT_CREATING.)
    if [ -n "$d_source" ] && [ "$(cd "$d_source" && pwd -P)" = "$(cd "$top" && pwd -P)" ]; then
      d_held=$(ancestor_hold "$top")
      case "$d_held" in
        old\ *)
          d_held=${d_held#old }
          printf 'workrift: deps: %s is held by pid %s (%s), an older workrift this hook runs under; it installs the base itself\n' "$top" "${d_held%% *}" "${d_held#* }" >&2
          exit 0
          ;;
        r\ *)
          d_held=${d_held#r }
          printf 'workrift: deps: %s is held shared by pid %s (%s), which this hook runs under: no install beside copies; run `workrift deps` in %s once it ends\n' "$top" "${d_held%% *}" "${d_held#* }" "$top" >&2
          exit 0
          ;;
        w\ *) ;;
        *)
          lock_purpose=deps
          lock_source "$top"
          ;;
      esac
    fi
    work_deps "$top"
    sync_dependency_hooks "$top"
    warm_build "$top" "$top" "${1:-}"
    ;;
  refresh)
    [ "$#" -eq 0 ] || { usage >&2; exit 2; }
    refresh_source
    ;;
  advance)
    [ "$#" -eq 0 ] || { usage >&2; exit 2; }
    run_advance
    ;;
  hold)
    hold_source "$@"
    ;;
  list)
    [ "$#" -eq 0 ] || { usage >&2; exit 2; }
    # The workspaces made on the source, not theirs.
    source_path=$(resolve_source)
    rows=$(work_workspaces "$source_path")
    printf '%s\n' "$rows" | awk -F '	' -v p="$source_path" '$4 == p { print $3 }'
    ;;
  remove)
    [ "$#" -le 3 ] || { usage >&2; exit 2; }
    remove_workspace "$@"
    ;;
  prune)
    prune_workspaces "$@"
    ;;
  sources)
    [ "$#" -eq 0 ] || { usage >&2; exit 2; }
    work_bases
    ;;
  check)
    [ "$#" -eq 0 ] || { usage >&2; exit 2; }
    check_source
    ;;
  subvolume)
    subvolume_command "$@"
    ;;
  settings)
    [ "$#" -eq 0 ] || { usage >&2; exit 2; }
    source_path=$(resolve_source)
    require_source "$source_path"
    lock_purpose=settings
    lock_source "$source_path"
    apply_base_settings "$source_path"
    unlock_source
    ;;
  --help | -h)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
