#!/bin/sh
# Weekly skills report. Lists skill folders that neither okra nor .own-skills
# tracks, skills whose source has changed, and skills okra could not check.
# Uses `okra skills update --dry-run`, which writes nothing. Exits 1 when it
# finds anything.

set -eu

skills_dir=${SKILLS_DIR:-"$HOME/Developer/personal/dotfiles/skills"}
lock="$skills_dir/.skill-lock.json"
log=$(mktemp)
trap 'rm -f "$log"' EXIT HUP INT TERM
findings=0

printf 'Untracked skills:\n'
for dir in "$skills_dir"/*/; do
  name=$(basename "$dir")
  [ -f "$dir/SKILL.md" ] || continue
  jq -e --arg name "$name" '.skills | has($name)' "$lock" >/dev/null && continue
  grep -qx "$name" "$skills_dir/.own-skills" && continue
  printf '%s: add it with okra skills add, or list it in .own-skills\n' "$name"
  findings=1
done

printf '\nSkill updates:\n'
outdated=$(SKILLS_DIR="$skills_dir" okra skills update --dry-run </dev/null 2>"$log") || {
  cat "$log"
  exit 2
}
# A local source compares against its checkout, so a stale checkout shows here too.
for name in $outdated; do
  printf '%s: source differs (%s)\n' "$name" "$(jq -r --arg name "$name" '.skills[$name].source' "$lock")"
  findings=1
done
# okra keeps a skill it cannot check and prints "Failed to update <name>: <reason>".
if grep -q 'Failed to update' "$log"; then
  sed -n 's/^ *Failed to update //p' "$log"
  findings=1
fi

exit "$findings"
