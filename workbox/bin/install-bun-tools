#!/bin/sh

# Installs each pinned Bun CLI in a project of its own and links its commands
# into ~/.bun/bin. Each tool is a package.json and a bun.lock under
# ~/.config/bite-workbox/bun-tools/<tool>/ (from workbox/bun-tools/).
#
# One project per tool, not `bun add --global`: the tools pin different Effect
# releases, and a shared global tree hoists one `effect` for all of them, so a
# tool built against another release fails to resolve its imports. The lock
# pins every dependency, so a fresh box installs what was tested.
#
# A command in ~/.bun/bin that links anywhere else (a local checkout the owner
# linked by hand) or is a plain file is kept, never replaced.

set -eu

workbox_config_dir=${WORKBOX_CONFIG_DIR:-"$HOME/.config/bite-workbox"}
tools_root=${WORKBOX_BUN_TOOLS_DIR:-"$HOME/.local/share/bite-workbox/bun-tools"}
bun_bin_dir="$HOME/.bun/bin"
bun_binary="$bun_bin_dir/bun"

export PATH="$bun_bin_dir:$PATH"

mkdir -p "$tools_root" "$bun_bin_dir"

for source in "$workbox_config_dir"/bun-tools/*/; do
  source=${source%/}
  tool=$(basename "$source")
  project="$tools_root/$tool"
  mkdir -p "$project"
  install -m 644 "$source/package.json" "$source/bun.lock" "$project/"
  (cd "$project" && "$bun_binary" install --frozen-lockfile)

  package=$(jq -er '.dependencies | keys[0]' "$project/package.json")
  # A string `bin` names one command after the package; an object names each.
  commands=$(jq -r --arg name "${package##*/}" \
    'if (.bin | type) == "string" then $name else (.bin // {} | keys[]) end' \
    "$project/node_modules/$package/package.json")

  for command in $commands; do
    target="$project/node_modules/.bin/$command"
    link="$bun_bin_dir/$command"
    if [ ! -x "$target" ]; then
      printf 'install-bun-tools: %s installed no command %s\n' "$package" "$command" >&2
      exit 1
    fi
    if [ -e "$link" ] || [ -L "$link" ]; then
      current=$(readlink "$link" || true)
      case "$current" in
        "$tools_root"/* | ../install/global/* | "$HOME/.bun/install/global/"*) ;;
        *)
          printf 'install-bun-tools: keeping %s -> %s\n' "$link" "${current:-(a file)}" >&2
          continue
          ;;
      esac
    fi
    ln -sfn "$target" "$link"
  done
done
