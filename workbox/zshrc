# Bite workbox interactive shell configuration

export EDITOR="${EDITOR:-nvim}"
export VISUAL="$EDITOR"

HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000

setopt append_history
setopt hist_ignore_dups
setopt share_history

autoload -Uz compinit
compinit

alias ll='ls -la'
alias glog='git log --oneline --graph --decorate -10'
alias b='bun'
alias bi='bun install'
alias br='bun run'
alias bd='bun dev'
alias bx='bunx'
alias reload='source ~/.zshrc'

PROMPT='%F{cyan}%n@%m%f:%F{blue}%~%f %# '

# bun completions
[ -s "/home/exedev/.bun/_bun" ] && source "/home/exedev/.bun/_bun"

# Interactive tools (machine-local configuration)
[ -r "$HOME/.config/zsh/interactive-tools.zsh" ] && source "$HOME/.config/zsh/interactive-tools.zsh"

# Claude Code uses the executable TeamClaude shim, including in subprocesses.
unalias claude claude2 2>/dev/null || :
typeset -U path PATH
path=("$HOME/Developer/personal/dotfiles/claude/bin" $path)
export PATH
