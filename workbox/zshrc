# Bite workbox interactive shell configuration

export EDITOR="${EDITOR:-nvim}"
export VISUAL="$EDITOR"

HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000

setopt append_history
setopt hist_ignore_dups
setopt share_history

autoload -Uz compinit
compinit

alias ll='ls -la'
alias glog='git log --oneline --graph --decorate -10'
alias b='bun'
alias bi='bun install'
alias br='bun run'
alias bd='bun dev'
alias bx='bunx'
alias reload='source ~/.zshrc'

PROMPT='%F{cyan}%n@%m%f:%F{blue}%~%f %# '

# Claude Code through the machine-local TeamClaude proxy
alias claude='teamclaude run --'
alias claude2='CLAUDE_CONFIG_DIR="$HOME/.claude2" teamclaude run --'

# bun completions
[ -s "/home/exedev/.bun/_bun" ] && source "/home/exedev/.bun/_bun"

# Interactive tools (machine-local configuration)
[ -r "$HOME/.config/zsh/interactive-tools.zsh" ] && source "$HOME/.config/zsh/interactive-tools.zsh"
