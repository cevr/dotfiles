#!/usr/bin/perl
# systemd-tmpfiles --clean, minus what a running process holds. The daily systemd-tmpfiles-clean.service
# runs this instead of tmpfiles itself (systemd/system/systemd-tmpfiles-clean.service.d).
#
# tmpfiles decides by age alone: an entry goes when its access, birth, change and modification times
# are all older than its line's age (tmpfiles.d(5), "Age"); our btrfs mounts with noatime, so reading
# a file does not keep it. It does not look at open files. What it does honour is a BSD lock: "If the
# aging algorithm finds a lock (shared or exclusive) is already taken on some directory/file, it (and
# everything below it) is skipped." For files, directories and mappings held by a process we lock
# the enclosing top-level run entry (under the nearest cleaned root), so even an aged sibling file
# the process will open again survives. Hold the locks until tmpfiles exits. A run needing protection
# before any process opens files (including during the scan) takes its own shared directory flock.
#
# Usage: workbox-tmp-clean [tmpfiles config...]   (as root; the configs go to systemd-tmpfiles)
# Env: WORKBOX_TMP_ROOTS overrides the cleanup roots (VM tests).
use strict;
use warnings;
use Fcntl qw(:flock :mode O_DIRECTORY O_RDONLY O_NOFOLLOW O_NONBLOCK);

my @roots = sort { length($b) <=> length($a) }
    split ' ', ($ENV{WORKBOX_TMP_ROOTS} // '/tmp /var/tmp /tmp/opencode /tmp/ergo /tmp/bite-work /tmp/personal');
my $run_entry = sub {
    my ($path) = @_;
    for my $root (@roots) {
        return $root if $path eq $root;
        if (my ($entry) = $path =~ m{^\Q$root\E/([^/]+)}) {
            return "$root/$entry";
        }
    }
    return;
};

my %held;
opendir(my $proc, '/proc') or die "workbox-tmp-clean: /proc: $!\n";
for my $pid (grep { /^\d+$/ } readdir $proc) {
    next if $pid == $$;
    my @paths;
    if (opendir(my $fds, "/proc/$pid/fd")) {
        push @paths, map { readlink "/proc/$pid/fd/$_" } grep { /^\d+$/ } readdir $fds;
        closedir $fds;
    }
    push @paths, readlink "/proc/$pid/cwd";
    if (open(my $maps, '<', "/proc/$pid/maps")) {
        while (my $line = <$maps>) {
            chomp $line;
            my (undef, undef, undef, undef, undef, $path) = split ' ', $line, 6;
            push @paths, $path if defined $path && substr($path, 0, 1) eq '/';
        }
        close $maps;
    }
    for my $path (@paths) {
        next unless defined $path;
        $path =~ s/ \(deleted\)$//;
        my $entry = $run_entry->($path);
        $held{$entry} = 1 if defined $entry;
    }
}
closedir $proc;

my @locks;
for my $path (sort keys %held) {
    # Respect only directories and regular files; no symlinks, FIFOs or devices.
    my @before = lstat($path);
    next unless @before && (S_ISDIR($before[2]) || S_ISREG($before[2]));
    my $flags = O_RDONLY | O_NOFOLLOW | O_NONBLOCK;
    $flags |= O_DIRECTORY if S_ISDIR($before[2]);
    sysopen(my $fh, $path, $flags) or next;
    my @opened = stat($fh);
    next unless @opened && $before[0] == $opened[0] && $before[1] == $opened[1];
    flock($fh, LOCK_SH | LOCK_NB) and push @locks, $fh;
}
printf "workbox-tmp-clean: %d held paths locked under %s\n", scalar @locks, join(' ', @roots);

my $tmpfiles = $ENV{WORKBOX_TMPFILES} // 'systemd-tmpfiles';
my $status = system($tmpfiles, '--clean', @ARGV);
exit($status == -1 ? 1 : $status & 127 ? 128 + ($status & 127) : $status >> 8);
