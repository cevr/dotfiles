export BUN_INSTALL="$HOME/.bun"
export TURBO_CACHE=local:rw
export TURBO_CACHE_DIR=/workspaces/.cache/turbo
export TURBO_CACHE_MAX_SIZE=2GB
export TURBO_CONCURRENCY=2
# orchestrate budget.ts: the Mac shares this Claude account pool.
export ORCHESTRATE_HOSTS=cvr@cristians-macbook-pro

if [[ -S "/run/user/$(id -u)/bus" ]]; then
  export XDG_RUNTIME_DIR="/run/user/$(id -u)"
  export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
fi

typeset -U path PATH
path=(
  "$HOME/Developer/personal/dotfiles/claude/bin"
  "$HOME/.local/bin"
  "$BUN_INSTALL/bin"
  $path
)
export PATH

# Machine-local secrets (GRAFANA_TOKEN, …): never committed; agents inherit them.
[ -f "$HOME/.config/secrets.env" ] && . "$HOME/.config/secrets.env"

# The workbox's Tailscale sshd runs with OOMScoreAdjust=-900 so it survives memory pressure, and every
# process started from an SSH login inherits it. Give the login back the default score, so under an OOM
# the kernel kills a runaway program instead of everything else.
[ "$(cat /proc/self/oom_score_adj 2>/dev/null)" -lt 0 ] 2>/dev/null && echo 0 > /proc/self/oom_score_adj 2>/dev/null
