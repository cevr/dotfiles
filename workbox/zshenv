export BUN_INSTALL="$HOME/.bun"
export TURBO_CACHE_DIR=/workspaces/.cache/turbo
# The lanes' shared store wrote about 0.7 to 1 GB a day and sat at its old 2 GB cap with nothing older than
# 2 days (2026-11-22). 20 GB keeps about three weeks, past a lane's life; /workspaces had 161 GB free.
export TURBO_CACHE_MAX_SIZE=20GB
export TURBO_CONCURRENCY=2
# orchestrate budget.ts: the Mac shares this Claude account pool.
export ORCHESTRATE_HOSTS=cvr@cristians-macbook-pro
# rex-show sim (opencode/mods/rex): iOS simulators run on the Mac, so the showcase mirrors its booted one over
# ssh (Remote Login is on there and accepts this host's key). The name is the Mac's Tailscale MagicDNS name.
export REX_SHOW_SIM_HOST=cvr@cristians-macbook-pro

if [[ -S "/run/user/$(id -u)/bus" ]]; then
  export XDG_RUNTIME_DIR="/run/user/$(id -u)"
  export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
fi

typeset -U path PATH
path=(
  "$HOME/Developer/personal/dotfiles/claude/bin"
  "$HOME/.local/bin"
  "$BUN_INSTALL/bin"
  $path
)
export PATH

# Machine-local secrets (GRAFANA_TOKEN, …): never committed; agents inherit them.
[ -f "$HOME/.config/secrets.env" ] && . "$HOME/.config/secrets.env"

# Remote turbo cache (owner, 2026-11-22): lanes also read and write the Bite repo's remote cache. Its turbo.jsonc
# names the server and team; the token is the `ENV TURBO_TOKEN` literal in the base checkout's Dockerfile, read
# here at every shell start with builtins only (no fork) and never committed.
# The token is for Bite's server alone, so only a shell that starts in the Bite tree gets it: the base checkout
# that holds the Dockerfile, or one of its workspaces in work's storage beside it (`<parent>/.work/<name>/…`,
# and Rift's older `<parent>/.rifts/<name>/…`, both derived from the one path below; symlinks resolved).
# There a token already in the environment wins. Anywhere else TURBO_TOKEN is unset, an inherited one too: a
# Bite shell's child that starts in another repository must not hand that repository's cache server the token.
# With no token the store stays local only, so turbo never warns per task. WORKBOX_TURBO_DOCKERFILE is the
# tests' seam. A second repository on another cache server would be a second (Dockerfile, tree) pair here, each
# tree exporting its own token (turbo reads one TURBO_TOKEN).
() {
  setopt localoptions extendedglob
  local file=${WORKBOX_TURBO_DOCKERFILE:-/workspaces/bite/Dockerfile} line value
  local base=${file:h:A} cwd=${PWD:A} root
  local inside=0
  for root in $base ${base:h}/.work/${base:t} ${base:h}/.rifts/${base:t}; do
    [[ $cwd == "$root" || $cwd == "$root"/* ]] && inside=1 && break
  done
  if (( ! inside )); then
    unset TURBO_TOKEN
    return
  fi
  if [[ -z $TURBO_TOKEN && -r $file ]]; then
    while IFS= read -r line || [[ -n $line ]]; do
      [[ $line == [[:space:]]#ENV[[:space:]]##TURBO_TOKEN([[:space:]]|=)* ]] || continue
      value=${${line#*TURBO_TOKEN}%%[[:space:]]#}
      if [[ $value == '='* ]]; then
        value=${value#=}
        [[ $value == [\"\']* ]] || value=${value%%[[:space:]]*}
      else
        value=${value##[[:space:]]#}
      fi
      [[ $value == \"*\" || $value == \'*\' ]] && value=${value[2,-2]}
      [[ -n $value ]] && export TURBO_TOKEN=$value
      break
    done 2>/dev/null <"$file"
  fi
}
if [[ -n $TURBO_TOKEN ]]; then
  export TURBO_CACHE=local:rw,remote:rw
else
  export TURBO_CACHE=local:rw
fi

# The workbox's Tailscale sshd runs with OOMScoreAdjust=-900 so it survives memory pressure, and every
# process started from an SSH login inherits it. Give the login back the default score, so under an OOM
# the kernel kills a runaway program instead of everything else.
[ "$(cat /proc/self/oom_score_adj 2>/dev/null)" -lt 0 ] 2>/dev/null && echo 0 > /proc/self/oom_score_adj 2>/dev/null
