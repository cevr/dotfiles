export BUN_INSTALL="$HOME/.bun"
export TURBO_CACHE=local:rw
export TURBO_CACHE_DIR=/workspaces/.cache/turbo
export TURBO_CONCURRENCY=2

if [[ -S "/run/user/$(id -u)/bus" ]]; then
  export XDG_RUNTIME_DIR="/run/user/$(id -u)"
  export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
fi

typeset -U path PATH
path=(
  "$HOME/Developer/personal/dotfiles/claude/bin"
  "$HOME/.local/bin"
  "$BUN_INSTALL/bin"
  $path
)
export PATH

# Machine-local secrets (GRAFANA_TOKEN, …): never committed; agents inherit them.
[ -f "$HOME/.config/secrets.env" ] && . "$HOME/.config/secrets.env"
